@model EditarUsuarioViewModel;
@{

    Layout = "~/Views/Shared/_LayoutProveedor.cshtml";
}
<h1>Usuario</h1>

<div class="row">
    <div class="col-md-4 label__bold">
        @Html.HiddenFor(m => m.IdPersona)
        <div class="row">
            <div class="col-md-12 mb-3">
                @Html.LabelFor(m => m.Usuario)
                <input type="text" class="form-control" id="formGroupExampleInput" placeholder="@Model.Usuario" disabled>
            </div>
            <div class="col-md-12 mb-3">
                @Html.LabelFor(m => m.Email)
                <input type="text" class="form-control" id="formGroupExampleInput" placeholder="@Model.Email" disabled>
            </div>
            <div class="col-md-12 mb-3">
                @Html.LabelFor(m => m.Estado)
                <input type="text" class="form-control" id="formGroupExampleInput" placeholder="@Model.Estado" disabled>
            </div>
        </div>
    </div>
    <div class="col-md-4 label__bold">
        <div class="row">
            <div class="col-md-12 mb-3">
                @Html.LabelFor(m => m.TipoUsuario)
                <input type="text" class="form-control" id="formGroupExampleInput" placeholder="@Model.Usuario" disabled>
            </div>
            <div class="col-md-12 mb-3">
                @Html.LabelFor(m => m.IdSucursal)
                @Html.DropDownListFor(model => model.IdSucursal, new SelectList(Model.Sucursales, "IdSucrsal", "Sucursal"), new { id = "cmb-sucursales", @class = "form-control text-left", name = "cmb-sucursales", disabled="disabled",  title="cmb"})
            </div>
            <div class="col-md-12 mb-3">
                @Html.LabelFor(m => m.Invitacion)
                <input type="text" class="form-control" id="formGroupExampleInput" placeholder="@Model.Invitacion" disabled>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="row d-flex">
            <div class="col-md-12 d-flex justify-content-center mb-3">
                <button id="btn-invitacion" type="button" class="btn btn-primary col-md-55"> Reenviar Invitación </button>                
            </div>
            <div class="col-md-12 d-flex justify-content-center mb-3">
                <button id="btn-password" type="button" class="btn btn-primary col-md-55"> Cambiar Password </button>
            </div>
            <div class="col-md-12 d-flex justify-content-center mb-3">
                <button id="btn-eliminar" type="button" class="btn btn-primary col-md-55"> Modificar </button>
            </div>
            <div class="col-md-12 d-flex justify-content-center mb-3">
                <button id="btn-eliminar" type="button" class="btn btn-danger col-md-55"> Eliminar </button>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-4">
        <a asp-controller="Administracion" asp-action="Usuarios" class="btn btn-secondary col-md-55"><i class="fa fa-arrow-left" aria-hidden="true"></i> Ir a Usuarios </a>
    </div>
</div>