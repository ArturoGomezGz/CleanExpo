@model EditarProveedorViewModel;
@{
    ViewData["Title"] = "EditProveedor";
    Layout = "~/Views/Shared/_LayoutProveedor.cshtml";
}

<div class="row mb-2">
    <div class="col-md-6 label__bold">
        <h3>Proveedor</h3>
        @Html.HiddenFor(m=>m.IdPersona)
        <div class="row">
            <div class="col-sm-12 col-md-6">                
                @Html.LabelFor(m => m.Proveedor)
                <input type="text" class="form-control" id="txt_box_Proveedor" placeholder="@Model.Proveedor" disabled>
            </div>
            
        </div>
        <div class="row">
            <div class="col-sm-12 col-md-6">
                @Html.LabelFor(m => m.Descripcion)
                @Html.TextAreaFor(m => m.Descripcion, new { @class = "form-control ", disabled="disabled" })
            </div>
            <div class="col-sm-12 col-md-6 p-4">
                <div id="hiddenBTN" class="d-none col-md-55 text-center">
                    <button type="button" class="btn btn-outline-success" onclick="save()" title="btn-save">
                        <i class="fa fa-check" aria-hidden="true"></i>
                    </button>
                    <button type="button" class="btn  btn-outline-danger" onclick="cancel()" title="btn-cancel">
                        <i class="fa fa-ban" aria-hidden="true"></i>
                    </button>
                </div>
            </div>
            
        </div>
        <div class="row">
            <div class="col-sm-12 col-md-6">
                @Html.LabelFor(m => m.Monedas)
                @Html.TextBoxFor(m => m.Monedas, new{ @type = "number", @min = "1", @class = "form-control ", disabled="disabled" })
            </div>
            <div class="col-sm-12 col-md-6 p-4">
                <div id="hiddenBTNMonedas" class="d-none col-md-55 text-center">
                    <button type="button" class="btn btn-outline-success" onclick="saveMonedas()" title="btn-save">
                        <i class="fa fa-check" aria-hidden="true"></i>
                    </button>
                    <button type="button" class="btn  btn-outline-danger" onclick="cancelMonedas()" title="btn-cancel">
                        <i class="fa fa-ban" aria-hidden="true"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <h3>Laboratorios</h3>
        <table id="Laboratorios" class="display " style="width:100%">
            <thead>
                <tr>
                    <th></th>
                    <th>Laboratorio</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
            <tfoot>
                <tr>
                    <th></th>
                    <th>Nombre</th>
                </tr>
            </tfoot>
        </table>
    </div>
</div>
<div class="row d-flex mt-4">
    <div class="col-3 col-md-2 justify-content-center d-flex mt-4">
        <button id="btn-modificar" type="button" class="btn btn-warning"> Editar </button>
    </div>
    <div class="col-3 col-md-2 justify-content-center d-flex mt-4">
        <button id="btn-eliminar" type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#eliminarModal"> Eliminar </button>
    </div>
    <div class="col-3 col-md-2 justify-content-center d-flex mt-4">
        <button id="btn-AddMonedas" type="button" class="btn btn-primary"> Asignar Monedas </button>
    </div>
    <div class="col-3 col-md-2 justify-content-center d-flex mt-4">
        <button id="btn-Agregar" type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#ListaLaboratoriosModal"> Agregar </button>
    </div>
    <div class="col col-md-4 justify-content-center d-flex mt-4">
        <a asp-controller="Administracion" asp-action="Proveedor" class="btn btn-secondary"><i class="fa fa-arrow-left" aria-hidden="true"></i> Ir a Proveedores </a>
    </div>
</div>

<script>
    function removeclass(){
        $("#btn-modificar").addClass('d-none');
        $("#hiddenBTN").removeClass("d-none")
    }
    function removeclassMonedas(){
        $("#btn-AddMonedas").addClass('d-none');
        $("#hiddenBTNMonedas").removeClass("d-none")
    }
    
    function cancel(){
        $("#hiddenBTN").addClass('d-none');
        $("#btn-modificar").removeClass("d-none")

        var element = document.getElementById("txt_box_Proveedor")
        element.setAttribute("disabled", "");
        var element1 = document.getElementById("Descripcion")
        element1.setAttribute("disabled", "");
    }
    function cancelMonedas(){
        $("#hiddenBTNMonedas").addClass('d-none');
        $("#btn-AddMonedas").removeClass("d-none")

        var element = document.getElementById("Monedas")
        element.setAttribute("disabled", "");
    }

    $(document).ready(function () {
        $("#btn-modificar").click(function(){            
            removeclass()

            var element = document.getElementById("txt_box_Proveedor")
            element.removeAttribute("disabled");
            var element1 = document.getElementById("Descripcion")
            element1.removeAttribute("disabled");
        })
        $("#btn-AddMonedas").click(function () {
            removeclassMonedas()

            var element = document.getElementById("Monedas")
            element.removeAttribute("disabled");
        })
        $('#Laboratorios').DataTable({
            "language": {
                "url": "//cdn.datatables.net/plug-ins/1.10.16/i18n/Spanish.json"
            },
            "ajax": {
                url: path + "Administracion/GetLaboratorios?IdPersona=" + $("#IdPersona").val(),
                type: 'POST',
                dataSrc: ""
            },
            responsive: true,
            "columns": [
                {
                    "data":"acceder",
                    render: function (data, type) {
                        if (type === 'display') {
                            return '<button type="button" class="btn  btn-outline-danger" onclick="cancel()" title="btn-cancel">'
                                    +' <i class="fa fa-ban" aria-hidden="true"></i>'
                                    +' </button>';
                        }
                        return data;
                    },
                },
            { "data": "laboratorio" }
            ]
        });
        $('#AddLaboratorios').DataTable({
            pageLength: 5,
            "language": {
                "url": "//cdn.datatables.net/plug-ins/1.10.16/i18n/Spanish.json"
            },
            "ajax": {
                url: path + "Administracion/GetAddLabs",
                type: 'POST',
                dataSrc: ""
            },
            responsive: true,
            "columns": [
                {
                    "data":"acceder",
                    render: function (data, type) {
                        if (type === 'display') {
                            return '<button type="button" class="btn  btn-outline-success" onclick="cancel()" title="btn-cancel">'
                                + ' <i class="fa fa-plus" aria-hidden="true"></i>'
                                    +' </button>';
                        }
                        return data;
                    },
                },
            { "data": "laboratorio" }
            ]
        });
    });
</script>

<!-- Modal -->
<div class="modal fade" id="eliminarModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <h3>Vas a eliminar al Proveedor:</h3>
                <label>@Model.Proveedor</label>
                <h3>¿Estas seguro?</h3>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" data-bs-dismiss="modal"> Cancelar </button>
                <button type="button" class="btn btn-success"> Aceptar </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="ListaLaboratoriosModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="ModalLaboratorio">Asigna Laboratorios</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row label__bold">
                    <div class="col-12">
                        <div class="mb-3">
                            @Html.LabelFor(m => m.Proveedor)
                            <input type="text" class="form-control" id="txt_box_Proveedor_modal" placeholder="@Model.Proveedor" disabled>
                        </div>
                        <div class="mb-3">
                            <label for="LaboratoriosAsignados" class="form-label">Email address</label>
                            <input type="text" class="form-control" id="LaboratoriosAsignados" value="1" disabled>
                        </div>
                        <div class="mb-3">
                            <table id="AddLaboratorios" class="display " style="width:100%">
                                <thead>
                                    <tr>
                                        <th></th>
                                        <th>Laboratorio</th>
                                    </tr>
                                </thead>
                                <tbody>
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <th></th>
                                        <th>Nombre</th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
               
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" data-bs-dismiss="modal"> Cancelar </button>
                <button type="button" class="btn btn-success"> Aceptar </button>
            </div>
        </div>
    </div>
</div>