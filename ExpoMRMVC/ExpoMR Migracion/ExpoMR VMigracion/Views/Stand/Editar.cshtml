<style>
    .x_content_card {
        /*border: 2px solid black;*/
        padding: 3px;
        width: 60%;
        margin: auto auto auto;
        margin-top: 10%;
        margin-bottom: 10%;
    }

    img {
        opacity: 1;
        transition: opacity 1s;
    }

        img[data-src] {
            opacity: 0;
        }

    .carrousel {
        transition: all 0.4s ease;
        border-radius: 1em;
        overflow: hidden;
    }

        .carrousel .grande {
            display: flex;
            flex-flow: row nowrap;
            justify-content: space-between;
            align-items: center;
            transition: all 0.4s ease;
            border-radius: 1em;
            transition: all 0.5s ease;
            transform: translateX(0%);
        }

        .carrousel .img {
            min-height: 10vh;
            color: var(--blanco);
            transition: all 0.4s ease;
            border-radius: 1em;
            padding: 1em;
            margin: 0.5em;
            font-size: 1.3em;
            min-height: 80px;
        }

        .carrousel .puntos {
            width: 100%;
            display: flex;
            flex-flow: row nowrap;
            justify-content: center;
            align-items: center;
            list-style-type: none;
        }

        .carrousel .punto {
            width: 1em !important;
            height: 1em;
            margin: 1em 1em 0;
            color: var(--negro);
            border-radius: 1em;
            list-style-type: none;
        }

            .carrousel .punto.activo {
                background-color: lightblue !important;
            }

