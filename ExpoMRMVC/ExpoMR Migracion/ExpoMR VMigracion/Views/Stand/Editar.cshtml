<script>
    $(document).ready(function () {
        $.ajax({
            type: "POST",
            url: path + "Stand/GetAnuncios?idProveedor=" + @Model.Proveedor,
            success: function (resultado) {
                var divAnuncios = document.getElementById('divAnuncios');
                var puntosLista = document.getElementById('puntosLista');
                resultado.forEach(function (anuncio) {
                    // Crear un nuevo párrafo
                    var nuevoParrafo = document.createElement("p");
                    nuevoParrafo.classList.add("img");
                    nuevoParrafo.classList.add("Accordioncolor");

                    // Crear el contenido del párrafo
                    var contenido = document.createTextNode(anuncio);

                    // Agregar el contenido al párrafo
                    nuevoParrafo.appendChild(contenido);

                    // Agregar el párrafo al div
                    divAnuncios.appendChild(nuevoParrafo);

                    var nuevoElemento = document.createElement("li");
                    nuevoElemento.classList.add("punto");
                    puntosLista.appendChild(nuevoElemento);
                });

                configuraAnuncios();

                setPaletaColors(@Model.color);
            },
            error: function (xhr, status, error) {
                console.log(error);
            }
        });
    });

    function ser() {
        var elements = document.querySelectorAll('img[data-id]');
        var index = 0;
    }

    function searchStand() {
        let IdProveedor = $("#Proveedor").val();
        let Busqueda = $("#txtBuscar").val();
        let idUsuario = $("#idUsuario").val();
        let lista = "";
        $("#busqueda__Result").html("")

        if (Busqueda != "") {
            $.post(path + "Stand/GetProductosBusqueda",
                {
                    IdProveedor: IdProveedor,
                    Busqueda: Busqueda,
                    idUsuario: idUsuario
                },
                function (data) {
                    if (data.response) {
                        if (data.result.length > 0) {
                            $.each(data.result, function (index, value) {

                                lista += '<div class="tab-content_productos mb-4">'
                                    + '    <div class="lista__busqueda_stand">'
                                    + '        <div class="listaStand_article">'
                                    + '            <a href="' + path + 'Producto/Index?idProducto=' + value.idProducto + '" style=" margin: auto;">'
                                    + '                <img class="card-img-top" src="' + path + 'Imagenes/noimage.png" alt="image">'
                                    + '             </a>'
                                    + '        </div>'
                                    + '       <div class="listaStand_descripcion standProducto">'
                                    + '           <a href="' + path + 'Producto/Index?idProducto=' + value.idProducto + '">'
                                    + '            ' + value.nombre
                                    + '            </a>'
                                    + '            <p>' + value.presentacion + '</p>'
                                    + '            <p><strong>Fórmula:</strong></p>'
                                    + '            <label>' + value.formula + '</label>'
                                    + '      </div>'
                                    + '     <div class="listaStand_actions">'
                                    + '           <p><strong>Descuento: </strong><label class="label_Descuento_stnd"> ' + FormatoMoneda(value.descuento) + '</label></p>'
                                    + '           <p>Precio Final: <label class="label_PrecioFinal_stnd"> ' + FormatoMoneda(value.precioFinal) + '</label></p>'
                                    + '     </div>'
                                    + '    </div>'
                                    + '     <hr />'
                                    + '   </div>';
                            });
                            $("#busqueda__Result").append(lista)
                        } else {
                            ShowAlert("No hay coincidencias para el filtro aplicado", false)
                        }
                    } else {
                        ShowAlert(data.message, data.response)
                    }
                }).error(function () {
                    ShowAlert("No fue posible cargar sus datos", false)
                });
        }
    }
</script>

<script type="text/javascript">
    function configuraAnuncios() {
        const grande = document.querySelector('.grande');
        const punto = document.querySelectorAll('.punto');
        const anuncio = document.querySelectorAll('.img');

        var puntos = document.querySelectorAll('.punto').length;
        var tamanio = 100 * puntos;

        grande.style.width = tamanio + '%';

        anuncio.forEach((cadaAnuncio, i) => {

            anuncio[i].style.width = (100 / puntos) + '%';
        })

        // Cuando CLICK en punto
        // Saber la posición de ese punto
        // Aplicar un transform translateX al grande
        // QUITAR la clase activo de TODOS puntos
        // AÑADIR la clase activo al punto que hemos hecho CLICK
        var posicion = 0;
        var operacion = 0;

        // Recorrer TODOS los punto
        punto.forEach((cadaPunto, i) =>

            // Asignamos un CLICK a cadaPunto
            punto[i].addEventListener('click', () => {
                // Guardar la posición de ese PUNTO
                posicion = i

                // Calculando el espacio que debe DESPLAZARSE el GRANDE
                operacion = posicion * -(100 / puntos)
                // MOVEMOS el grand
                grande.style.transform = `translateX(${operacion}%)`

                // Recorremos TODOS los punto
                punto.forEach((cadaPunto, i) => {
                    // Quitamos la clase ACTIVO a TODOS los punto
                    punto[i].classList.remove('activo')
                })
                // Añadir la clase activo en el punto que hemos hecho CLICK
                punto[i].classList.add('activo')

            })
        )
    }
    var posicion = 0;

    function update() {
        const punto = document.querySelectorAll('.punto');
        var puntos = document.querySelectorAll('.punto').length;
        const grande = document.querySelector('.grande');

        if (punto.length > 0) {
            // Quitamos la clase ACTIVO del punto actual
            punto[posicion].classList.remove('activo')
        }

        //asignamos la posicion
        if (posicion >= puntos - 1) {
            posicion = 0;
        } else {
            posicion++;
        }

        // Calculando el espacio que debe DESPLAZARSE el GRANDE
        operacion = posicion * -(100 / puntos)

        // MOVEMOS el grande
        grande.style.transform = `translateX(${operacion}%)`

        if (punto.length > 0) {
            // Añadir la clase activo en el punto que hemos hecho CLICK
            punto[posicion].classList.add('activo')
        }

    }

    //Se mueve la posicion del carrucel cada 5 segundos
    setInterval(update, 8000);

    function setPaletaColors(paleta) {

        let elements = document.getElementsByClassName("Accordioncolor");
        let puntos = document.getElementsByClassName("punto");

        //anuncios
        for (let i = 0; i < elements.length; i++) {
            switch (i) {
                case 0:
                case 4:
                    elements[i].classList.add("standAnuncioPaleta" + paleta + "Color1");
                    break;
                case 1:
                case 5:
                    elements[i].classList.add("standAnuncioPaleta" + paleta + "Color2");
                    break;
                case 2:
                case 6:
                    elements[i].classList.add("standAnuncioPaleta" + paleta + "Color3");
                    break;
                case 3:
                case 7:
                    elements[i].classList.add("standAnuncioPaleta" + paleta + "Color4");
                    break;
                default:
                    elements[i].style.backgroundColor = "gray";
                    break;
            }
        }

        //puntos
        for (let i = 0; i < puntos.length; i++) {
            puntos[i].classList.add("standAnuncioPaleta" + paleta + "Color1");
        }
    }
</script>
