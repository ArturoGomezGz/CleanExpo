@model ProductoExpoViewModel
@{
    ViewData["Title"] = "Producto";
}

<div id="liveAlertPlaceholder"></div>

<div class="col-md-12">
    <div class="col-md-12">
        <div class="card">
            <div class="card-body">
                <div class="row">
                   <div class="col-md-3">
                        <img class="card-img-top" src="@String.Format("data:image/jpg;base64,{0}", Convert.ToBase64String(Model.imgProductos))" alt="image">
                   </div>
                   <div class="col-md-6 text-justify">
                       <div class="row">
                            <h5 class="card-title "><i class="fa fa-plus-square"></i> @Model.Nombre</h5>
                            <label class="label__Presentacion">@Model.Presentacion</label>
                       </div>
                       <div class="row">
                           <strong>No. Producto: </strong> <label class="label__producto">@Model.IdProducto</label>
                           @Html.HiddenFor(m=>m.IdProducto)
                       </div>
                       <div class="row">
                           <strong>Restringido a </strong> <label class="label__producto">@Model.Cantidad</label>
                       </div>
                       <div class="row">
                           <div class="col-6">
                                <strong>Precio Publico: </strong> <label class="label__publico"> @Model.Publico</label>
                                @Html.HiddenFor( m=> m.Publico)
                            </div>
                           <div class="col-6">
                                <strong>Precio MR: </strong><label class="label__PrecioMR">@Model.PrecioMR</label> 
                                @Html.HiddenFor( m=> m.PrecioMR)
                           </div>
                       </div>
                       <div class="row">
                           <div class="col-6">
                                <strong>Precio Neto: </strong><label class="label__Neto"> @Model.Neto</label>
                                @Html.HiddenFor( m=> m.Neto)
                           </div>
                           <div class="col-6">
                                <strong>Descuento Expo: </strong><label class="label__DescuentoExpo"> @Model.DescuentoExpo</label>
                                @Html.HiddenFor( m=> m.DescuentoExpo)
                           </div>
                       </div>
                       <div class="row mb-4">
                            <h6>@{
                                    if (Model.Iva) {
                                        <span style="color:green">Con Iva</span>
                                    } else {
                                        <span style="color:red">Sin Iva</span>
                                    }
                                }</h6>

                             @Html.HiddenFor(m => m.ValorIva)
                        </div>
                       <div class="row">
                            <strong>Formula: </strong> <label class="label__Formula"> @Model.Formula</label>
                       </div>
                       <div class="row">
                            <strong>Laboratorio: </strong> <label class="label__Laboratorio"> @Model.Laboratorio</label>
                       </div>
                       <div class="row">
                            <strong>Caja Colectiva: </strong> <label class="label__Caja"> @Model.Caja</label>
                       </div>
                       <div class="row">
                            <strong>Código: </strong> <label class="label__Caja"> @Model.Codigo</label>
                       </div>

                   </div>
                   <div class="col-md-3">
                        <div class="contenedor__Producto">
                            <div class="mb-4 ">
                                <bold>Precio Final: </bold> <label class="contenedor__Producto__PrecioFinal"> @Model.PrecioFinal</label>
                                @Html.HiddenFor(m => m.PrecioFinal)
                            </div>
                            <div class="mb-4 d-grid">
                                <bold>Cantidad:</bold> <input id="txtCantidad" onkeyup="actualizaTotal(this)"  type="number" min="0" value="0" placeholder="0" />
                            </div>
                            <div class="mb-4">
                                <bold>Subtotal: </bold><label class="contenedor__Producto__subtotal"></label>
                            </div>
                            <div class="mb-4">
                                <bold>Iva: </bold><label class="contenedor__Producto__iva"></label>
                            </div>
                            <hr class="new1" />
                            <div class="mb-4">
                                <bold>Total: </bold><label class="contenedor__Producto__Total"></label>
                            </div>
                            <button id="liveAlertBtn" onclick="AgregarProducto()" type="button" class="contenedor_btn btn btn-warning mb-3">Añadir a Carrito</button>
                        </div>
                   </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function AgregarProducto() {
        let IdProducto = $("#IdProducto").val()
        let Cantidad = $("#txtCantidad").val()
        let PrecioMR = $("#PrecioMR").val()

        if(Cantidad > 0){
            $.post(path + "Producto/AddCarrito",
                {
                    idProducto: IdProducto,
                    cantidad: Cantidad,
                    unitario: PrecioMR
                },
            function (data) {
                ShowAlert(data.message, data.response)
                GetCarrito();
                GetMonedas()
            }).error(function () {
                ShowAlert("No fue posible cargar sus datos", false);
            });
        }else{
            ShowAlert("La Cantidad debe ser mayor a Cero", false);
        }
    }
    function actualizaTotal(element){
        let valorIva = parseFloat($("#ValorIva").val());
        let Precio = $("#PrecioFinal").val();
        let PrecioFianl = $("#PrecioFinal").val();
        let publico = $("#Publico").val();
        let PrecioMR = $("#PrecioMR").val();
        let Neto = $("#Neto").val();
        let DescuentoExpo = $("#DescuentoExpo").val();

        let subtotal = element.value * Precio;
        let PrecioIva = element.value * Precio * valorIva;
        let Total = element.value * Precio * (1 + valorIva)
        $(".contenedor__Producto__subtotal").html(FormatoMoneda(subtotal))
        $(".contenedor__Producto__iva").html(FormatoMoneda(PrecioIva))
        $(".contenedor__Producto__Total").html(FormatoMoneda(Total))
    }
    $(document).ready(function(){

        let valorIva = parseFloat($("#ValorIva").val());
        let Precio = $("#PrecioFinal").val();
        let PrecioFianl = $("#PrecioFinal").val();
        let publico = $("#Publico").val();
        let PrecioMR = $("#PrecioMR").val();
        let Neto = $("#Neto").val();
        let DescuentoExpo = $("#DescuentoExpo").val();

        $(".contenedor__Producto__subtotal").html(FormatoMoneda(0.0))
        $(".contenedor__Producto__iva").html(FormatoMoneda(0.0))
        $(".contenedor__Producto__Total").html(FormatoMoneda(0.0))
        $(".contenedor__Producto__PrecioFinal").html(FormatoMoneda(PrecioFianl))
        $(".label__publico").html(FormatoMoneda(publico))
        $(".label__PrecioMR").html(FormatoMoneda(PrecioMR))
        $(".label__Neto").html(FormatoMoneda(Neto))
        $(".label__DescuentoExpo").html(FormatoMoneda(DescuentoExpo))        

        $("#txtCantidad").change(function(){
            let subtotal = this.value * Precio;
            let PrecioIva = this.value * Precio * valorIva;
            let Total = this.value * Precio * (1 + valorIva)
            $(".contenedor__Producto__subtotal").html(FormatoMoneda(subtotal))
            $(".contenedor__Producto__iva").html(FormatoMoneda(PrecioIva))
            $(".contenedor__Producto__Total").html(FormatoMoneda(Total))
        })        
    });

</script>