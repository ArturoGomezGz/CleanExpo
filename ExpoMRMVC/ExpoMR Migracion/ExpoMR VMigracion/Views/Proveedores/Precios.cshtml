@model int
@{
    ViewData["Title"] = "Editar Empleado";
}

<div class="col-md-12">
    <div class="col-lg-12 col-md-12 col-sm-12 text-center">
        <select id="ddlLisClientes"></select>
    </div>
    <table class="table" id="PrecioClientes" style="width:100%">
        <thead>
            <tr>
                <th>Código</th>
                <th>Producto </th>
                <th>Costo</th>
                <th>Comprado</th>
                <th>Descuento Expo</th>
                <th>Precio Final</th>
                <th>En Carrito</th>
                <th>Confirmado</th>
                <th>Descuento Cliente</th>
                <th>Precio Cliente</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        </tbody>
    </table>
</div>

@*Modal Terminos y condiciones*@

<div class="modal fade" id="exampleModalToggle" aria-hidden="true" aria-labelledby="exampleModalToggleLabel" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalToggleLabel">
                    <label id="lblMensaje">El descuento otorgado al cliente es mayor al costo.</label>
                </h5>
            </div>
            <div class="modal-body">
                <input type="checkbox" id="miCheckbox">
                <label for="vehicle1"> Acepto</label><label><a href="#" data-bs-target="#exampleModalToggle2" data-bs-toggle="modal" data-bs-dismiss="modal"> los Términos y Condiciones</a></label>
            </div>
            <div class="col-md-12">
                <div class="row text-center">
                    <div class="col-md-6">
                        <button type="button" class="btn btn-verde-medio">Acepto</button>
                    </div>
                    <div class="col-md-6">
                        <button type="button" class="btn btn-rojo" data-bs-dismiss="modal" aria-label="Close">Cancelar</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="exampleModalToggle2" aria-hidden="true" aria-labelledby="exampleModalToggleLabel2" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-body">
                <h1>Términos y Condiciones</h1>
                <br />
                <h2>Obligaciones del Promotor</h2>

                <p>
                    - <b>“LA EMPRESA”</b> establece un precio para cada producto, sin embrago, el proveedor podrá negociar uno diferente al pactado en la página oficial, con la intención de mejorar el publicado, el cual <b>“MEDICINAS ROSARIO”</b>, no se hace responsable del precio pactado entre el proveedor y el cliente.<br />

                    - <b>“LA EMPRESARIA”</b> permite que se realice ese tipo de negociación en el sitio lugar del presente instrumento, durante el evento, quedando evidenciado el precio pactado entre las partes mismo que será almacenado en la misma contratación.<br />

                    - <b>“EL PROVEEDOR”</b>  una vez que otorgue el precio al cliente, no podrá cambiarlo, salvo para en beneficio de este, es decir, podrá mejorar el con anterioridad pactado. </br>

                    - El proveedor queda obligado del pago a <b>“LA EMPRESARIA”</b>  por el medio que se establezca o los ya reconocidos por los contratantes,  la diferencia entre el precio que estableció <b>“MEDICINAS ROSARIO”</b> y el precio que otorgó al cliente, mismo que queda debidamente firme y almacenado en la página, lugar de este contrato.<br />

                </p>

            </div>
            <div class="modal-footer">
                <button class="btn btn-primary" data-bs-target="#exampleModalToggle" data-bs-toggle="modal" data-bs-dismiss="modal">Regresar</button>
            </div>
        </div>
    </div>
</div>

<script>
    function PreciosDt() {
        let cliente = $('#ddlLisClientes').val()
        $('#PrecioClientes').DataTable({
            "language": {
                "url": "//cdn.datatables.net/plug-ins/1.10.16/i18n/Spanish.json"
            },
            "ajax": {
                url: path + "Proveedores/getPreciosCliente?cliente=" + $('#ddlLisClientes').val(),
                type: 'POST',
                dataSrc: ""
            },
            "columns": [
                { "data": "codigo" },
                { "data": "producto" },
                {
                    "data": "costo",
                    render: function (data, type) {
                        if (type === 'display') {
                            return '<input class="hdcosto" type="hidden" value="' + data + '"/>';
                        }
                        return data;
                    }
                },
                {
                    "data": "comprado",
                    render: function (data, type) {
                        if (data) {
                            return '<i class="fa fa-check-square-o" aria-hidden="true"></i>';
                        }
                        return '<i class="fa fa-square-o" aria-hidden="true"></i>';
                    }
                },
                { "data": "descuentoexpo" },
                { "data": "preciofinal" },
                { "data": "carrito" },
                { "data": "pedido" },
                {
                    "data": "descuentocliente",
                    render: function (data, type) {
                        if (type === 'display') {
                            return '<input class="text" type="text" value="' + data + '" disabled style="width:70px; heigth:70px"/>';
                        }
                        return data;
                    },
                },
                { "data": "preciocliente" },
                {
                    "data": "idproducto",
                    render: function (data, type, row) {
                        if (row.descuentocliente == 0) {
                            return '<input class="hdn" type="hidden" value="' + data + '" style="display:none"/><a class="btn btn-naranja-ch Edit" ><i class="fa-regular fa-pen-to-square"></i></a><a class="btn btn-outline-success Update" style="display:none"><i class="fa fa-check" aria-hidden="true"></i></a><a class="btn  btn-outline-danger Cancel" style="display:none"><i class="fa fa-ban" aria-hidden="true"></i></a>';
                        }
                        return ''
                    }

                },

            ]
        })
    }
    let DescCliente, DescExpo
    $(document).ready(function () {

        $.ajax({
            url: path + "Proveedores/ddlLisCliente",
            contentType: "application/json; charset=utf-8",
            type: 'POST',
            dataType: 'json',
            success: function (data) {
                // Cargar los datos en el select
                var select = $('#ddlLisClientes');
                select.empty();
                $.each(data, function (index, item) {
                    select.append($('<option></option>').val(item.cliente).text(item.nombre));
                });
                if (@Model > 0)
                    $('#ddlLisClientes').val(@Model);
                PreciosDt()
            }
        });

        $('#ddlLisClientes').change(function () {
            $('#PrecioClientes').dataTable().fnDestroy();
            var ddlLisClientes = $('#ddlLisClientes').val();
            PreciosDt()
        });

        //editar
        $('#PrecioClientes').on('click', '.Edit', function () {

            var row = $(this).closest("tr");
            DescCliente = row.find('.text').val();
            DescExpo = row[0].querySelector('td:nth-child(5)').textContent;
            $("td", row).each(function () {
                if ($(this).find(".text").length > 0) {
                    $(this).find(".text").show();
                }
            });
            row.find(".Update").show();
            row.find(".Cancel").show();
            var inputElement = row.find('.text');
            inputElement.prop('disabled', false);
            $(this).hide();
        });

        //Cancel event handler.
        $('#PrecioClientes').on('click', '.Cancel', function () {
            var row = $(this).closest("tr");
            var DesClienteNew;
            $("td", row).each(function () {
                if ($(this).find(".text").length > 0) {
                    DesClienteNew = row.find('.text').val(0)

                }
            });
            row.find(".Edit").show();
            row.find(".Update").hide();
            row.find(".Cancel").hide();
            var inputElement = row.find('.text');
            inputElement.prop('disabled', true);
        });

        //Update event handler.
        $('#PrecioClientes').on('click', '.Update', function () {

            var ddlLisClientes = $('#ddlLisClientes').val();
            var row = $(this).closest("tr");
            var inputhidden, DescClienteNew, costo;

            $("td", row).each(function () {
                if ($(this).find(".text").length > 0) {
                    DescClienteNew = row.find('.text').val();
                    inputhidden = row.find('.hdn').val();
                    costo = row.find('.hdcosto').val()
                }
            });
            row.find(".Edit").show();
            row.find(".Cancel").hide();
            var inputElement = row.find('.text');
            $(this).hide();

            $.post(path + "Proveedores/ValidaDescuento",
                {
                    descexpo: DescExpo,
                    desclinete: DescCliente,
                    descclientenew: DescClienteNew
                },
                function (data) {
                    if (data == false) {
                        alert("El descuento del cliente ingresado no puede ser menor al actual.", false);
                        DescClienteNew = row.find('.text').val(0);
                        inputElement.prop('disabled', true);
                    }
                    else {
                        $.post(path + "Proveedores/ValidaDescuentovsCosto",
                            {
                                costo: costo,
                                descclientenew: DescClienteNew
                            },
                            function (data) {
                                if (data == true) {

                                }
                                const myModal = new bootstrap.Modal(document.getElementById('exampleModalToggle'));
                                myModal.show();
                                $('#exampleModalToggle').on('click', '.btn-success', function () {
                                    const miCheckbox = document.getElementById("miCheckbox");
                                    if (miCheckbox.checked) {
                                        $.post(path + "Proveedores/productoAgregarDescuento",
                                            {
                                                idcliente: ddlLisClientes,
                                                idproducto: inputhidden,
                                                descclientenew: DescClienteNew
                                            },
                                            function (data) {
                                                myModal.hide();
                                                inputElement.prop('disabled', true);
                                                row.find(".Edit").hide();
                                            }).error(function () {
                                                alert("No fue posible cargar sus datos", false);
                                            });
                                    }
                                    else {
                                        myModal.hide();
                                        row.find(".Edit").hide();
                                        row.find(".Update").show();
                                        row.find(".Cancel").show();
                                    }

                                });
                                $('#exampleModalToggle').on('click', '.btn-danger', function () {
                                    row.find(".Edit").hide();
                                    row.find(".Cancel").show();
                                    row.find(".Update").show();
                                });

                            }).error(function () {
                                alert("No fue posible cargar sus datos", false);
                            });
                    }

                }).error(function () {
                    alert("No fue posible cargar sus datos", false);
                });
        });

    });
</script>