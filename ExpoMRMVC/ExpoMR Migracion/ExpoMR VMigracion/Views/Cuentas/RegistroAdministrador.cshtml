@model RegistroViewModel

@{
    ViewData["Title"] = "Registro de ususarios";
    Layout = "~/Views/Shared/_LayoutNoRegistrado.cshtml";
}

<div class="card">
    <div class="card-body">
        <h3 class="card-title text-center">Registro de Usuarios</h3>
        <form asp-controller="Cuentas" asp-action="Registroadministrador" method="post" role="form">
            <div class="text-danger" asp-validation-summary="All"></div>

            <div class="row mt-4">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="Nombre" class="col-md-2"></label>
                        <input asp-for="Nombre" class="form-control" placeholder="Ingresa Nombre"/>
                        <span asp-validation-for="Nombre" class="text-danger"></span>
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="Email" class="col-md-2"></label>
                        <input asp-for="Email" class="form-control"  placeholder="Ingresa email"/>
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>                    
                    
                    <div class="mb-3">
                        <label asp-for="Telefono" class="col-md-2"></label>
                        <input asp-for="Telefono" class="form-control"  placeholder="Ingresa Teléfono"/>
                        <span asp-validation-for="Telefono" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-6">

                    <div class="mb-3">
                        <label asp-for="Ciudad" class="col-md-2"></label>
                        <input asp-for="Ciudad" class="form-control" placeholder="Ingresa Ciudad"/>
                        <span asp-validation-for="Ciudad" class="text-danger"></span>
                    </div>                    
                    
                    <div class="mb-3">
                        <label asp-for="Password" class="col-md-2"></label>
                        <input asp-for="Password" class="form-control" placeholder="Ingresar la Contraseña"/>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="col-md-4"></label>
                        <input asp-for="ConfirmPassword" class="form-control"  placeholder="Confirmar la Contraseña"/>
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>
                    <!--Selección de Rol-->
                    <div class="mb-3">
                        <label asp-for="RolSeleccionado" class="col-md-4"></label>
                        <select asp-for="RolSeleccionado" asp-items="@Model.ListaRoles" class="form-control">
                            <option disabled selected>--Seleccionar Rol--</option>
                        </select>
                    </div>
                </div>

                <div class="row">
                    <div class="col-sm-10">
                        <button type="submit" class="btn btn-success w-75">Registrarse</button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}