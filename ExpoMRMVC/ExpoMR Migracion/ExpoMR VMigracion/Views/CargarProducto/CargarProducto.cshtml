
@{
    ViewData["Title"] = "Cargar Producto";
}

<div class="row">
    <h6>Cargar Archivo de Productos a tu Carro de Compras</h6>
    <ol>
        <li>-En un archivo CSV especifique en la primera columna el número del producto y en la segunda la cantidad solicitada</li>
        <li>-No especifique más columnas de las mencionadas</li>
        <li>-El archivo no deberá exceder los 500 registros</li>
        <li>-Valide que no es un robot y seleccione el archivo antes de subirlo</li>
        <li>-<a class="btn btn-link" asp-controller="CargarProducto" asp-action="CargarProducto"> Video de Ayuda </a></li>
    </ol>
</div>
<div class="row">
    <div class="col-sm-12 col-md-6 pb-4">        
        <GoogleRecaptcha:RecaptchaV2Control ID="gRecaptcha" SiteKey="6LdJMSEUAAAAAA64LidQn_V7QhRjA0tkjUsApIm4" SecretKey="6LdJMSEUAAAAADbALp3hhQ6NCkxTUA1Pc2CKHSEl" runat="server" />
    </div>
    <div class="col-sm-12 col-md-6">
        <div class="mb-3">
            <input class="form-check-input" type="checkbox" value="" id="flexCheckDefault">
            <label class="form-check-label" for="flexCheckDefault">
                Vaciar Mi Carrito
            </label>
        </div>        

        <div class="mb-3 pb-4">
            <input class="form-control" placeholder="Ningun Archivo Seleccionado" type="file" id="formFile">
        </div>
        
        <div class="mb-3 justify-content-center d-flex">
            <button type="submit" class="btn btn-primary mb-3">Cargar Archivo <i class="fa fa-upload" aria-hidden="true"></i></button>
        </div>
        
    </div>
</div>

