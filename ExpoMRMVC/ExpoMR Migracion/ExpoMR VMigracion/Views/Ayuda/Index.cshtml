                <button class="btn btn-azul-medio" type="button" onclick="search()">Buscar <i class="fa fa-search"></i></button>
            </div>
        </div>
    </div>
    <div class="col-md-10" style="margin-left: auto; margin-right: auto; padding-top: 15px; padding-bottom: 15px;">
        <div class="col text-center">
            <button class="btn btn-index mb-1" type="button" onclick="buscarPorLetra('a')"> A </button>
            <button class="btn btn-index mb-1" type="button" onclick="buscarPorLetra('b')"> B </button>
            <button class="btn btn-index mb-1" type="button" onclick="buscarPorLetra('c')"> C </button>
            <button class="btn btn-index mb-1" type="button" onclick="buscarPorLetra('d')"> D </button>
            <button class="btn btn-index mb-1" type="button" onclick="buscarPorLetra('e')"> E </button>
            <button class="btn btn-index mb-1" type="button" onclick="buscarPorLetra('f')"> F </button>
            <button class="btn btn-index mb-1" type="button" onclick="buscarPorLetra('g')"> G </button>
            <button class="btn btn-index mb-1" type="button" onclick="buscarPorLetra('h')"> H </button>
            <button class="btn btn-index mb-1" type="button" onclick="buscarPorLetra('i')"> I </button>
            <button class="btn btn-index mb-1" type="button" onclick="buscarPorLetra('j')"> J </button>
            <button class="btn btn-index mb-1" type="button" onclick="buscarPorLetra('k')"> K </button>
            <button class="btn btn-index mb-1" type="button" onclick="buscarPorLetra('l')"> L </button>
            <button class="btn btn-index mb-1" type="button" onclick="buscarPorLetra('m')"> M </button>
            <button class="btn btn-index mb-1" type="button" onclick="buscarPorLetra('n')"> N </button>
            <button class="btn btn-index mb-1" type="button" onclick="buscarPorLetra('ñ')"> Ñ </button>
            <button class="btn btn-index mb-1" type="button" onclick="buscarPorLetra('o')"> O </button>
            <button class="btn btn-index mb-1" type="button" onclick="buscarPorLetra('p')"> P </button>
            <button class="btn btn-index mb-1" type="button" onclick="buscarPorLetra('q')"> Q </button>
            <button class="btn btn-index mb-1" type="button" onclick="buscarPorLetra('r')"> R </button>
            <button class="btn btn-index mb-1" type="button" onclick="buscarPorLetra('s')"> S </button>
            <button class="btn btn-index mb-1" type="button" onclick="buscarPorLetra('t')"> T </button>
            <button class="btn btn-index mb-1" type="button" onclick="buscarPorLetra('u')"> U </button>
            <button class="btn btn-index mb-1" type="button" onclick="buscarPorLetra('v')"> V </button>
            <button class="btn btn-index mb-1" type="button" onclick="buscarPorLetra('w')"> W </button>
            <button class="btn btn-index mb-1" type="button" onclick="buscarPorLetra('x')"> X </button>
            <button class="btn btn-index mb-1" type="button" onclick="buscarPorLetra('y')"> Y </button>
            <button class="btn btn-index mb-1" type="button" onclick=" buscarPorLetra('z')"> Z </button>
        </div>
    </div>
    <div class="col-md-10" style="margin-left: auto; margin-right: auto;">
        <div class="row">
            <div id="lista" class="col-md-8" style="margin-left: auto; margin-right: auto;">

            </div>
        </div>        
    </div>
    <div class="col-md-10" style="margin-left: auto; margin-right: auto;">
        <hr />
    </div>
    <div class="col-md-10" style="margin-left: auto; margin-right: auto;">
        <h3 style="text-align:center;">Laboratorios</h3>
    </div>
    <div id="divLaboratorio" class="col-md-10 laboratorios" style="margin-left: auto; margin-right: auto;">
        
    </div>
</div>

<script>
    let array;

    function buscarPorLetra(letra) {      
        buscar(letra,'')
    }

    function search(){
        buscar('', $(".input_busqueda").val())
    }

    function buscar(letra, palabra) {
        let cadena = '';
        $("#lista").html('')
        $.post(path + "Ayuda/GetSales",
            { 
                letra: letra,
                palabra: palabra
            },
            function (data) {
                $.each(data, function (index, value) {                    
                    if (value.habilitado)
                        cadena += '<div class="col-md-4 col-sm-6"><a class="resultSal a_decoration" href="#" onclick="buscarLaboratorio(' + value.idSal + ')">'
                                + value.sal + '</a></div>';
                    else
                        cadena += '<div class="col-md-4 col-sm-6"><a class="resultSal a_decoration_none">' + value.sal + '</a></div>'
                });

                $("#lista").append(cadena)
            }).error(function () {
                ShowAlert("No fue posible cargar sus datos", false)
        });
    }

    function buscarLaboratorio(Sal){
        let cadena = '<div class="row">';
        $("#divLaboratorio").html('')
        $.post(path + "Ayuda/GetLaboratorioBySal",
            {
                Sal: Sal
            },
            function (data) {
                $.each(data, function (index, value) {
                    cadena += '<div class="col-md-55 col-md-6 col-lg-4 mt-4">'
                        + '<div class="h-100 card card-inverse card-info">'
                        + '<a href="'+path+'Stand/Editar?idProveedor=' + value.proveedor + '" style=" margin: auto;">'
                                        + '<img class="card-img-top" style=" width: 150px; height: 150px; margin: auto;" src="data:image/png;base64,' + value.img + '" alt="image" />'
                                    +'</a>'
                                    +'<div class="card-block" style="text-align: center;">'
                        + '<a href="' + path + 'Stand/Editar?idProveedor=' + value.proveedor + '"><h6 class="card-title">' + value.nombre + '</h6></a>'
                                    +'</div>'
                                +'</div>'
                             +'</div>'                   
                });
                cadena += '</div>';
                $("#divLaboratorio").append(cadena)
            }).error(function () {
                alerta(false, "No fue posible cargar sus datos")
            });
    }
</script>

<style>
    .text-center > .btn {
        width: 2.5rem;
    }

    .a_decoration{
        text-decoration: underline;
        color:var(--azul-oscuro);
    }

    .a_decoration:hover {
        text-decoration: underline;
        color: var(--verde);
    }

    .a_decoration_none{
        text-decoration:unset;
        color:var(--gris);
    }

    .a_decoration_none:hover {
        text-decoration: unset;
        color: var(--gris);
    }

    .col-md-4 {
    margin-top:5px;
    margin-bottom:5px;
    }

    .lab{
        max-width: 150px;
    }

  
</style>