<div class="row">
    <div class="col-md-10" style="margin-left: auto; margin-right: auto;">
        <div class="input-group mb-3 ">
            <input type="text" class="form-control input_busqueda" placeholder="Sales" aria-label="Sales " aria-describedby="basic-addon2">
