    //Se ejecuta la funcion para asignar el valor de idpersona en la variable de session "ClienteSel"
    function SetClienteSel(IdPersona)
    {
        $.post(path + "Generales/SetSessionClienteSel?IdPersona=" + IdPersona,
            function (data) {
                //Se ejecutan las funciones de java script del index.js para inicilizar las opciones del cliente
