@model RegistroViewModel

@{
    ViewData["Title"] = "Registro de ususarios";
    Layout = "~/Views/Shared/_LayoutNoRegistrado.cshtml";
}

<div class="card acceso">
    <div class="card-body">
        <h3 class="text-center">Registro de Usuarios</h3>
        <form asp-controller="Cuentas" asp-action="Registro" method="post" role="form">
            <div class="text-danger" asp-validation-summary="All"></div>

            <div class="row mt-4">               
                <div class="m-auto">
                    <div class="mb-3">
                        <label asp-for="Email" class="col-md-12"></label>
                        <input asp-for="Email" class="form-control" placeholder="Ingresa email" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="col-md-12"></label>
                        <input asp-for="Password" class="form-control" placeholder="Ingresar la Contraseña"/>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="col-md-12"></label>
                        <input asp-for="ConfirmPassword" class="form-control"  placeholder="Confirmar la Contraseña"/>
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>
                    @*</div>
                <div class="row">
                    <div class="col-sm-10 text-center" style="margin: auto">*@
                        <button type="submit" class="btn btn-azul w-100">Registrarse</button>
                    @*</div>*@
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}