@model RecuperaPasswordViewModel;

@{
    ViewData["Title"] = "Recuperar contraseña";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card">
    <div class="card-body">
        <h3 class="card-title text-center">Recuperar contraseña de Usuario</h3>
        <form asp-controller="Cuentas" asp-action="ResetPassword" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post" role="form">

            <!-- Codigo del token-->
            <input type="hidden" asp-for="Code"/>

            <div class="text-danger" asp-validation-summary="All"></div>
            <div class=" row mt-4">
                <div class="col-md-6 offset-3">
                    <div class="mb-3">
                        <label asp-for="Email" class="col-md-2"></label>
                        <input asp-for="Email" class="form-control" placeholder="Ingresa email" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password" class="col-md-3"></label>
                        <input asp-for="Password" class="form-control" placeholder="Ingresar la Contraseña" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div> 
                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="col-md-4"></label>
                        <input asp-for="ConfirmPassword" class="form-control" placeholder="Ingresar la Contraseña" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>                   
                </div>
                <div class="col-sm-4">
                </div>
                <div class="row">
                    <div class="col-sm-6 offset-3">
                        <button type="submit" class="btn btn-success w-100 btn-lg">Acceder <i class="bi bi-box-arrow-in-right"></i></button>                     
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    }