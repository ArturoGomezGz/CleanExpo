@model OlvidoPasswordViewModel

@{
    ViewData["Title"] = "Olvido su Contraseña";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card">
    <div class="card-body">
        <h3 class="card-title text-center">Olvido su contraseña</h3>
        <form asp-controller="Cuentas" asp-action="OlvidoPassword" method="post" role="form">
            <div class="text-danger" asp-validation-summary="All"></div>
            <div class=" row mt-4">
                <div class="col-md-6" style="margin-right: auto; margin-left:auto">                                        
                    <div class="mb-3">
                        <label asp-for="Email" class="col-md-2"></label>
                        <input asp-for="Email" class="form-control"  placeholder="Ingresa email"/>
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-success w-100 btn-lg">Recuperar Contraseña <i class="bi bi-box-arrow-in-right"></i></button>
                </div>                
            </div>
        </form>
    </div>
</div>