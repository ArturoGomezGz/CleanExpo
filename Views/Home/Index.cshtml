    <div class="row mb-3" style="max-width:1400px; margin:auto">
        <div class="titulo_div col-md-12">
            <h2>Bienvenido a Expo Medicinas Rosario 2024</h2>
        </div>
        <div class="titulo_div col-md-12">
            <h3>Visita el stand de los Laboratorios Participantes</h3>
        </div>        
        @{
            List<StandVIewModel> ModeloImagenes = ExpoMR.Controllers.HomeController.GetImage();
            foreach (ExpoMR.Models.StandVIewModel model in ModeloImagenes)
            {
                <div class="col-md-4 col-lg-3 mt-4">
                    <div class="h-100 card card-inverse card-info align-center">
                        <a href="~/Stand/Editar?idProveedor=@string.Format(model.Proveedor.ToString())" style=" margin: auto;" >
                            <img id="Proveedor_@string.Format(model.Proveedor.ToString())" data-id="@Convert.ToString(model.Proveedor)" class="card-img-top" style="width: 150px; height: 150px; margin: auto;" src="" alt="image">                                                               
                        </a>
                        <div class="mx-auto w-75 card-block index_name" style="text-align: center;">
                            <a href="~/Stand/Editar?idProveedor=@string.Format(model.Proveedor.ToString())"><h6 class="index_name">@String.Format(model.Nombre)</h6></a>
                        </div>
                    </div>
                </div> 
            }
        }       
    </div>
</div>

<script>
    async function GetImgAsync(proveedorId)
    {
        try 
        {
            const response = await fetch(`/imagenes/GetLogoProveedor?IdProveedor=${proveedorId}`);

            if (!response.ok) 
            {
                throw new Error('Ocurrió un error al hacer la solicitud.');
            }

            const data = await response.text() // Suponiendo que el controlador devuelve texto

            if(data.length > 0)
                document.getElementById("Proveedor_" + proveedorId).src = "data:image/png;base64," + data;
            else
                document.getElementById("Proveedor_" + proveedorId).src = "../Imagenes/noimage.png";
            
            var imagenesConClaseimg_Carrousell = document.querySelectorAll('img.img_Carrousell_' + proveedorId);

            // Iterar sobre los elementos seleccionados
            imagenesConClaseimg_Carrousell.forEach(function (imagen) 
            {
                if (data.length > 0)
                    imagen.src = "data:image/png;base64," + data;
                else
                    imagen.src = "../Imagenes/noimage.png";
            });
        } 
        catch (error) 
        {
            document.getElementById("Proveedor_" + proveedorId).src = "../Imagenes/noimage.png";
            var imagenesConClaseimg_Carrousell = document.querySelectorAll('img.img_Carrousell_' + proveedorId);

            // Iterar sobre los elementos seleccionados
            imagenesConClaseimg_Carrousell.forEach(function (imagen) 
            {
                imagen.src = "../Imagenes/noimage.png";
            });
        }
    }

    function srcImg()
    {
        var elements = document.querySelectorAll('img.card-img-top');
        
        for (var i = 0; i < elements.length; i++)
        {
            var proveedorId = elements[i].getAttribute("data-id");

            GetImgAsync(proveedorId)
        }       
    }

    $(document).ready(function()
    {    
        srcImg()
    })
</script>