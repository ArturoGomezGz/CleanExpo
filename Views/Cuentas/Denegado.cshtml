@{
    Layout = "~/Views/Shared/_LayoutNoRegistrado.cshtml";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
<style>
    body {
        background-color: rgba(0, 0, 0, 0.50) !important;
    }
</style>
<div style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; display: flex; align-items: center; justify-content: center; z-index: 0;">
  <img src="/Imagenes/logoMR.png" style="max-width: 40vw; max-height: 40vh; filter: blur(8px); opacity: 0.7;">
</div>
<div style="height: 100px;"></div>
<div class="container mt-3 d-flex justify-content-center align-items-center">
  <div class="card">
    <div class="card-header bg-danger text-white mb-3">
    <i class="fa fa-ban" style="font-size:18px;color:white;"></i>
    <strong style="font-size: large;"> Error </strong>
    </div>
    <div class="card-body">
    	<p style="text-align: center;">No tienes permisos para ver este módulo, comunícate con tu ejecutivo<p/>
    </div> 
    <div class="card-footer" style="text-align: right;">
      <div class="row">
          <div class="col" style="text-align: right;">
            <form id="LogOutForm" method="post" asp-controller="Cuentas" asp-action="SalirAplicacion" class="d-inline">
              <button type="submit" id="btn_logout" class="btn btn-outline-dark mt-1 align-middle" title="Cerrar sesión">Salir</button>
            </form>
            @* <a href="~/Home/Index" class="btn btn-primary mt-1 align-middle ms-2">Regresar al inicio</a> *@
        </div>
      </div>
    </div>
  </div>
</div>