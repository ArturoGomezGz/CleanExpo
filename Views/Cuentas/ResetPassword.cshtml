@model RecuperaPasswordViewModel;

@{
    Layout = "~/Views/Shared/_LayoutNoRegistrado.cshtml";
}

<div class="card acceso">
    <div class="card-body">
        <h3 class="text-center">Cambiar Contraseña</h3>
        <form asp-controller="Cuentas" asp-action="ResetPassword" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post" role="form">

            <!-- Codigo del token-->
            <input type="hidden" asp-for="Code"/>

            <div class="text-danger" asp-validation-summary="All"></div>
            <div class=" row mt-4">
                <div class="m-auto">
                    <div class="mb-3">
                        <label asp-for="Email" class="col"></label>
                        <input asp-for="Email" class="form-control" placeholder="email@correo.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password" class="col"></label>
                        <input asp-for="Password" class="form-control" placeholder="Ingresar la Contraseña" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div> 
                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="col"></label>
                        <input asp-for="ConfirmPassword" class="form-control" placeholder="Ingresar la Contraseña" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>                   
                @*</div>
                <div class="col-md-4">
                </div>                
            </div>
            <div class="row mt-4">
                <div class="col-sm-6 offset-md-3 justify-content-center d-flex">*@
                    <button type="submit" class="btn btn-azul w-100"> Cambiar Contraseña </button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}