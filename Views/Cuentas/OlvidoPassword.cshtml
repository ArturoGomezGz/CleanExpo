@model OlvidoPasswordViewModel

@{
    ViewData["Title"] = "Olvido su Contraseña";
    Layout = "~/Views/Shared/_LayoutNoRegistrado.cshtml";
}

<div class="card acceso">
    <div class="card-body">
        <h3 class="text-center">Olvido su Contraseña</h3>
        <form asp-controller="Notificaciones" asp-action="OlvidoPassword" method="post" role="form">
            <div class="text-danger" asp-validation-summary="All"></div>
            <div class=" row mt-4">
                <div class="m-auto">                                        
                    <div class="mb-3">
                        <label asp-for="Email" class="col-md-2"></label>
                        <input asp-for="Email" class="form-control"  placeholder="Ingresa email"/>
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-azul w-100">Recuperar Contraseña</button>
                </div>                
            </div>
        </form>
    </div>
</div>