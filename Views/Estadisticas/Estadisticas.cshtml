@{
    ViewData["Title"] = "Estadisticas";
}


<h3>Estadísticas</h3>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div class="col-sm-12 col-md-12 ">
    <div class="card">
        <div class="card-header">
            <ul class="nav nav-tabs card-header-tabs" data-bs-tabs="tabs">
                <li class="nav-item">
                    <a class="nav-link active link-item-titulo" aria-current="true" data-bs-toggle="tab" href="#visitas"> Visitas</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link link-item-titulo" data-bs-toggle="tab" href="#productos"> Productos</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link link-item-titulo" data-bs-toggle="tab" href="#ventas"> Ventas</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link link-item-titulo" data-bs-toggle="tab" href="#monedas"> Monedas</a>
                </li>
            </ul>
        </div>
        <div class="card-body tab-content">
            <div class="tab-pane active" id="visitas">
                <div class="form-group">
                    <div class="row">
                        <h4> Visitas </h4>
                        <div class="col-md-12">
                            <canvas id="canvasVisitas" width="300" height="200"></canvas>
                        </div>
                    </div>
                    <hr />
                    <div class="row">
                        <div class="col-md-6">
                            <h5>Últimas Visitas</h5>

                            <table id="Ultimas__visitas" class="display" style="width:100%"></table>
                        </div>
                        <div class="col-md-6">
                            <h5> Productos Visitados</h5>
                            <table id="productos__visitados" class="display" style="width:100%"></table>
                        </div>
                    </div>
                </div>
            </div>
            <div class="tab-pane" id="productos">
                <div class="row">
                    <table id="productos__info" class="display" style="width:100%"></table>
                </div>
            </div>
            <div class="tab-pane" id="ventas">
                <div class="row">
                    <div class="col-md-6">
                        <div>
                            <canvas id="canvasVentaPiezas" width="300" height="200"></canvas>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div>
                            <canvas id="canvasVentaMonto" width="300" height="200"></canvas>
                        </div>
                    </div>
                </div>
            </div>
            <div class="tab-pane" id="monedas">
                <div class="row">
                    <div style="width: 900px; height: 500px;">
                        <canvas id="canvasMonedas" width="300" height="200"></canvas>
                    </div>
                </div>
                <div class="row">
                    <table id="monedas__asignadas" class="display" style="width:100%"></table>
                </div>
            </div>
        </div>
    </div>
</div>


@*Modal producto detalle*@
<div class="modal fade" id="productosDetail" tabindex="-1" aria-labelledby="productosDetaillLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel"> Detalle Producto </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row mb-4">
                    <div class="col">
                        <img id="img_producto_detail" class="card-img-top" src="" alt="image">
                    </div>
                    <div class="col pt-4">
                      <h4 class="mt-4" id="titulo_producto"></h4>
                      <div class="col"><strong>Código: </strong><label id="label_codigo"></label></div>
                      <div class="col"><strong>Fórmula: </strong><label id="label_formula"></label></div>
                    </div>
                </div>
                <hr />
                <div class="row mb-4">
                    <table>
                        <tbody>
                            <tr class="visitasEstadisticas">
                                <td>
                                    <img src="~/Imagenes/visitas.png">
                                </td>
                                <td style="width:35%">
                                    <p class="valorEtadisticas" id="numero_visitas"></p>
                                    <p class="estadisticasTexto">Número Visitas</p>
                                </td>
                                <td>
                                    <img src="~/Imagenes/visitasCliente.png">
                                </td>
                                <td style="width:35%">
                                    <p class="valorEtadisticas" id="clientes_visitas"></p>
                                    <p class="estadisticasTexto"> Clientes que Visitaron</p>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <img src="~/Imagenes/carritoEstadisticas.png">
                                </td>
                                <td>
                                    <p class="valorEtadisticas" id="piezas_carrito"></p>
                                    <p class="estadisticasTexto">Piezas en Carritos</p>
                                </td>
                                <td>
                                    <img src="~/Imagenes/carritoClienteEstadisticas.png">
                                </td>
                                <td>
                                    <p class="valorEtadisticas" id="piezas_carrito_cliente"></p>
                                    <p class="estadisticasTexto">Clientes que tienen en Carrito</p>
                                </td>
                            </tr>
                            <tr class="visitasEstadisticas">
                                <td>
                                    <img src="~/Imagenes/confirmado.png">
                                </td>
                                <td>
                                    <p class="valorEtadisticas" id="piezas_confirmadas"></p>
                                    <p class="estadisticasTexto">Piezas Confirmadas</p>
                                </td>
                                <td>
                                    <img src="~/Imagenes/confirmadoCliente.png">
                                </td>
                                <td>
                                    <p class="valorEtadisticas" id="confimado_cliente"></p>
                                    <p class="estadisticasTexto">Clientes que han Confirmado</p>
                                </td>
                                <td>
                                    <img src="~/Imagenes/monto.png">
                                </td>
                                <td style="width:35%">
                                    <p class="valorEtadisticas" id="monto_total"></p>
                                    <p class="estadisticasTexto">Monto Total</p>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <hr />
                <div class="row mt-4">
                    <table id="detalle__Producto" class="display" style="width:100%"></table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-rojo" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<script>
    var cdVentaPiezas = {
        labels: [],
        datasets: [
            {
                label: "Piezas Confirmadas",
                backgroundColor: "#538AB6",
                borderColor: "#538AB6",
                borderWidth: 1,
                data: []
            },
            {
                label: "Piezas en Carrito",
                backgroundColor: "#F6C85F",
                borderColor: "#F6C85F",
                borderWidth: 1,
                data: []
            }
        ]
    };

    var cdVentaMonto = {
        labels: [],
        datasets: [
            {
                label: "Monto Confirmado",
                backgroundColor: "#8CBA9C",
                borderColor: "#8CBA9C",
                borderWidth: 1,
                data: []
            }
        ]
    };

    var cdVisitas = {
        labels: [],
        datasets: [
            {
                label: "Stand",
                backgroundColor: "#CB472E",
                borderColor: "#CB472E",
                borderWidth: 1,
                data: []
            },
            {
                label: "Productos",
                backgroundColor: "#538AB6",
                borderColor: "#538AB6",
                borderWidth: 1,
                data: []
            }
        ]
    };

    
    var cdMonedas = {
        labels: [],
        datasets: [
            {
                label: "Monedas",
                backgroundColor: "#F6C85F",
                borderColor: "#F6C85F",
                borderWidth: 1,
                data: []

            }
        ]
    };

    var chartOptions = {
        responsive: true,
        legend: {
            position: "top"
        },
        title: {
            display: true,
        },
        scales: {
            y: {
                ticks: {
                    beginAtZero: true,
                    min: 0,
                    max: 100,
                    stepSize: 20
                    //callback: function (value, index, values) {
                    //    return value + '%';
                    //}
                }
            }
        }
    }


    window.onload = function () {
        //Grafica Visitas
        $.ajax({
            type: "POST",
            url: path + "Estadisticas/GetDatosGraficaVisitas",
            success: function (resultado) {
                cdVisitas.labels = resultado.map(item => item.fecha);
                cdVisitas.datasets[0].data = resultado.map(item => item.stand);
                cdVisitas.datasets[1].data = resultado.map(item => item.producto);

                var ctx4 = document.getElementById("canvasVisitas").getContext("2d");
                window.myBar = new Chart(ctx4, {
                    type: "line",
                    data: cdVisitas,
                    options: chartOptions
                });
            },
            error: function (xhr, status, error) {
                console.log(error);
            }
        });

        //Grafica Moneas
        $.ajax({
            type: "POST",
            url: path + "Estadisticas/GetDatosGraficaMonedas",
            success: function (resultado) {
                cdMonedas.labels = resultado.map(item => item.fecha);
                cdMonedas.datasets[0].data = resultado.map(item => item.monedas);

                var ctx = document.getElementById("canvasMonedas").getContext("2d");
                window.myBar = new Chart(ctx, {
                    type: "bar",
                    data: cdMonedas,
                    options: chartOptions
                });
            },
            error: function (xhr, status, error) {
                console.log(error);
            }
        });

        //Grafica Ventas
        $.ajax({
            type: "POST",
            url: path + "Estadisticas/GetDatosGraficaVenta",
            success: function (resultado) {
                cdVentaPiezas.labels = resultado.map(item => item.fecha);
                cdVentaPiezas.datasets[0].data = resultado.map(item => item.piezasConfirmado);
                cdVentaPiezas.datasets[1].data = resultado.map(item => item.piezasCarrito);

                var ctx2 = document.getElementById("canvasVentaPiezas").getContext("2d");
                window.myBar = new Chart(ctx2, {
                    type: "bar",
                    data: cdVentaPiezas,
                    options: chartOptions
                });

                cdVentaMonto.labels = resultado.map(item => item.fecha);
                cdVentaMonto.datasets[0].data = resultado.map(item => item.ventaProv);

                var ctx3 = document.getElementById("canvasVentaMonto").getContext("2d");
                window.myBar = new Chart(ctx3, {
                    type: "bar",
                    data: cdVentaMonto,
                    options: chartOptions
                });

            },
            error: function (xhr, status, error) {
                console.log(error);
            }
        });
    };

    $(document).ready(function(){

        $('#Ultimas__visitas').DataTable({
            responsive: true,
            "info": false,
            "language": {"url": "//cdn.datatables.net/plug-ins/1.10.16/i18n/Spanish.json"},
            "ajax": {
                url: path+ "Estadisticas/GetRegistroVisitas",
                type: 'POST',
                dataSrc: ""
            },
            "columns": [                
                { 
                    "data": "idPersona",
                    render: function (data, type) {
                        if (type === 'display') {
                            return '<a onclick="GetPrecios(' + data + ')" class="btn btn-link"><i class="fa fa-chevron-right" aria-hidden="true"></i></a>';
                        }
                        return data;
                    },
                    title: ""
                },
                { "data": "cliente", title: " Cliente " },
                { "data": "fecha", title: " Hora " }
            ]
        });
    
        $('#productos__visitados').DataTable({
            responsive: true,
            "info": false,
            "language": {"url": "//cdn.datatables.net/plug-ins/1.10.16/i18n/Spanish.json"},
            "ajax": {
                url: path+ "Estadisticas/GetProductosVisitados",
                type: 'POST',
                dataSrc: ""
            },
            "columns": [                
                { 
                    "data": "idProducto",
                    render: function (data, type) {
                        if (type === 'display') {
                            return '<a onclick="modalShow(' + data + ')" class="btn btn-link"><i class="fa fa-chevron-right" aria-hidden="true"></i></a>';
                        }
                        return data;
                    },
                    title: ""
                },
                { "data": "producto", title: " Producto " },
                { "data": "visitas", title: " visitas " }
            ]
        });

        $('#productos__info').DataTable({
            responsive: true,
            "info": false,
            "language": {"url": "//cdn.datatables.net/plug-ins/1.10.16/i18n/Spanish.json"},
            "ajax": {
                url: path + "Estadisticas/GetProductosInfo",
                type: 'POST',
                dataSrc: ""
            },
            "columns": [                
                { 
                    "data": "idProducto",
                    render: function (data, type) {
                        if (type === 'display') {
                            return '<a onclick="modalShow(' + data + ')" class="btn btn-link"><i class="fa fa-chevron-right" aria-hidden="true"></i></a>';
                        }
                        return data;
                    },
                    title: ""
                },
                { "data": "producto", title: " Producto " },
                { "data": "visitas", title: " Visitas " },
                { "data": "carrito", title: " Carrito " },
                { "data": "confirmado", title: " Confirmado " },
                { "data": "ventaProv", title: " Monto Venta " }
            ]
        });

        $('#monedas__asignadas').DataTable({
            responsive: true,
            "info": false,
            "language": {"url": "//cdn.datatables.net/plug-ins/1.10.16/i18n/Spanish.json"},
            "ajax": {
                url: path + "Estadisticas/GetMonedasAsignadas",
                type: 'POST',
                dataSrc: ""
            },
            "columns": [                               
                { "data": "cliente", title: " Cliente " },
                { "data": "monedas", title: " Monedas " },
                { "data": "fecha", title: " Fecha " },
                { "data": "motivo", title: " Motivo " }
            ]
        });        
       
        GridDetalleProducto(0)
    });

    function modalShow(idProducto){
        var myModal = new bootstrap.Modal(document.getElementById('productosDetail'), {
            focus: true
        })
        var modalToggle = document.getElementById('productosDetail') // relatedTarget
        myModal.show(modalToggle)

        
        $.post("/Estadisticas/DetailProducto",
            {
                IdProducto: idProducto
            },
            function (data) {
                document.getElementById("img_producto_detail").src = "data:image/png;base64," + data[0].imgProducto;

                $("#titulo_producto").html(data[0].producto)
                $("#label_codigo").html(data[0].codigo)
                $("#label_formula").html(data[0].formula)

                $("#numero_visitas").html(data[0].visitas)
                $("#clientes_visitas").html(data[0].visitasCliente)

                $("#piezas_carrito").html(data[0].carrito)
                $("#piezas_carrito_cliente").html(data[0].carritoCliente)

                $("#piezas_confirmadas").html(data[0].confirmado)
                $("#confimado_cliente").html(data[0].confirmadoCliente)
                $("#monto_total").html(data[0].ventaProv)


            }).error(function () {
            });

        $('#detalle__Producto').dataTable().fnDestroy();

        GridDetalleProducto(idProducto)
    }

    function GridDetalleProducto(idProducto) {
        $('#detalle__Producto').DataTable({
            responsive: true,
            "info": false,
            "language": {"url": "//cdn.datatables.net/plug-ins/1.10.16/i18n/Spanish.json"},
            "ajax": {
                url: path + "Estadisticas/GetDetalleProducto?IdProducto=" + idProducto,
                type: 'POST',
                dataSrc: ""
            },
            "columns": [
                { "data": "nombre", title: " Nombre " },
                { "data": "visitas", title: " Visitas " },
                { "data": "carrito", title: " Carrito " },
                { "data": "confirmado", title: " Confirmado " },
                { "data": "ventaProv", title: " VentaProv " }
            ]
        });
    }

    function GetPrecios(idCliente){
        document.location = '@Url.Action("Precios","Proveedores")' + '?idCliente=' + idCliente;
    }
</script>