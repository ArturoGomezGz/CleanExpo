@model CambiarPasswordViewModel;

@using Microsoft.AspNetCore.Identity;
@inject UserManager<IdentityUser> UserManager;
<div class="row">
    <div class="col-md-10" style="margin-left: auto; margin-right: auto;">
        @{
            ViewData["Title"] = "Recuperar contraseña";
            Layout = "~/Views/Shared/_Layout.cshtml";
        }

        <div class="card acceso">
            <div class="card-body">
                <h3 class="text-center">Cambia tu Contraseña</h3>
                <form asp-controller="MiCuenta" asp-action="Index" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post" role="form">
                    <div class="text-danger" asp-validation-summary="All"></div>
                    <div class=" row mt-4">
                        
                        <input type="hidden" name="email" value="@UserManager.GetUserName(User)"/>

                        <div class="m-auto">
                            <div class="mb-3">
                                <label asp-for="Password" class="col-md-12"></label>
                                <input asp-for="Password" class="form-control" placeholder="Ingresar la Contraseña" />
                                <span asp-validation-for="Password" class="text-danger"></span>
                            </div>
                            <div class="mb-3">
                                <label asp-for="ConfirmPassword" class="col-md-12"></label>
                                <input asp-for="ConfirmPassword" class="form-control" placeholder="Ingresar la Contraseña" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                            </div>
                            @*</div>
                        <div class="col-sm-4">
                        </div>
                        <div class="row">
                            <div class="col-sm-6 offset-md-3">*@
                                <button type="submit" class="btn btn-azul w-100">Cambiar Contraseña <i class="bi bi-box-arrow-in-right"></i></button>
                            @*</div>*@
                        </div>
                    </div>
                </form>
            </div>
        </div>

        @section Scripts{
            @{
                await Html.RenderPartialAsync("_ValidationScriptsPartial");
            }
        }
    </div>   
</div>