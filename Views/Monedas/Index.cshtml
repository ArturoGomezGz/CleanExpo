@{
    ViewData["Title"] = "Index";
}

<h5 id="Saldo_monedas" class="mb-4"></h5>

<div class="row mt-4">
    <table id="Monedas" class="display" style="width:100%"></table>
</div>

<script>
    $(document).ready(function ()
    {
        $('#Monedas').DataTable({
            responsive: true,
            "info": false,
            "language": {"url": "//cdn.datatables.net/plug-ins/1.10.16/i18n/Spanish.json"},
            "ajax": 
            {
                url: path + "Generales/GetRegistroMonedas",
                type: 'POST',
                dataSrc:""
            },
            "columns": [
                {"data": "fecha", title: "Fecha",
                    "render": function (data, type, row)
                    {
                        return data;
                    }
                },
                { "data": "concepto", title: "concepto" },
                { "data": "importe", title: "importe" },
                { "data": "saldo", title: "saldo" }
            ]
        });

        $.post(path + "Generales/GetMonedas",
            function (data) 
            {
               
                var dia = FormatoFecha();              
               
                $("#Saldo_monedas").html("Saldo al "+dia+" " + data + " Monedas")
            }).error(function () 
            {
                alerta(false, "No fue posible cargar sus monedas")
            }
        );
    });
</script>