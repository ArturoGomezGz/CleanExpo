        //     {               
        //         var dia = FormatoFecha();              
               
        //         $("#Saldo_monedas").html("Saldo al "+dia+" " + data + " Monedas")
        //     }).error(function () 
        //     {
        //         ShowAlert("No fue posible cargar sus monedas", false)
        //     }
        // );
    });
</script>