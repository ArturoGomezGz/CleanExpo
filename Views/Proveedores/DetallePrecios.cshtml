@model int
@{
    ViewData["Title"] = "Precios Proveedor";
}
<div id="liveAlertPlaceholder"></div>

<!-- Modal para editar Descuento Adicional -->
<div class="modal fade" id="modalEditarDescuento" tabindex="-1" aria-labelledby="modalEditarDescuentoLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalEditarDescuentoLabel">Editar Descuento Adicional</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="nombreProductoModal" style="font-weight:bold; margin-bottom:10px;"></div>
                <label for="inputNuevoDescuento">Nuevo porcentaje de descuento:</label>
                <input type="number" id="inputNuevoDescuento" class="form-control" min="0" max="100" />
                <input type="hidden" id="inputRowIndex" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="btnGuardarDescuento">Guardar</button>
            </div>
        </div>
    </div>
</div>
<div class="col-md-12">    
    <div class="d-flex flex-column align-items-center">
        <strong id="lblCliente"></strong>
        <br />
        <a asp-controller="Proveedores" asp-action="Precios" class="btn btn-naranja text-light">Cambiar Cliente</a>
    </div>
    <table class="table" id="PrecioClientes" style="width:100%"></table>
</div>

@*Modal Terminos y condiciones*@
<div class="modal fade" id="exampleModalToggle" aria-hidden="true" aria-labelledby="exampleModalToggleLabel" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalToggleLabel">
                    <label id="lblMensaje">El descuento otorgado al cliente es mayor al costo.</label>
                </h5>
            </div>
            <div id="TerminosCondiciones" class="modal-body">
                <input type="checkbox" id="miCheckbox">
                <label for="vehicle1"> Acepto</label><label><a href="#" data-bs-target="#exampleModalToggle2" data-bs-toggle="modal" data-bs-dismiss="modal"> los Términos y Condiciones</a></label>
            </div>
            <div class="col-md-12">
                <div class="row text-center">
                    <div class="col-md-6">
                        <button type="button" id="success" class="btn btn-verde-medio btn-success">Acepto</button>
                    </div>
                    <div class="col-md-6">
                        <button type="button" class="btn btn-rojo btn-cancelar" data-bs-dismiss="modal">Cancelar</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="exampleModalToggle2" aria-hidden="true" aria-labelledby="exampleModalToggleLabel2" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-body">
                <h1>Términos y Condiciones</h1>
                <br />
                <h2>Obligaciones del Promotor</h2>
                <p>
                    - <b>“LA EMPRESA”</b> establece un precio para cada producto, sin embrago, el proveedor podrá negociar uno diferente al pactado en la página oficial, con la intención de mejorar el publicado, el cual <b>“MEDICINAS ROSARIO”</b>, no se hace responsable del precio pactado entre el proveedor y el cliente.<br />

                    - <b>“LA EMPRESARIA”</b> permite que se realice ese tipo de negociación en el sitio lugar del presente instrumento, durante el evento, quedando evidenciado el precio pactado entre las partes mismo que será almacenado en la misma contratación.<br />

                    - <b>“EL PROVEEDOR”</b>  una vez que otorgue el precio al cliente, no podrá cambiarlo, salvo para en beneficio de este, es decir, podrá mejorar el con anterioridad pactado. </br>

                    - El proveedor queda obligado del pago a <b>“LA EMPRESARIA”</b>  por el medio que se establezca o los ya reconocidos por los contratantes,  la diferencia entre el precio que estableció <b>“MEDICINAS ROSARIO”</b> y el precio que otorgó al cliente, mismo que queda debidamente firme y almacenado en la página, lugar de este contrato.<br />

                </p>
            </div>
            <div class="modal-footer">
                <button class="btn btn-azul-medio" data-bs-target="#exampleModalToggle" data-bs-toggle="modal" data-bs-dismiss="modal">Regresar</button>
            </div>
        </div>
    </div>
</div>

<script>   
    function PreciosDt() {
        let cliente = @Model

            $('#PrecioClientes').DataTable({
                order: [[1, 'asc']],
                responsive: true,
                "info": false,
                "language": { "url": "//cdn.datatables.net/plug-ins/1.10.16/i18n/Spanish.json" },
                "ajax":
                {
                    url: path + "Proveedores/getPreciosCliente?cliente=" + cliente,
                    type: 'POST',
                    dataSrc: ""
                },
                "columns": [
                    { "data": "codigo", title: "Código" },
                    { "data": "producto", title: "Producto" },
                    {
                        "data": "comprado",
                        title: "Comprado",
                        render: function (data, type) {
                            if (data) {
                                return '<i class="far fa-check-square" aria-hidden="true"></i>';
                            }

                            return '<i class="far fa-square" aria-hidden="true"></i>';
                        }
                    },
                    { "data": "carrito", title: "Carrito" },
                    { "data": "pedido", title: "Pedido" },
                    {
                        "data": "preciocliente", title: "Precio Cliente",
                        "render": function (data, type, row) {
                            return FormatoMoneda(data);
                        }

                    },
                    {
                        "data": "descuentoexpo", title: "Descuento Expo",
                        "render": function (data, type, row) {
                            return data + ' %';
                        }
                    },
                    {
                        "data": "precioexpo", title: "Precio Expo",
                        "render": function (data, type, row) {
                            return FormatoMoneda(data);
                        }
                    },
                    {
                        "data": "preciofinal", title: "Precio Final",
                        "render": function (data, type, row) {
                            return FormatoMoneda(data);
                        }
                    },
                    {
                        "data": "descuentoadicional",
                        title: "Descuento Adicional",
                        render: function (data, type, row) {
                            if (type === 'display') {
                                return '<input name="DescuentoAdicional" class="text" type="number" value="' + data + '" disabled style="width:70px; heigth:70px"/> %'
                                    + '<input class="hdfCosto" type="hidden" value="' + row.costo + '" style="display:none"/>'
                                    + '<input class="hdfPrecioExpo" type="hidden" value="' + row.precioexpo + '" style="display:none"/>';
                            }

                            return data;
                        },
                    },
                    {
                        "data": "idproducto",
                        render: function (data, type, row) {
                            
                                return '<input class="hdfIdProducto" type="hidden" value="' + data + '" style="display:none"/>'
                                    + '<a class="btn btn-naranja-ch editprecio" ><i class="fas fa-pencil-alt"></i></a>'
                                    + '<a class="btn btn-outline-success acepteditprecio" style="display:none"><i class="fas fa-check" aria-hidden="true"></i></a>'
                                    + '<a class="btn btn-outline-danger canceleditprecio" style="display:none"><i class="fas fa-ban" aria-hidden="true"></i></a>';
                            

                            return ''
                        }

                    }
                ]
            })
    }

    // Nuevo: Al hacer clic en editar, abrir modal para editar descuento
    $(document).on('click', '.editprecio', function (event) {
        var row = $(this).closest("tr");
        var inputElement = row.find('.text');
        var valorActual = inputElement.val();
        var rowIndex = row.index();

        // Obtener el nombre del producto de la columna correspondiente
        var nombreProducto = row.find('td').eq(1).text();
        $('#nombreProductoModal').text(nombreProducto);

        // Guardar el valor actual y el índice de la fila en el modal
        $('#inputNuevoDescuento').val(valorActual);
        $('#inputRowIndex').val(rowIndex);

        var modal = new bootstrap.Modal(document.getElementById('modalEditarDescuento'));
        modal.show();
    });

    // Guardar el nuevo descuento desde el modal
    $(document).on('click', '#btnGuardarDescuento', function () {
        var nuevoDescuento = $('#inputNuevoDescuento').val();
        var rowIndex = $('#inputRowIndex').val();
        var row = $('#PrecioClientes tbody tr').eq(rowIndex);
        var inputElement = row.find('.text');
        inputElement.val(nuevoDescuento);
        inputElement.prop('disabled', false);

        // Mostrar botones de aceptar/cancelar
        row.find(".acepteditprecio").show();
        row.find(".canceleditprecio").show();
        row.find(".editprecio").hide();

        // Cerrar el modal
        var modal = bootstrap.Modal.getInstance(document.getElementById('modalEditarDescuento'));
        modal.hide();

        // Llamar directamente a la lógica de aceptar descuento
        aceptarDescuentoFila(row);
    });

    // Nueva función: lógica de aceptar descuento para una fila
    function aceptarDescuentoFila(row) {
        var ddlLisClientes = @Model;
        var idproducto, DescClienteNew, Costo, PrecioExpo;

        $("td", row).each(function () {
            if ($(this).find(".text").length > 0) 
            {
                DescClienteNew = row.find('.text').val();
                Costo = row.find('.hdfCosto').val();
                PrecioExpo = row.find('.hdfPrecioExpo').val();
                idproducto = row.find('.hdfIdProducto').val();
            }
        });

        var inputElement = row.find('.text');

        row.find(".editprecio").show();
        row.find(".canceleditprecio").hide();
        row.find(".acepteditprecio").hide();

        $.post(path + "Proveedores/ValidaDescuento",
            {
                DescuentoNuevo: DescClienteNew,
                Costo: Costo,
                PrecioExpo: PrecioExpo
            },
            function (data)
            {
                if (data == 0) {
                    alert("El descuento del cliente ingresado debe ser mayor a 0.", false);
                    inputElement.prop('disabled', true);
                    var tabla = $('#PrecioClientes').DataTable();
                    tabla.ajax.reload();
                }
                else 
                {
                    if (data == 2)
                    {
                        document.getElementById("lblMensaje").style.visibility = "visible";
                        document.getElementById("lblMensaje").style.color = "red";
                    }
                    else
                    {
                        document.getElementById("lblMensaje").style.visibility = "hidden";
                    }
                        
                    const myModal = new bootstrap.Modal(document.getElementById('exampleModalToggle'));
                    myModal.show();

                    $('#exampleModalToggle').off('click', '.btn-success').on('click', '.btn-success', function () {
                        const miCheckbox = document.getElementById("miCheckbox");

                        if (miCheckbox.checked && inputElement.val() > 0) {
                            $.post(path + "Proveedores/productoAgregarDescuento",
                                {
                                    IdCliente: ddlLisClientes,
                                    IdProducto: idproducto,
                                    PorcentajeDescuento: inputElement.val()
                                },
                                function (data) // Esta función se ejecutará cuando la solicitud sea exitosa
                                {
                                    myModal.hide();
                                    miCheckbox.checked = false;
                                    inputElement.prop('disabled', true);
                                    row.find(".editprecio").hide()
                                    $('#PrecioClientes').dataTable().fnDestroy();
                                    PreciosDt()
                                },
                            );
                        }
                        else {
                            myModal.hide();
                            //aquí, solo deja los botones visibles para la funcionalidad
                            row.find(".editprecio").hide();
                            row.find(".acepteditprecio").show();
                            row.find(".canceleditprecio").show();
                        }
                    });

                    $('#exampleModalToggle').off('click', '.btn-cancelar').on('click', '.btn-cancelar', function () {
                        row.find(".editprecio").show();
                        row.find(".acepteditprecio").hide();
                        row.find(".canceleditprecio").hide();

                        var inputElement = row.find('.text');
                        inputElement.prop('disabled', true);
                        
                        $('#PrecioClientes').dataTable().fnDestroy();
                        PreciosDt()
                    });
                }
            }).error(function () {
                ShowAlert("No fue posible cargar sus datos", false);
            }
        );
    }

    $(document).on('click', '.acepteditprecio', function (event) {
        var row = $(this).closest("tr");
        aceptarDescuentoFila(row);
    });

    $(document).on('click', '.canceleditprecio', function (event) {
        var row = $(this).closest("tr");

        $("td", row).each(function () {
            if ($(this).find(".text").length > 0) {
                $(this).find(".text").show();
            }
        });

        var inputElement = row.find('.text');
        inputElement.prop('disabled', true);
        inputElement.val(0);

        row.find(".acepteditprecio").hide();
        row.find(".editprecio").show();
        $(this).hide();
    });

    let DescCliente, DescExpo

    $(document).ready(function () {
        PreciosDt()

        $.ajax({
            type: "POST",
            url: path + "Proveedores/getClienteAsignar?idCliente=" + @Model,
            success: function (resultado) {
                document.getElementById('lblCliente').innerHTML = resultado.nombre;
                //document.getElementById('lblnombreclienteRegalo').innerHTML = resultado.nombre;
            },
            error: function (xhr, status, error) {
                console.log(error);
            }
        });
    //    $.ajax({
    //        url: path + "Proveedores/ddlLisCliente",
    //        contentType: "application/json; charset=utf-8",
    //        type: 'POST',
    //        dataType: 'json',
    //        success: function (data) {
    //            // Cargar los datos en el select
    //            var select = $('#ddlLisClientes');
    //            select.empty();
    //            $.each(data, function (index, item) {
    //                select.append($('<option></option>').val(item.cliente).text(item.nombre));
    //            });

    //            if (@Model > 0)
    //                $('#ddlLisClientes').val(@Model);

    //            PreciosDt()
    //        }
    //    });

    //    $('#ddlLisClientes').change(function () {
    //        $('#PrecioClientes').dataTable().fnDestroy();
    //        var ddlLisClientes = $('#ddlLisClientes').val();

    //        PreciosDt()
    //    });
    });
</script>