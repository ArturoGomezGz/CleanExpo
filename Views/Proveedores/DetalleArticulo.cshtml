@model int
@{
    ViewData["Title"] = "DetalleArticulo";
}
<div class="col-md-12 text-center">
    <h1>Detalle del Artículo</h1>
</div>

<div class="col-lg-12" id="div_detalle_articulo">
    <div class="row">
        <div class="col-lg-5 col-sm-12 ">
            <strong>Nombre del Articulo: </strong><br />
            <input type="text" class="form-control" id="txtnombreArticulo" disabled>
            <strong>Descripsion: </strong><br />
            <textarea class="form-control" id="txtdescripcionArticulo" rows="5"></textarea><br />
            <strong>Cantidad todal disponible:</strong><br />
            <input type="text" class="form-control" id="txtcantidadArticulo" disabled><br />
            <div id="hiddenBTN" class="col-sm-12 text-center">
                <button type="button" class="btn btn-outline-success" id="btnSave" onclick="AceptEditArticulo()" title="btn-save">
                    <i class="fa fa-check" aria-hidden="true"></i>
                </button>
                <button type="button" class="btn  btn-outline-danger" id="btnCancel" onclick="CancelEditArticulo()" title="btn-cancel">
                    <i class="fa fa-ban" aria-hidden="true"></i>
                </button>
            </div>
            <div id="div_botones" class="col-sm-12 text-center">
                <button type="button" class="btn btn-primary" id="btnEditar" onclick="EditarArticulo()">Editar</button>
                <button type="button" class="btn btn-danger" id="btnEliminar" onclick="EliminarArticulo()">Eliminar</button>
            </div>
        </div>
        <div class="col-lg-1">

        </div>
        <div class="col-lg-6 col-sm-12 text-center border">
            <strong>Fotos del Artículo: </strong><br />
            <div class="row" id="div_fotos_articulo">
            </div>
            <div class="border">
                <button type="button" class="btn btn-primary" id="btnAgregarFotos" onclick="AgregarFoto()" data-bs-toggle="modal" data-bs-target="#exampleModal">Agregar Fotos</button>
            </div>
        </div>
    </div>
    <!-- Modal Agregar foto -->
    <div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <label>Puedes ingresar desde una hasta tres imágenes del artículo, en formato JPG o PNG.</label>
                </div>
                <div class="modal-body">
                    <form id="formCargarImagen" method="post" enctype="multipart/form-data">
                        <input type="file" class="form-control" id="inputImg" required><br />
                        <label>Selecciona el orden a mostrar de la imagen</label>
                        <select id="ddlOrden"></select>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-primary" id="btnGuardarImagen">Guardar</button>
                </div>
            </div>
        </div>
    </div>
</div>
<br />
<div class="col-md-12 text-center" id="div_btnRegresar">
    <a class="btn btn-secondary" asp-controller="Proveedores" asp-action="Articulos"><i class="fa fa-arrow-left" aria-hidden="true"></i>Mis Articulos</a>
</div>

<script>
    $(document).ready(function () 
    {
        $('#hiddenBTN').hide();
        document.getElementById('txtdescripcionArticulo').disabled = true;
       
        $.ajax({
            type: "POST",
            url: path + "Proveedores/ArticuloSeleccionado?IdArticulo=" + @Model,
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (resultado)
            {
                document.getElementById('txtnombreArticulo').value = resultado.nombre;
                document.getElementById('txtdescripcionArticulo').innerHTML = resultado.descripcion;
                document.getElementById('txtcantidadArticulo').value = resultado.cantidad;
            },
            error: function (xhr, status, error)
            {
                console.log(error);
            }
        });

        $.ajax({
            type: "POST",
            url: path + "Proveedores/imgArticulo?IdArticulo=" + @Model,
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (resultado)
            {
                let cadena ="";
                $.each(resultado, function (index, value) 
                {                   
                    console.log(value);
                    cadena += '<div class="col-md-6" id="' + value.iDdArticulos + '"><div class="card card-inverse card-info">'
                        + '<strong>Foto:</strong><div class=text-center><select style="display:none; width: 50px; height: 25px;" id="orden_' + value.iDdArticulos + '"><option value="1">1</option><option value="2">2</option><option value="3">3</option></select></div><label id="numFoto_' + value.iDdArticulos + '" class="">' + value.numFoto + '</label>'
                        + '<img class="card-img-top" style="width: 150px; height: 150px; margin: auto;" src="data:image/jpg;base64,' + value.foto + '" alt="image" /><br />'
                        + '<div id="divbtnGuardarNumFoto_' + value.iDdArticulos + '" class="col-md-12 text-center" style="display:none"><button type="button" class="btn btn-outline-success" id="btnSave" onclick="AceptEditOrdenFoto(' + value.iDdArticulos + ')" title="btn-save">'
                        + '<i class="fa fa-check" aria-hidden="true"></i></button>'
                        + '<button type="button" class="btn  btn-outline-danger" id="btnCancel" onclick="CancelEditOrdenFoto(' + value.iDdArticulos + ')" title="btn-cancel">'
                        + '<i class="fa fa-ban" aria-hidden="true"></i>'
                        + '</button>'
                        + '</div>'
                        + '<div id="divbtnEditar_' + value.iDdArticulos + '" class="col-md-12 text-center"><button type="button" class="btn btn-outline-success" id="btnEdit" onclick="EditarOrdenFoto(' + value.iDdArticulos + ')" title="btn-save"><i class="fa-regular fa-pen-to-square" ></i></button>'
                        + '<button type="button" class="btn btn-outline-danger" id="btnSave" onclick="EliminarFotoArticulo(' + value.iDdArticulos + ')" title="btn-save"><i class="fa-sharp fa-solid fa-xmark" ></i></button>'
                        +'</div></div></div>'
                });
                $("#div_fotos_articulo").append(cadena)          
            },
            error: function (xhr, status, error) 
            {
                console.log(error);
            }
        });

        $('#btnGuardarImagen').click(function ()
        {
            let IdArticulo = @Model
            let ddlOrden = $('#ddlOrden').val()

            var archivo = document.getElementById("inputImg").files[0];
            var formData = new FormData();

            formData.append('file', archivo);
            formData.append('idarticulo', IdArticulo);
            formData.append('orden', ddlOrden);
            
                $.ajax({
                    url: path+'Proveedores/ArticuloGuardarImagen',
                    type: 'POST',
                    data: formData,
                contentType: false,
                processData: false,
                    success: function (result) {
                        alert('Imagen subida exitosamente.');
                    window.location.reload();
                    },
                    error: function (xhr, status, error) {
                        alert('Error al subir la imagen.');
                    }
                });
        });

    });

    function EditarArticulo() 
    {
        $('#btnEditar').hide();
        $('#btnEliminar').hide();
        document.getElementById('txtnombreArticulo').disabled = false;
        document.getElementById('txtdescripcionArticulo').disabled = false;
        document.getElementById('txtcantidadArticulo').disabled = false;
        $('#hiddenBTN').show();
    }

    function CancelEditArticulo() 
    {
        $('#btnEditar').show();
        $('#btnEliminar').show();
        document.getElementById('txtnombreArticulo').disabled = true;
        document.getElementById('txtdescripcionArticulo').disabled = true;
        document.getElementById('txtcantidadArticulo').disabled = true;
        $('#hiddenBTN').hide();
        //Hace la recarga de la pagina
        window.location.reload();
    }

    function AceptEditArticulo() 
    {
        let IdArticulo = @Model;
        let Nombre = document.getElementById("txtnombreArticulo").value;
        let Descripcion = document.getElementById("txtdescripcionArticulo").value;
        let Cantidad = document.getElementById("txtcantidadArticulo").value;

        $.post(path + "Proveedores/articuloEditar",
            {
                idarticulo: IdArticulo,
                nombre: Nombre,
                descripcion: Descripcion,
                cantidad: Cantidad
            },
            function (data) {
            }).error(function () {
                ShowAlert("No fue posible cargar sus datos", false);
            });

        window.location.reload();
    }

    function EliminarArticulo()
    {    
        let IdArticulo = @Model;

        $.post(path + "Proveedores/articuloEliminar",
            {
                idarticulo: IdArticulo
            },
            function (data) 
            {
                if (data.valorRetorno = 0)
                {
                    window.alert();
                    alert("El Artículo no fue eliminado, debido a que esta asignado a una promocion.");
                }
                else
                {
                    document.location = '@Url.Action("Articulos")';
                }
            }).error(function () 
            {
                ShowAlert("No fue posible cargar sus datos", false);
            });    
    }

    function AgregarFoto()
    {
        $.ajax({
            url: path + "Proveedores/OrdenFoto?IdArticulo=" + @Model,
            contentType: "application/json; charset=utf-8",
            type: 'POST',
            dataType: 'json',
            success: function (data) 
            {
                // Cargar los datos en el select
                var select = $('#ddlOrden');
                select.empty();
                $.each(data, function (index, item) 
                {
                    console.log(data);
                    select.append($('<option></option>').val(item.ordenfoto).text(item.ordenfoto));
                });
            }
        });
    } 

    function EliminarFotoArticulo(iddarticulo)
    {
        $.post(path + "Proveedores/ArticuloEliminaFoto",
            {
                IDdArticulos: iddarticulo
            },
            function (data) 
            {
                window.location.reload();
            }).error(function () 
            {
                ShowAlert("No fue posible cargar sus datos", false);
            });
    }

    function EditarOrdenFoto(iddarticulo) 
    {
        var contenedor = document.getElementById(iddarticulo);
        $('#divbtnGuardarNumFoto_' + iddarticulo).show();
        $('#divbtnEditar_' + iddarticulo).hide();
        $('#numFoto_' + iddarticulo).hide();
        $('#orden_' + iddarticulo).show();
    }

    function CancelEditOrdenFoto(iddarticulo)
    {
        $('#divbtnEditar_' + iddarticulo).show();
        $('#divbtnGuardarNumFoto_' + iddarticulo).hide();
        $('#numFoto_' + iddarticulo).show();
        $('#orden_' + iddarticulo).hide();
    }

    function AceptEditOrdenFoto(iddarticulo) 
    {
        var NumFoto = $('#orden_' + iddarticulo).val();

        $.post(path + "Proveedores/ArticuloGuardarOrdenFoto",
            {
                numfoto: NumFoto,
                iddarticulos: iddarticulo
            },
            function (data)
            {
                $('#divbtnEditar_' + iddarticulo).show();
                $('#divbtnGuardarNumFoto_' + iddarticulo).hide();
                $('#orden_' + iddarticulo).hide();
                $('#numFoto_' + iddarticulo).show();
                window.location.reload()
            }).error(function () 
            {
                ShowAlert("No fue posible cargar sus datos", false);
            });
    }

</script>