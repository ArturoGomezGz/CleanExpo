@{
    ViewData["Title"] = "Monedas";
}

<h3>Monedas</h3>
<div class="d-flex flex-column flex-md-row justify-content-center  align-items-center">
    <div class="col-md-7 col-12">
        <table id="Clientes" class="display" style="width:100%"></table>
    </div>
    <div class="col-sm-4 col-12 d-inline-flex  justify-content-md-end justify-content-sm-center align-items-center">
        <div class=" p-4 d-flex flex-column justify-content-center align-items-center contenedor">
            <strong> Saldo Monedas </strong>
            <label class="saldo_monedas" id="monedas"></label>
        </div>
    </div>
</div>

<script>
    var idCliente = '';
    $(document).ready(function () {       
        $('#Clientes').DataTable({
            responsive: true,
            "info": false,
            "language": {"url": "//cdn.datatables.net/plug-ins/1.10.16/i18n/Spanish.json"},
            "ajax": {
                url: path + "Proveedores/GetClientes",
                type: 'POST',
                dataSrc: ""
            },
            "columns": [
                {
                    "data": "idPersona",
                    render: function (data, type, row) {
                        return '<a class="btn btn-link" href="' + path + 'Proveedores/AsignaMonedas?idCliente=' + row.idPersona + '"><i class="fas fa-chevron-right" aria-hidden="true"></i></a>';
                    }
                },
                { "data": "nombre", title: "Nombre" },
                { "data": "monedas", title: "Monedas asignadas" }
            ]
        });
        $.ajax({
            type: "POST",
            url: path + "Generales/GetMonedas",
            success: function (resultado) {
                document.getElementById('monedas').innerHTML = " " + resultado;
            },
            error: function (xhr, status, error) {
                console.log(error);
            }
        });
    });
</script>