@model int
@{
    ViewData["Title"] = "Precios Proveedor";
}
<div id="liveAlertPlaceholder"></div>
<div class="col-md-12">
    <div class="col-lg-12 col-md-12 col-sm-12 mb-4">
        <table id="Clientes" class="display" style="width:100%"></table>
    </div>   
</div>

<script>
    $(document).ready(function ()
    {
        $('#Clientes').DataTable({
            responsive: true,
            "info": false,
            "language": { "url": "//cdn.datatables.net/plug-ins/1.10.16/i18n/Spanish.json" },
            "ajax": {
                url: path + "Proveedores/ddlLisCliente",
                type: 'POST',
                dataSrc: ""
            },
            "columns": [
                {
                    "data": "cliente",
                    render: function (data, type, row) {
                        return '<a class="btn btn-link" href="' + path + 'Proveedores/DetallePrecios?idCliente=' + row.cliente + '"><i class="fas fa-chevron-right" aria-hidden="true"></i></a>';
                    }
                },
                { "data": "nombre", title: "Nombre" }
            ],
            "columnDefs": [
                {
                    targets: 0,
                    width: "30px",
                    orderable: false,
                }
            ]
        });
    });
</script>