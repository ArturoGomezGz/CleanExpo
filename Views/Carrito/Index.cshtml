    function habilitarBoton(Documento, CFDI)
    {
        if (Documento === 1) {
            if (CFDI != 0 || CFDI != 23) {
                var element = document.getElementById("next-btn-modal")
                element.removeAttribute("disabled");
                var tipoDoc = document.getElementById("cmb-TipoDoc")
                tipoDoc.removeAttribute("disabled");
            }
        }
    }

    function ChangeTipoDocumento(tipoDocumento)
    {
        var NextBoton = document.getElementById("next-btn-modal")
        var cmbCFDI = document.getElementById("cmb-UsosCFDI")

        switch (tipoDocumento) {
            case "0":
                NextBoton.setAttribute("disabled", "");
                cmbCFDI.setAttribute("disabled", "");
                break;
            case "1":
                NextBoton.removeAttribute("disabled");
                $.post(path + "Carrito/GetDatosFacturacion",
                {
                    IdCliente: @Model.IdCliente
                },
                function (data) {
                   cmbCFDI.value = data.result[0].idUsoCFDI
                })
                .error(function () {
                    ShowAlert("No fue posible cargar tu usoCFDI", false);
                });
                cmbCFDI.removeAttribute("disabled");
                break;
            case "2":
                NextBoton.removeAttribute("disabled");
                cmbCFDI.value = "23"
                cmbCFDI.setAttribute("disabled", "");
                break;
        }
    }

    function ChangeTipoCFDI(usoCFDI)
    {
        var NextBoton = document.getElementById("next-btn-modal")
        var tipoDoc = document.getElementById("cmb-TipoDoc")
        switch (usoCFDI) {
            case "23":
                NextBoton.setAttribute("disabled", "");
                break;
            case "0":
                NextBoton.setAttribute("disabled", "");
                break;
            default:
                NextBoton.removeAttribute("disabled");
                break;
        }
    }

    function ChangeTipoVenta(TipoVenta)
    {
        var NextBoton = document.getElementById("next-btn-modal")
        var cmbEntrega = document.getElementById("cmb-Entrega")
        var transportista = document.getElementById("colocar_Transportista")
        var Porte = document.getElementById("colocar_Porte")
        switch (TipoVenta) {
            case "0":
                NextBoton.setAttribute("disabled", "");
                break;
            case "1":
                cmbEntrega.classList.add('d-none');
                transportista.classList.add('d-none');
                Porte.classList.add('d-none');
                break;
            case "2":
                cmbEntrega.classList.remove('d-none');
                transportista.classList.remove('d-none');
                Porte.classList.remove('d-none');
                break;
            case "3":
                cmbEntrega.classList.remove('d-none');
                transportista.classList.add('d-none');
                Porte.classList.add('d-none');
                break;
            case "4":
                cmbEntrega.classList.remove('d-none');
                transportista.classList.add('d-none');
                Porte.classList.add('d-none');
                break;
        }
    }

