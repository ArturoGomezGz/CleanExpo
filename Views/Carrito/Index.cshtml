                            <p class="mb-0"><strong>Porte: </strong><label id="confirmar_Porte"></label></p>
                            <div style="text-align:center">
                                <button type="button" onclick="TerminarOrden()" class="btn btn-naranja mb-1 mt-1">Colocar tu Orden <i class="fa fa-chevron-circle-right"></i> </button>
                            </div>
                        </div>
                    </div>
                    <div class="progress">
                        <div class="progress-bar" role="progressbar" style="width: 33%" aria-valuenow="33" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-azul-medio d-none mb-0 mt-0" id="prev-btn-modal"><i class="fa fa-chevron-circle-left"></i> Anterior</button>
                <button class="btn btn-azul-medio mb-0 mt-0" id="next-btn-modal" disabled>Siguiente <i class="fa fa-chevron-circle-right"></i></button>
                <button class="btn btn-rojo mb-0 mt-0" onclick="onCancel()">Cancelar</button>
            </div>
        </div>
    </div>
</div>

