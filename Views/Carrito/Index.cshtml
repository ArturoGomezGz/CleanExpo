                        </div>
                        <div id="step-3" class="tab-pane" role="tabpanel" aria-labelledby="step-3">
                            <h4>Paso 3</h4>
                            <p class="mb-0"><strong>Cliente: </strong><label id="confirmar_Cliente"></label></p>
                            <p class="mb-0"><strong>RFC: </strong><label id="confirmar_RFC"></label></p>
