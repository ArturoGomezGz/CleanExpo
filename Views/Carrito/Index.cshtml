                                    + '      <p class="mb-0"><strong>Precio Expo: </strong> <font class="font_moneda">' + FormatoMoneda(value.precioFinal) + '</font> </p>'
                                    + '      <p class="mb-0"><strong>Total: </strong> <font class="font_moneda">' + FormatoMoneda(value.total) + '</font> </p>'
                                    + '  </div>'
                                    + '</div>'
                                    + '<hr /> '
                        }   
                        else
                        {     
                                cadena += '<div class="row">'
                                    + '  <div class="col-md-2 col-sm-55">'
                                    + '      <a href="#" style=" margin: auto;">'

                                    + '      </a>'
                                    + '  </div>'
                                    + '  <div class="col-md-2 col-sm-55">'
                                    + '      <a href="#" style=" margin: auto;">'
                                    + '          <img src="' + path + 'Imagenes/noimage.png" alt="image" class="imagen_pedido">'
                                    + '      </a>'
                                    + '  </div>'
                                    + '  <div class="col-md-4 col-sm-55">'
                                    + '      <p class="pb-0">  <a class="nombreProductoCarrito" href="#"> ' + value.nombre + ' </a></p>'
                                    + '      <p><label>' + value.presentacion + '</label></p>'
                                    + '  </div>'
                                    + '  <div class="col-md-4 col-sm-12">'
                                    + '      <p class="mb-0"><strong>Cantidad: </strong>' + value.cantidad + '</p>'
                                    + '      <p class="mb-0"><strong>Precio Expo: </strong> <font class="font_moneda">' + FormatoMoneda(value.precioFinal) + '</font> </p>'
                                    + '      <p class="mb-0"><strong>Total: </strong> <font class="font_moneda">' + FormatoMoneda(value.total) + '</font> </p>'
                                    + '  </div>'
