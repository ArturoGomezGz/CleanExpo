                                    + '<hr /> '
                        }
                    }
                    else 
                    {
                        PedidoEx = value.idPedido;
                        cadena += '<hr class="Separador_Carrito"/><h6 class="lblPedido">Pedido: ' + PedidoEx + '</h6>'
                        +'<div class="row">'
                            + '  <div class="col-md-2 col-sm-55">'
                            + '      <a href="#" style=" margin: auto;">'
                            + '          <img src="' + path + 'Imagenes/noimage.png" alt="image" class="imagen_pedido">'
                            + '      </a>'
                            + '  </div>'
                            + '  <div class="col-md-2 col-sm-55">'
                            + '    <p class="pb-0">  <a href="#" style=" margin: auto;">'
                            + '          <img src="' + path + 'Imagenes/noimage.png" alt="image" class="imagen_pedido">'
                            + '      </a></p>'
                            + '  </div>'
                            + '  <div class="col-md-4 col-sm-55">'
                            + '      <a class="nombreProductoCarrito" href="#"> ' + value.nombre + ' </a>'
