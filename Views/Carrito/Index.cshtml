<div class="row">
    <div id="liveAlertPlaceholder"></div>
    @Html.HiddenFor(m => m.IdUsuario)
    <div class="col-xxl-1"></div>
    <div class="col-12 col-xxl-10 cart-container cart-container--fixed cart-container--fixed-in" data-id="cart_container1">
        <ul class="bf-ui-tab-container" data-js="tab-container" data-id="tab-container1" role="tablist">
            <li id="liCarrito" data-js="tab" role="tab" aria-selected="true" aria-controls="tab_active" data-id="tab_active" onclick="panel_active(1)" aria-label="Carrito (1)" class="bf-ui-tab bf-ui-tab--selected">
                <span data-js="rich-text" aria-hidden="true" class="bf-ui-rich-text cantidad_carrito">Carrito (@Model.CantidadCarrito)</span>
