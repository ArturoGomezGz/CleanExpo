    <div class="modal-dialog  modal-lg">
        <div class="modal-content">
            <div class="modal-header pb-1 pt-2">
                <h5 class="" id="swModalLabel">Coloca Tu Orden</h5>

                <div class="float-end text-muted ms-5">
                    Pasos: <span id="sw-current-step"></span> De <span id="sw-total-step"></span>
                </div>

                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pt-0 pb-0">
                <!-- SmartWizard html -->
                <div id="smartwizard">
                    <ul class="nav nav-progress">
                        <li class="nav-item" >
                            <a class="nav-link"  href="#">
                                <div class="num">1</div>
                                Tipo de Comprobante
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">
                                <span class="num">2</span>
                                Datos de Entrega
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">
