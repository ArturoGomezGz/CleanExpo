                                @Html.LabelFor(m => m.Entrega, new { @class = "fw-bold" })
                                @Html.DropDownListFor(model => model.Entrega, new SelectList(Model.Direccciones, "IdEntrega", "Entrega"), new { id = "cmb-Entrega", @class = "form-control text-left colocaOrdenDropDown", name = "cmb-Entrega",  title="cmb"})
                            </div>
                            <div class="col-12 pb-1">
                                @Html.LabelFor(m => m.IdTransporte, new { @class = "fw-bold" })
                                @Html.DropDownListFor(model => model.IdTransporte, new SelectList(Model.Trasportes, "IdTrasporte", "Transporte"), new { id = "colocar_Transportista", @class = "form-control text-left colocaOrdenDropDown", name = "colocar_Transportista",  title="cmb"})
