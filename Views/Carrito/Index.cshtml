@model Carrito
<link href="https://cdn.jsdelivr.net/npm/smartwizard@6/dist/css/smart_wizard_all.min.css" rel="stylesheet" type="text/css" />
<script src="https://cdn.jsdelivr.net/npm/smartwizard@6/dist/js/jquery.smartWizard.min.js" type="text/javascript"></script>
<script type="text/javascript" src="~/js/jquery.paginate.js"></script>
<script>
    function panel_active(active)
    {
        if (active == 2) 
        {
            var element = document.getElementById("divCarrito");
            element.classList.remove("display_panel_active");
            element.classList.add('display_panel');

            var element1 = document.getElementById("divPedido");
            element1.classList.remove("display_panel");
            element1.classList.add('display_panel_active');

            var element2 = document.getElementById("liPedido");
            element2.classList.remove("bf-ui-tab--unselected");
            element2.classList.add('bf-ui-tab--selected');

            var element3 = document.getElementById("liCarrito");
            element3.classList.remove("bf-ui-tab--selected");
            element3.classList.add('bf-ui-tab--unselected');

        }
        else
        {
            var element = document.getElementById("divPedido");
            element.classList.remove("display_panel_active");
            element.classList.add('display_panel');

            var element1 = document.getElementById("divCarrito");
            element1.classList.remove("display_panel");
            element1.classList.add('display_panel_active');

            var element2 = document.getElementById("liCarrito");
            element2.classList.remove("bf-ui-tab--unselected");
            element2.classList.add('bf-ui-tab--selected');

            var element3 = document.getElementById("liPedido");
            element3.classList.remove("bf-ui-tab--selected");
            element3.classList.add('bf-ui-tab--unselected');
        }
    }

    function Edit(IdProducto)
    {
        $(".decrement_" + IdProducto).removeClass("d-none")
        $(".increment_" + IdProducto).removeClass("d-none")
        $(".save_" + IdProducto).removeClass("d-none")
        $(".cancel_" + IdProducto).removeClass("d-none")
        $(".edit_" + IdProducto).addClass('d-none');
        $(".delete_" + IdProducto).addClass('d-none');

        var element = document.getElementById("number_" + IdProducto)
        element.removeAttribute("disabled");
    }

    function cancel(IdProducto)
    {
        $(".decrement_" + IdProducto).addClass("d-none")
        $(".increment_" + IdProducto).addClass("d-none")
        $(".save_" + IdProducto).addClass("d-none")
        $(".cancel_" + IdProducto).addClass("d-none")
        $(".edit_" + IdProducto).removeClass('d-none');
        $(".delete_" + IdProducto).removeClass('d-none');

        var hiddenInputValue = $("#hdn_" + IdProducto).val()
        var element = document.getElementById("number_" + IdProducto)
        element.setAttribute("disabled", "");
        element.value = hiddenInputValue
    }

    function Delete(IdProducto)
    {
        let Cliente = @Model.IdCliente;
        var block = $('<div class="block-loading container" />');
        $("#divCarrito").prepend(block);
        $.post(path + "Carrito/ProductoDelete",
            {
                idproducto: IdProducto,
                cliente: Cliente
            },
            function (data) {
                ShowAlert(data.message, data.response)
                window.location.reload()
            }).error(function () {
                block.remove();
                ShowAlert("No fue posible cargar sus datos", false);
            });
    }

    function save(IdProducto)
    {
        let LimiteTiempo = 2000;
        let Cliente = @Model.IdCliente;
        let Cantidad = $("#number_" + IdProducto).val();
        let PrecioMR = $("#hdnPrecioFinal_" + IdProducto).val()
        var block = $('<div class="block-loading container" />');
        $("#divCarrito").prepend(block);
        var TotalCantidadSeleccionada = parseInt(Cantidad);
        if (Number.isInteger(TotalCantidadSeleccionada) && TotalCantidadSeleccionada > 0) {
            if(TotalCantidadSeleccionada==0){
                ShowAlert("No es una cantidad valida para ingresar", false);
                setTimeout(function() {
                    window.location.reload();
                }, LimiteTiempo);
                return;
            }
            $.post(path + "Carrito/AddCotizacion",
                {
                    cliente: Cliente,
                    idProducto: IdProducto,
                    unitario: PrecioMR,
                    cantidad: TotalCantidadSeleccionada
                },
                function (data) {
                    ShowAlert(data.message, data.response)
                    GetCarrito();
                    //GetMonedas();
                    $("#hdn_" + IdProducto).val(TotalCantidadSeleccionada)
                    cancel(IdProducto)
                    window.location.reload()
                })
                .error(function () {
                    block.remove();
                    ShowAlert("No fue posible cargar sus datos", false);
                });
        }
        else
        {
            ShowAlert("No es una cantidad valida para ingresar", false);
            setTimeout(function() {
                window.location.reload();
            }, LimiteTiempo);
        }
    }

    function mostrarModal(IdArticulo)
    {
        $("#datail_modal_Articulo").html("")
        cadena = "";
        $.post(path + "Carrito/GetArticuloGanado",
            {
                IdArticulo: IdArticulo
            },
            function (data) {
                cadena += '<img class="promocion_imagen_modal mx-auto pb-3" alt="imagen" src="data:image/png;base64,' + data.foto + '">'
                    + '<label class="promocion_label">'
                    +  data.nombre
                    + '</label>'

                $("#datail_modal_Articulo").append(cadena)
            })
            .error(function () {
                ShowAlert("No fue posible cargar sus datos", false);
            });
    }

    function onFinish() { alert('Finish Clicked'); }

    function onCancel()
    {
        $('#smartwizard').smartWizard("reset");
        var block = $('<div class="block-loading" />');
        $(".modal-content").prepend(block);
        window.location.reload()
    }

    function ColocarOrden()
    {
        $.post(path + "Carrito/Validarcolocar",
            {
                IdCliente: @Model.IdCliente,
                IdUsuario: @Model.IdCliente
                },
            function (data) {
                if (data.response) {
                    switch (data.result) {
                        case 0:
                            ShowAlert("Revisa si tienes productos confirmados en tu carrito", false)
                            break;

                        case 1:
                            ShowAlert("Revisa si tienes crédito suficiente", false)
                            break;

                        case 2:
                            $('#smartwizard').smartWizard("reset");
                            OpenModal('swModal')
                            break;
                    }
                }
                else {
                    ShowAlert(data.message, false)
                }
            })
            .error(function () {
                ShowAlert("No fue posible cargar sus datos", false)
            });
    }

    function provideContent(idx, stepDirection, stepPosition, selStep, callback) {
        switch (idx) {
            case 1:
                $.ajax({
                    method: "POST",
                    url: path + "Carrito/GetDatosTransporte",
                    data:
                    {
                        IdCliente: @Model.IdCliente,
                        IdUsuario: @Model.IdCliente,
                        IdDocumento: $("#cmb-TipoDoc").val(),
                        IdUsoCFDI: $("#cmb-UsosCFDI").val()
                    },
                    beforeSend: function (xhr) {
                        $('#smartwizard').smartWizard("loader", "show");
                    }
                }).done(function (res) {
                    if (res.response) {
                        $("#cmb-Entrega").val(res.result[0].entrega)
                        $("#cmb-TipoVenta").val(res.result[0].idTipoVenta)
                    }
                    ChangeTipoVenta(res.result[0].idTipoVenta.toString())
                    $('#smartwizard').smartWizard("loader", "hide");
                }).fail(function (err) {
                    $('#smartwizard').smartWizard("loader", "hide");
                });
                break;
            case 2:
                var NextBoton = document.getElementById("next-btn-modal")
                //NextBoton.classList.add('d-none');
                $.ajax({
                    method: "POST",
                    url: path + "Carrito/GetSumary",
                    data:
                    {
                        IdCliente: @Model.IdCliente,
                        IdUsuario: @Model.IdCliente,
                        IdTipoVenta: $("#cmb-TipoVenta").val(),
                        IdTransporte: $("#colocar_Transportista").val(),
                        IdPorte: $("#colocar_Porte").val(),
                        IdDireccion: $("#cmb-Entrega").val(),
                        Obsv: $("#obsv").val()
                    },
                    beforeSend: function (xhr) {
                        $('#smartwizard').smartWizard("loader", "show");
                    }
                }).done(function (res) {
                    if (res.response) {
                        $("#confirmar_Cliente").html(res.result[0].cliente)
                        $("#confirmar_RFC").html(res.result[0].rfc)
                        $("#confirmar_TipoComprobante").html(res.result[0].documento)
                        $("#confirmar_CFDI").html(res.result[0].usoCFDI)
                        $("#confirmar_TipoEnvio").html(res.result[0].tipoVenta)
                        $("#confirmar_Entrega").html(res.result[0].dirEntrega)
                        $("#confirmar_Observaciones").html(res.result[0].obsv)
                        $("#confirmar_Transtportista").html(res.result[0].transportista)
                        $("#confirmar_Porte").html(res.result[0].porte)
                    }
                    $('#smartwizard').smartWizard("loader", "hide");
                }).fail(function (err) {
                    $('#smartwizard').smartWizard("loader", "hide");
                });
                break;
            default:
                $.ajax({
                    method: "POST",
                    url: path + "Carrito/GetDatosFacturacion",
                    data: {
                        IdCliente: @Model.IdCliente
                        },
                    beforeSend: function (xhr) {
                        $('#smartwizard').smartWizard("loader", "show");
                    }
                }).done(function (res) {
                    if (res.response) {
                        $("#colocar_Cliente").html(res.result[0].cliente)
                        $("#colocar_RFC").html(res.result[0].rfc)
                        $("#cmb-TipoDoc").val(res.result[0].idDocumento)
                        $("#cmb-UsosCFDI").val(res.result[0].idUsoCFDI)
                        habilitarBoton(res.result[0].idDocumento, res.result[0].idUsoCFDI)
                        ChangeTipoDocumento(res.result[0].idDocumento.toString())
                    }
                    $('#smartwizard').smartWizard("loader", "hide");
                }).fail(function (err) {
                    $('#smartwizard').smartWizard("loader", "hide");
                });
                break;
        }
        // The callback must called in any case to procced the steps
        // The empty callback will not apply any dynamic contents to the steps
        callback();
    }

    function TerminarOrden()
    {
        if( $("#confirmar_CFDI").html() === ""){
            ShowAlert("El usuario no tiene un Uso de CFDI asignado", false, "ModalStep3");
        }else{
            $.post(path + "Carrito/ExpoPedidoAgregar",
                function (data) {
                    
                    //Animacion de monedas
                    if (data.response) 
                    {
                        CloseModal('swModal');
                        ShowAlert(data.message, true);
                        SendMail(data.result);
                        initCanvas();
                        setTimeout(displayAnimationxy, 1000, window.innerWidth / 2, window.innerHeight / 2);
                        setTimeout(Reload, 3000);
                    }else{
                        ShowAlert(data.message, false, "ModalStep3");
                    }
                    
                }
            ).error(function () {
                ShowAlert("No fue posible cargar sus datos", false);
            });
        }        
    }

