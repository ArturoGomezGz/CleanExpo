<div class="col-md-12">
    <div id="liveAlertPlaceholder"></div>
    @Html.HiddenFor(m => m.IdUsuario)
    <div class="cart-container cart-container--fixed cart-container--fixed-in" data-id="cart_container1">
        <ul class="bf-ui-tab-container" data-js="tab-container" data-id="tab-container1" role="tablist">
            <li id="liCarrito" data-js="tab" role="tab" aria-selected="true" aria-controls="tab_active" data-id="tab_active" onclick="panel_active(1)" aria-label="Carrito (1)" class="bf-ui-tab bf-ui-tab--selected">
                <span data-js="rich-text" aria-hidden="true" class="bf-ui-rich-text cantidad_carrito">Carrito (@Model.CantidadCarrito)</span>
            </li>
            <li id="liPedido" data-js="tab" role="tab" aria-selected="false" aria-controls="tab_saved_for_later" onclick="panel_active(2)" data-id="tab_saved_for_later" aria-label="Guardados (0)" class="bf-ui-tab bf-ui-tab--unselected">
                <span data-js="rich-text" aria-hidden="true" class="bf-ui-rich-text">Pedidos</span>
            </li>
        </ul>
    </div>

    <div id="divCarrito" class="row display_panel_active">
        <p><a class="btn btn-index" asp-controller="CargarProducto" asp-action="Index">Carga Masiva</a></p>
        <div class="tab-content_productos col-md-8 col-sm-6">
            @{
                int IdProveedor = 0;
                List<ListaCarrito> ListCarrito = ExpoMR.Controllers.CarritoController.GetCarrito(Model.IdCliente, Model.IdCliente);
                if (ListCarrito.Count() > 0)
                {
                    foreach (ExpoMR.Models.ListaCarrito model in ListCarrito)
                    {
                        @if (model.Proveedor != IdProveedor)
                        {
                            <hr class="Separador_Carrito" />
                        }
                        <div class="row">
                            <div class="col-md-1">
                                <input type="checkbox">
                            </div>
                            <div class="col-md-2 col-sm-55">
                                @if (model.Proveedor != IdProveedor)
                                {
                                    <a href="~/Stand/Editar?idProveedor=@string.Format(model.Proveedor.ToString())" style=" margin: auto;">
                                        <img src="@String.Format("data:image/jpg;base64,{0}", Convert.ToBase64String(ExpoMR.Controllers.CarritoController.GetLogoProveedor("logo",model.Proveedor)))" alt="image" class="imagenCarrito">
                                    </a>
                                    IdProveedor = model.Proveedor;
                                }
                            </div>
                            <div class="col-md-2 col-sm-55">
                                @if (model.imgProducto.Length > 0)
                                {
                                    <a href="~/Producto/Index?idProducto=@string.Format(model.IdProducto.ToString())&Idproveedor=@string.Format(model.Proveedor.ToString())" style=" margin: auto;">
                                        <img src="@String.Format("data:image/jpg;base64,{0}", Convert.ToBase64String(model.imgProducto))" alt="image" class="imagenCarrito">
                                    </a>
                                }
                                else
                                {
                                    <a href="~/Producto/Index?idProducto=@string.Format(model.IdProducto.ToString())" style=" margin: auto;">
                                        <img src="~/Imagenes/noimage.png" alt="image" class="imagenCarrito">
                                    </a>
                                }
                            </div>
                            <div class="col-md-5 col-sm-55 texto-carrito">
                                <a class="nombreProductoCarrito" href="~/Producto/Index?idProducto=@string.Format(model.IdProducto.ToString())&Idproveedor=@string.Format(model.Proveedor.ToString())">
                                    @String.Format(model.Nombre)
                                </a>
                                <p class="mb-0"><label>@string.Format(model.Presentacion.ToString())</label></p>
                                <p class="mb-0"><strong>Cantidad: </strong>@string.Format(model.cantidad.ToString())</p>
                                <input id="hdnPrecioFinal_@string.Format(model.IdProducto.ToString())" type="hidden" value="@string.Format(model.PrecioFinal.ToString())">
                                <p class="mb-0"><strong>Precio Expo: </strong>$ @string.Format(model.PrecioFinal.ToString())</p>
                                <p class="mb-0"><strong>Total: </strong>$ @string.Format(model.total.ToString())</p>
                            </div>
                            <div class="col-md-2 col-sm-12">
                                <div class="row" style="">
                                    <div class="col-md-12 col-sm-55">
                                        <input id="hdn_@string.Format(model.IdProducto.ToString())" type="hidden" value="@string.Format(model.cantidad.ToString())">
                                        <input id="number_@string.Format(model.IdProducto.ToString())" class="input-number" type="number" value="@string.Format(model.cantidad.ToString())" min="1" placeholder="0" disabled>
                                    </div>
                                    <div class="col-md-12 col-sm-55 m-auto">
                                        <button class="btn btn-naranja-ch edit_@string.Format(model.IdProducto.ToString())" onclick="Edit(@string.Format(model.IdProducto.ToString()))" title="editar" type="button"><i class="fa fa-pencil-square-o" aria-hidden="true"></i></button>
                                        <button class="btn btn-rojo-ch delete_@string.Format(model.IdProducto.ToString())" onclick="Delete(@string.Format(model.IdProducto.ToString()))" title="eliminar" type="button"><i class="fa fa-trash" aria-hidden="true"></i></button>
                                        <button type="button" class="btn btn-outline-success save_@string.Format(model.IdProducto.ToString()) d-none" onclick="save(@string.Format(model.IdProducto.ToString()))" title="btn-save">
                                            <i class="fa fa-check" aria-hidden="true"></i>
                                        </button>
                                        <button type="button" class="btn btn-outline-danger cancel_@string.Format(model.IdProducto.ToString()) d-none" onclick="cancel(@string.Format(model.IdProducto.ToString()))" title="btn-cancel">
                                            <i class="fa fa-ban" aria-hidden="true"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <hr />
                    }
                }
                else
                {
                    <h5> No Hay Productos en tu carrito</h5>
                }
            }
        </div>
        <div class="tab-content_total col-md-4 col-sm-6">
            <div class="contenedor carritoTotal">
                @if (Model.HasProduct == true)
                {
                    <p><strong>Crédito: </strong><text id="txt_Credito"></text></p>
                    <p><strong>Subtotal: </strong><text id="txt_Subtotal"></text></p>
                    <p><strong>IVA: </strong><text id="txt_IVA"></text></p>
                    <p><strong>Total: </strong><text id="txt_Total"></text></p>
                    <button type="button" class="btn btn-naranja mb-3 mt-3" onclick="ColocarOrden()">Coloca tu Orden <i class="fa fa-chevron-circle-right"></i> </button>
                }
                else
                {
                    <h5>No hay Productos en el Carrito</h5>
                }
                <div id="liveAlertPlaceholderPedidos"></div>
            </div>
            <div class="promocion">
                <img class="promocion_imagen" alt="" src="~/Imagenes/promocionesHeader.png">
                <label class="promocion_label">
                    No olvides revisar los artículos que ganaste al finalizar tu pedido
                </label>
            </div>
        </div>
    </div>
    <div id="divPedido" class="row display_panel">
        <div class="col-md-3 mb-3">
            @Html.LabelFor(m => m.IdPedido, new { @class = "fw-bold" })
            @Html.DropDownListFor(model => model.IdPedido, new SelectList(Model.PedidosCliente, "IdPedido", "Pedido"), new { id = "cmb-pedidos", @class = "form-control text-left", name = "cmb-pedidos",  title="cmb"})
        </div>
        <div id="alert_Pedido" class="col-md-12"></div>
        <div id="Show_Pedidos" class="col-md-6"></div>
        <div id="show_premios" class="col-md-6">
            <div class="contenedor carritoTotal">
                @if (Model.HasProduct == true)
                {
                    <p class="credito_show">Crédito: <text id="txt_Credito_divPedido"></text></p>
                    <p><strong>Subtotal: </strong><text id="txt_Subtotal_divPedido"></text></p>
                    <p><strong>IVA: </strong><text id="txt_IVA_divPedido"></text></p>
                    <p><strong>Total: </strong><text id="txt_Total_divPedido"></text></p>
                }
                else
                {
                    <h5>No hay Productos en el Carrito</h5>
                }

                <div id="liveAlertPlaceholderPedidos"></div>
            </div>
            <div class="row promocion">
                <img class="promocion_imagen mx-auto" alt="" src="~/Imagenes/articulosGanados.png">
            </div>
            <div id="lista_premios" class="row"></div>
            <table id="Premios_table" class="display" style="width:70%"></table>
        </div>
    </div>
</div>
<div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="exampleModalLabel">Articulo Ganado</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="datail_modal_Articulo" class="row"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success" data-bs-dismiss="modal">Aceptar</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Colocar Orden-->
<div class="modal fade" id="swModal" tabindex="-1" aria-labelledby="swModalLabel" aria-hidden="true">
    <div class="modal-dialog  modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="" id="swModalLabel">Coloca Tu Orden</h5>

                <div class="float-end text-muted ms-5">
                    Pasos: <span id="sw-current-step"></span> De <span id="sw-total-step"></span>
                </div>

                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- SmartWizard html -->
                <div id="smartwizard">
                    <ul class="nav nav-progress">
                        <li class="nav-item" >
                            <a class="nav-link" href="#">
                                <div class="num">1</div>
                                Tipo de Comprobante
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">
                                <span class="num">2</span>
                                Datos de Entrega
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">
                                <span class="num">3</span>
                                Revisa y confirma tu Orden
                            </a>
                        </li>                                
                    </ul>
                    <div class="tab-content">
                        <div id="step-1" class="tab-pane" role="tabpanel" aria-labelledby="step-1">
                            <h4>Paso 1</h4>
                            <p class="mb-0"><strong>Cliente: </strong><label id="colocar_Cliente"></label></p>
                            <p class="mb-0"><strong>RFC: </strong><label id="colocar_RFC"></label></p>
                            <div class="col-12 pb-2">
                                @Html.LabelFor(m => m.IdTipoDoc, new { @class = "fw-bold" })
                                @Html.DropDownListFor(model => model.IdTipoDoc, new SelectList(Model.TipoDocumentos, "IdTipoDoc", "TipoDoc"), new { id = "cmb-TipoDoc", @class = "form-control text-left", name = "cmb-TipoDoc",  title="cmb"})
                            </div>
                            <div class="col-12 pb-2">
                                @Html.LabelFor(m => m.IdUsoCFDI, new { @class = "fw-bold" })
                                @Html.DropDownListFor(model => model.IdUsoCFDI, new SelectList(Model.UsoCFDI, "IdUsoCFDI", "UsoCFDI"), new { id = "cmb-UsosCFDI", @class = "form-control text-left", name = "cmb-UsosCFDI",  title="cmb"})
                            </div>
                        </div>
                        <div id="step-2" class="tab-pane" role="tabpanel" aria-labelledby="step-2">
                            <h4>Paso 2</h4>
                            <div class="col-12 pb-2">
                                @Html.LabelFor(m => m.IdTipoVenta, new { @class = "fw-bold" })
                                @Html.DropDownListFor(model => model.IdTipoVenta, new SelectList(Model.TiposVenta, "IdTipoVenta", "TipoVenta"), new { id = "cmb-TipoVenta", @class = "form-control text-left", name = "cmb-TipoVenta",  title="cmb"})
                            </div>
                            <div class="col-12 pb-2">
                                @Html.LabelFor(m => m.Entrega, new { @class = "fw-bold" })
                                @Html.DropDownListFor(model => model.Entrega, new SelectList(Model.Direccciones, "IdEntrega", "Entrega"), new { id = "cmb-Entrega", @class = "form-control text-left", name = "cmb-Entrega",  title="cmb"})
                            </div>
                            <p class="mb-0"><strong>Transportista: </strong><select id="colocar_Transportista"></select></p>
                            <p class="mb-0"><strong>Porte: </strong><select id="colocar_Porte"></select></p>
                            <p class="mb-0"><strong>Observaciones: </strong><input id="obsv" type="text" placeholder="Obsevaciones" class="form-control"/></p>
                        </div>
                        <div id="step-3" class="tab-pane" role="tabpanel" aria-labelledby="step-3">
                            <h4>Paso 3</h4>
                            <p class="mb-0"><strong>Cliente: </strong><label id="confirmar_Cliente"></label></p>
                            <p class="mb-0"><strong>RFC: </strong><label id="confirmar_RFC"></label></p>
                            <p class="mb-0"><strong>Tipo de Comprobante:  </strong><label id="confirmar_TipoComprobante"></label></p>
                            <p class="mb-0"><strong>Uso del CFDI: </strong><label id="confirmar_CFDI"></label></p>
                            <p class="mb-0"><strong>Tipo de Envío: </strong><label id="confirmar_TipoEnvio"></label></p>
                            <p class="mb-0"><strong>Dirección de Entrega: </strong><label id="confirmar_Entrega"></label></p>
                            <p class="mb-0"><strong>Observaciones: </strong><label id="confirmar_Observaciones"></label></p>
                            <p class="mb-0"><strong>Transportista: </strong><label id="confirmar_Transtportista"></label></p>
                            <p class="mb-0"><strong>Porte: </strong><label id="confirmar_Porte"></label></p>    
                            <div style="text-align:center">
                                <button type="button" onclick="TerminarOrden()" class="btn btn-naranja mb-3 mt-3">Colocar tu Orden <i class="fa fa-chevron-circle-right"></i> </button>
                            </div>
                        </div>                                
                    </div>
                    <div class="progress">
                        <div class="progress-bar" role="progressbar" style="width: 33%" aria-valuenow="33" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-azul-medio d-none" id="prev-btn-modal"><i class="fa fa-chevron-circle-left"></i> Anterior</button>
                <button class="btn btn-azul-medio" id="next-btn-modal" disabled>Siguiente <i class="fa fa-chevron-circle-right"></i></button>
                <button class="btn btn-rojo" onclick="onCancel()">Cancelar</button>
            </div>
        </div>
    </div>
</div>

