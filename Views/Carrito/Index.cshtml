@model Carrito
<link href="https://cdn.jsdelivr.net/npm/smartwizard@6/dist/css/smart_wizard_all.min.css" rel="stylesheet" type="text/css" />
<script src="https://cdn.jsdelivr.net/npm/smartwizard@6/dist/js/jquery.smartWizard.min.js" type="text/javascript"></script>
<script>
    function panel_active(active) {
        if (active == 2) {
            var element = document.getElementById("divCarrito");
            element.classList.remove("display_panel_active");
            element.classList.add('display_panel');

            var element1 = document.getElementById("divPedido");
            element1.classList.remove("display_panel");
            element1.classList.add('display_panel_active');

            var element2 = document.getElementById("liPedido");
            element2.classList.remove("bf-ui-tab--unselected");
            element2.classList.add('bf-ui-tab--selected');

            var element3 = document.getElementById("liCarrito");
            element3.classList.remove("bf-ui-tab--selected");
            element3.classList.add('bf-ui-tab--unselected');

        }
        else {
            var element = document.getElementById("divPedido");
            element.classList.remove("display_panel_active");
            element.classList.add('display_panel');

            var element1 = document.getElementById("divCarrito");
            element1.classList.remove("display_panel");
            element1.classList.add('display_panel_active');

            var element2 = document.getElementById("liCarrito");
            element2.classList.remove("bf-ui-tab--unselected");
            element2.classList.add('bf-ui-tab--selected');

            var element3 = document.getElementById("liPedido");
            element3.classList.remove("bf-ui-tab--selected");
            element3.classList.add('bf-ui-tab--unselected');
        }
    }

    function Edit(IdProducto) {
        $(".decrement_" + IdProducto).removeClass("d-none")
        $(".increment_" + IdProducto).removeClass("d-none")
        $(".save_" + IdProducto).removeClass("d-none")
        $(".cancel_" + IdProducto).removeClass("d-none")
        $(".edit_" + IdProducto).addClass('d-none');
        $(".delete_" + IdProducto).addClass('d-none');

        var element = document.getElementById("number_" + IdProducto)
        element.removeAttribute("disabled");
    }

    function cancel(IdProducto) {
        $(".decrement_" + IdProducto).addClass("d-none")
        $(".increment_" + IdProducto).addClass("d-none")
        $(".save_" + IdProducto).addClass("d-none")
        $(".cancel_" + IdProducto).addClass("d-none")
        $(".edit_" + IdProducto).removeClass('d-none');
        $(".delete_" + IdProducto).removeClass('d-none');

        var hiddenInputValue = $("#hdn_" + IdProducto).val()
        var element = document.getElementById("number_" + IdProducto)
        element.setAttribute("disabled", "");
        element.value = hiddenInputValue
    }

    function Delete(IdProducto) {
        let Cliente = @Model.IdCliente;
        var block = $('<div class="block-loading container" />');
        $("#divCarrito").prepend(block);
        $.post(path + "Carrito/ProductoDelete",
            {
                idproducto: IdProducto,
                cliente: Cliente
            },
            function (data) {
                ShowAlert(data.message, data.response)
                window.location.reload()
            }).error(function () {
                block.remove();
                ShowAlert("No fue posible cargar sus datos", false);
            });
    }

    function save(IdProducto) {
        let Cliente = @Model.IdCliente;
        let Cantidad = $("#number_" + IdProducto).val();
        let PrecioMR = $("#hdnPrecioFinal_" + IdProducto).val()

        var block = $('<div class="block-loading container" />');
        $("#divCarrito").prepend(block);

        if (Cantidad > 0) {
            $.post(path + "Carrito/AddCotizacion",
                {
                    cliente: Cliente,
                    idProducto: IdProducto,
                    unitario: PrecioMR,
                    cantidad: Cantidad
                },
                function (data) {
                    ShowAlert(data.message, data.response)
                    GetCarrito();
                    GetMonedas();
                    $("#hdn_" + IdProducto).val(Cantidad)
                    cancel(IdProducto)
                    window.location.reload()
                })
                .error(function () {
                    block.remove();
                    ShowAlert("No fue posible cargar sus datos", false);
                });
        }
        else {
            ShowAlert("La Cantidad debe ser mayor a Cero", false);
        }
    }

    function decrement(IdProducto) {
        var value = $("#number_" + IdProducto).val();
        var element = document.getElementById("number_" + IdProducto)
        value--;
        element.value = value;
    }

    function increment(IdProducto) {
        var value = $("#number_" + IdProducto).val();
        var element = document.getElementById("number_" + IdProducto)
        value++;
        element.value = value;
    }

    function mostrarModal(IdArticulo) {
        $("#datail_modal_Articulo").html("")
        cadena = "";
        $.post(path + "Carrito/GetArticuloGanado",
            {
                IdArticulo: IdArticulo
            },
            function (data) {
                cadena += '<img class="promocion_imagen mx-auto pb-3" alt="imagen" src="data:image/png;base64,' + data.foto + '">'
                    + '<label class="promocion_label">'
                    +  data.nombre
                    + '</label>'

                $("#datail_modal_Articulo").append(cadena)
            })
            .error(function () {
                ShowAlert("No fue posible cargar sus datos", false);
            });
    }

    function onFinish() { alert('Finish Clicked'); }

    function onCancel() {
        $('#smartwizard').smartWizard("reset");
        var block = $('<div class="block-loading" />');
        $(".modal-content").prepend(block);
        window.location.reload()
    }

    function ColocarOrden() {
        $.post(path + "Carrito/Validarcolocar",
            {
                IdCliente: @Model.IdCliente,
                IdUsuario: @Model.IdCliente
                },
            function (data) {
                if (data.response) {
                    switch (data.result) {
                        case 0:
                            ShowAlert("Revisa si tienes productos confirmados en tu carrito", false)
                            break;

                        case 1:
                            ShowAlert("Revisa si tienes crédito suficiente", false)
                            break;

                        case 2:
                            $('#smartwizard').smartWizard("reset");
                            OpenModal('swModal')
                            break;
                    }
                }
                else {
                    ShowAlert(data.message, false)
                }
            })
            .error(function () {
                ShowAlert("No fue posible cargar sus datos", false)
            });
    }

    function provideContent(idx, stepDirection, stepPosition, selStep, callback) {
        switch (idx) {
            case 1:
                $.ajax({
                    method: "POST",
                    url: path + "Carrito/GetDatosTransporte",
                    data:
                    {
                        IdCliente: @Model.IdCliente,
                        IdUsuario: @Model.IdCliente,
                        IdDocumento: $("#cmb-TipoDoc").val(),
                        IdUsoCFDI: $("#cmb-UsosCFDI").val()
                    },
                    beforeSend: function (xhr) {
                        $('#smartwizard').smartWizard("loader", "show");
                    }
                }).done(function (res) {
                    if (res.response) {
                        $("#cmb-Entrega").val(res.result[0].entrega)
                        $("#cmb-TipoVenta").val(res.result[0].idTipoVenta)
                    }
                    ChangeTipoVenta(res.result[0].idTipoVenta.toString())
                    $('#smartwizard').smartWizard("loader", "hide");
                }).fail(function (err) {
                    $('#smartwizard').smartWizard("loader", "hide");
                });
                break;
            case 2:
                var NextBoton = document.getElementById("next-btn-modal")
                NextBoton.classList.add('d-none');
                $.ajax({
                    method: "POST",
                    url: path + "Carrito/GetSumary",
                    data:
                    {
                        IdCliente: @Model.IdCliente,
                        IdUsuario: @Model.IdCliente,
                        IdTipoVenta: $("#cmb-TipoVenta").val(),
                        IdTransporte: $("#colocar_Transportista").val(),
                        IdPorte: $("#colocar_Porte").val(),
                        IdDireccion: $("#cmb-Entrega").val(),
                        Obsv: $("#obsv").val()
                    },
                    beforeSend: function (xhr) {
                        $('#smartwizard').smartWizard("loader", "show");
                    }
                }).done(function (res) {
                    if (res.response) {
                        $("#confirmar_Cliente").html(res.result[0].cliente)
                        $("#confirmar_RFC").html(res.result[0].rfc)
                        $("#confirmar_TipoComprobante").html(res.result[0].documento)
                        $("#confirmar_CFDI").html(res.result[0].usoCFDI)
                        $("#confirmar_TipoEnvio").html(res.result[0].tipoVenta)
                        $("#confirmar_Entrega").html(res.result[0].dirEntrega)
                        $("#confirmar_Observaciones").html(res.result[0].obsv)
                        $("#confirmar_Transtportista").html(res.result[0].transportista)
                        $("#confirmar_Porte").html(res.result[0].porte)
                    }
                    $('#smartwizard').smartWizard("loader", "hide");
                }).fail(function (err) {
                    $('#smartwizard').smartWizard("loader", "hide");
                });
                break;
            default:
                $.ajax({
                    method: "POST",
                    url: path + "Carrito/GetDatosFacturacion",
                    data: {
                        IdCliente: @Model.IdCliente
                        },
                    beforeSend: function (xhr) {
                        $('#smartwizard').smartWizard("loader", "show");
                    }
                }).done(function (res) {
                    if (res.response) {
                        $("#colocar_Cliente").html(res.result[0].cliente)
                        $("#colocar_RFC").html(res.result[0].rfc)
                        $("#cmb-TipoDoc").val(res.result[0].idDocumento)
                        $("#cmb-UsosCFDI").val(res.result[0].idUsoCFDI)
                        habilitarBoton(res.result[0].idDocumento, res.result[0].idUsoCFDI)
                        ChangeTipoDocumento(res.result[0].idDocumento.toString())
                    }
                    $('#smartwizard').smartWizard("loader", "hide");
                }).fail(function (err) {
                    $('#smartwizard').smartWizard("loader", "hide");
                });
                break;
        }
        // The callback must called in any case to procced the steps
        // The empty callback will not apply any dynamic contents to the steps
        callback();
    }

    function TerminarOrden() {
        $.post(path + "Carrito/ExpoPedidoAgregar",
            function (data) {
                CloseModal('swModal');
                ShowAlert(data.message, true);
                SendMail(data.result);
                    
                //Animacion de monedas
                if (data.response) 
                {
                    initCanvas();
                    setTimeout(displayAnimationxy, 1000, window.innerWidth / 2, window.innerHeight / 2);
                }
                setTimeout(Reload, 3000);
            }
        ).error(function () {
            ShowAlert("No fue posible cargar sus datos", false);
        });
    }

    function Reload() {
        window.location.reload();
    }

    function habilitarBoton(Documento, CFDI) {
        if (Documento === 1) {
            if (CFDI != 0 || CFDI != 23) {
                var element = document.getElementById("next-btn-modal")
                element.removeAttribute("disabled");
                var tipoDoc = document.getElementById("cmb-TipoDoc")
                tipoDoc.removeAttribute("disabled");
            }
        }
    }

    function ChangeTipoDocumento(tipoDocumento) {
        var NextBoton = document.getElementById("next-btn-modal")
        var cmbCFDI = document.getElementById("cmb-UsosCFDI")

        switch (tipoDocumento) {
            case "0":
                NextBoton.setAttribute("disabled", "");
                cmbCFDI.setAttribute("disabled", "");
                break;
            case "1":
                NextBoton.removeAttribute("disabled");
                $.post(path + "Carrito/GetDatosFacturacion",
                {
                    IdCliente: @Model.IdCliente
                },
                function (data) {
                   cmbCFDI.value = data.result[0].idUsoCFDI
                })
                .error(function () {
                    ShowAlert("No fue posible cargar tu usoCFDI", false);
                });
                cmbCFDI.removeAttribute("disabled");
                break;
            case "2":
                NextBoton.removeAttribute("disabled");
                cmbCFDI.value = "23"
                cmbCFDI.setAttribute("disabled", "");
                break;
        }
    }

    function ChangeTipoCFDI(usoCFDI) {
        var NextBoton = document.getElementById("next-btn-modal")
        var tipoDoc = document.getElementById("cmb-TipoDoc")
        switch (usoCFDI) {
            case "23":
                NextBoton.setAttribute("disabled", "");
                break;
            case "0":
                NextBoton.setAttribute("disabled", "");
                break;
            default:
                NextBoton.removeAttribute("disabled");
                break;
        }
    }

    function ChangeTipoVenta(TipoVenta) {
        var NextBoton = document.getElementById("next-btn-modal")
        var cmbEntrega = document.getElementById("cmb-Entrega")
        var transportista = document.getElementById("colocar_Transportista")
        var Porte = document.getElementById("colocar_Porte")
        switch (TipoVenta) {
            case "0":
                NextBoton.setAttribute("disabled", "");
                break;
            case "1":
                cmbEntrega.classList.add('d-none');
                transportista.classList.add('d-none');
                Porte.classList.add('d-none');
                break;
            case "2":
                cmbEntrega.classList.remove('d-none');
                transportista.classList.remove('d-none');
                Porte.classList.remove('d-none');
                break;
            case "3":
                cmbEntrega.classList.remove('d-none');
                transportista.classList.add('d-none');
                Porte.classList.add('d-none');
                break;
            case "4":
                cmbEntrega.classList.remove('d-none');
                transportista.classList.add('d-none');
                Porte.classList.add('d-none');
                break;
        }
    }

    function seleccionarTodos() {
        var inputs = document.querySelectorAll('input[id^="chkSel"]');

        for (i = 0; i < inputs.length; i++) {
            $.post(path + "Carrito/PorConfirmar",
                {
                    IdProducto: inputs[i].value,
                    Cliente: @Model.IdCliente,
                    Confirmado: 1 //Confirma todos los productos
                });

            inputs.checked = true;
        }

        window.location.reload()
    }

    function deseleccionarTodos() {
        var inputs = document.querySelectorAll('input[id^="chkSel"]');

        for (i = 0; i < inputs.length; i++) {
            $.post(path + "Carrito/PorConfirmar",
                {
                    IdProducto: inputs[i].value,
                    Cliente: @Model.IdCliente,
                    Confirmado: 2 //Desconfirma todos los productos
                });

            inputs.checked = false;
        }

        window.location.reload()
    }

    function Checked(IdProducto) {
        let Cliente = @Model.IdCliente;

        $.post(path + "Carrito/PorConfirmar",
            {
                IdProducto: IdProducto,
                Cliente: Cliente,
                Confirmado: 3 //Confirma o Desconfirma un producto especifico
            },
            function () {
                window.location.reload()
            })
            .error(function () {
                block.remove();
                ShowAlert("No fue posible cargar sus datos", false);
            });
    }

    $(document).ready(function () 
    {
        $("#txt_Credito").html(FormatoMoneda(@Model.TotalesCotizacion.Credito))
        $("#txt_Subtotal").html(FormatoMoneda(@Model.TotalesCotizacion.Subtotal))
        $("#txt_IVA").html(FormatoMoneda(@Model.TotalesCotizacion.IVA))
        $("#txt_Total").html(FormatoMoneda(@Model.TotalesCotizacion.Total))
        $("#txt_TotalProd").html(@Model.TotalesCotizacion.Productos)

        $("#cmb-pedidos").change(function () {
            FiltroPedido($(this).val())            
        });

        $("#cmb-TipoDoc").change(function () {
            ChangeTipoDocumento(this.value)
        });

        $("#cmb-UsosCFDI").change(function () {
            ChangeTipoCFDI(this.value)
        });

        $("#cmb-TipoVenta").change(function () {
            ChangeTipoVenta(this.value)
        })

        $.post(path + "Carrito/GetPremios",
            {
                IdCliente: @Model.IdCliente
                },
            function (data) {
                if (data.response) {
                    $('#Premios_table').DataTable({
                         bFilter: false,
                        lengthChange: false,
                        responsive: true,
                        "info":false,
                        "language":{"url": "//cdn.datatables.net/plug-ins/1.10.16/i18n/Spanish.json"},
                        "columns":[
                                { "data": "proveedor", title: "Proveedor" },
                                { "data": "cantidad", title: "Cant" },
                                { "data": "nombre", title: "Nombre" },
                                {
                                    "data": "idArticulo", title: "Ver más",
                                    render: function (data, type) {
                                        if (type === 'display') {
                                            return '<button type="button" class="btn"  title="datos" onClick="mostrarModal(' + data + ')" data-bs-toggle="modal" data-bs-target="#exampleModal"><i class="fa fa-ellipsis-h"></i> </button>';
                                        }
                                        return data;
                                    },
                                }
                        ],
                        data: data.result
                    });
                }
                else {
                    ShowAlert(data.message, data.false, "lista_premios")
                }

            }).error(function () {
                ShowAlert("No fue posible cargar sus datos", false)
            }
            );

        $("#smartwizard").on("showStep", function (e, anchorObject, stepIndex, stepDirection, stepPosition) {
            $("#prev-btn").removeClass('disabled').prop('disabled', false);
            $("#next-btn").removeClass('disabled').prop('disabled', false);
            if (stepPosition === 'first') {
                $("#prev-btn").addClass('disabled').prop('disabled', true);
            }
            else if (stepPosition === 'last') {
                $("#next-btn").addClass('disabled').prop('disabled', true);
            }
            else {
                $("#prev-btn").removeClass('disabled').prop('disabled', false);
                $("#next-btn").removeClass('disabled').prop('disabled', false);
            }

            // Get step info from Smart Wizard
            let stepInfo = $('#smartwizard').smartWizard("getStepInfo");
            $("#sw-current-step").text(stepInfo.currentStep + 1);
            $("#sw-total-step").text(stepInfo.totalSteps);
        });

        // Smart Wizard
        $('#smartwizard').smartWizard(
            {
                selected: 0,
                // autoAdjustHeight: false,
                theme: 'arrows', // basic, arrows, square, round, dots
                transition:
                {
                    animation: 'none'
                },
                toolbar:
                {
                    showNextButton: true, // show/hide a Next button
                    showPreviousButton: true, // show/hide a Previous button
                    position: 'none' // none/ top/ both bottom
                },
                anchor:
                {
                    enableNavigation: true, // Enable/Disable anchor navigation
                    enableNavigationAlways: false, // Activates all anchors clickable always
                    enableDoneState: true, // Add done state on visited steps
                    markPreviousStepsAsDone: true, // When a step selected by url hash, all previous steps are marked done
                    unDoneOnBackNavigation: false, // While navigate back, done state will be cleared
                    enableDoneStateNavigation: true // Enable/Disable the done state navigation
                },
                disabledSteps: [], // Array Steps disabled
                errorSteps: [], // Highlight step with errors
                hiddenSteps: [],
                getContent: provideContent
            });

        $("#prev-btn-modal").on("click", function () {
            // Navigate previous
            $('#smartwizard').smartWizard("prev");
            return true;
        });

        $("#next-btn-modal").on("click", function () {
            // Navigate next
            $('#smartwizard').smartWizard("next");
            return true;
        });

        srcImg() //se cargaran las imagenes de logos de proveedores y fotos de productos en las secciones de Cotizacion y Pedidos
    })

    function FiltroPedido(NumPedido){
        var divsPedido = $("#Show_Pedidos").children();

        $.each(divsPedido, function (index, value) {
            if ('Pedido_'+ NumPedido == value.id || NumPedido === "0" )
            {
                $(value).show();
            }
            else
            {
                $(value).hide();
            }
        });
    }

    function srcImg()
    {
        var logosProv = document.querySelectorAll('img.LogoProv');  //Se obtienen todos los controles que muestran el logo de proveedor mendiante la Clase
        logosProv = removeDuplicatesIds(logosProv);

        for (var i = 0; i < logosProv.length; i++)
        {
            var proveedorId = logosProv[i].getAttribute("data-id");
            GetAsyncLogoProv(proveedorId) 
        }
        

        var fotosProd = document.querySelectorAll('img.FotoProd'); //Se obtienen todos los controles que muestran la foto de producto mendiante la Clase
        fotosProd = removeDuplicatesIds(fotosProd);

        for (var i = 0; i < fotosProd.length; i++)
        {
            var productoId = fotosProd[i].getAttribute("data-id");
            GetAsyncFotoProd(productoId) 
        }
    }

    async function GetAsyncLogoProv(proveedorId)
    {
        try 
        {
            const response = await fetch(`/imagenes/GetLogoProveedor?IdProveedor=${proveedorId}`);
            
            if (!response.ok) 
            {
                throw new Error('Ocurrió un error al hacer la solicitud.');
            }

            const data = await response.text() // Suponiendo que el controlador devuelve texto

            var logosproveedor = document.querySelectorAll('#LogoProv_' + proveedorId);  //Se obtienen todos los controles que muestran el logo de proveedor mendiante su Id

            if (data.length > 0) 
            {
                $.each(logosproveedor, function (index, values) {
                    values.src = "data:image/png;base64," + data;
                });
            }                
            else
            { 
                $.each(logosproveedor, function (index, values) {
                    values.src = "../Imagenes/noimage.png";
                });
            }
                
        } 
        catch (error) 
        {
            $.each(logosproveedor, function (index, values) {
                values.src = "../Imagenes/noimage.png";
            });
        }
    }

    async function GetAsyncFotoProd(productoId)
    {
        try 
        {
            const response = await fetch(`/imagenes/GetFotoProducto?IdProducto=${productoId}`);
            
            if (!response.ok) 
            {
                throw new Error('Ocurrió un error al hacer la solicitud.');
            }

            const data = await response.text() // Suponiendo que el controlador devuelve texto

            var fotosProd = document.querySelectorAll('#FotoProd_' + productoId);  //Se obtienen todos los controles que muestran la foto de producto mendiante su Id

            if (data.length > 0) 
            {
                $.each(fotosProd, function (index, values) {
                    values.src = "data:image/png;base64," + data;
                });
            }                
            else
            { 
                $.each(fotosProd, function (index, values) {
                    values.src = "../Imagenes/noimage.png";
                });
            }                
        } 
        catch (error) 
        {
            $.each(fotosProd, function (index, values) {
                values.src = "../Imagenes/noimage.png";
            });
        }
    }

    function removeDuplicatesIds(array) 
    {
        // Crear un objeto para realizar un seguimiento de los IDs que ya han sido encontrados
        const idsEncontrados = {};

        // Convertir la NodeList a un array para facilitar el manejo
        const arrayDeElementos = Array.from(array);

        // Filtrar el array para eliminar elementos con IDs duplicados
        const elementosSinDuplicados = arrayDeElementos.filter(array => {
            const id = array.id;
            if (!idsEncontrados[id]) {
                // Si el ID no ha sido encontrado aún, lo marcamos como encontrado
                idsEncontrados[id] = true;
                return true; // Mantener este elemento en el array resultante
            }
            return false; // Descartar este elemento del array resultante
        });

        return elementosSinDuplicados;
    }

</script>

