    function FiltroPedido(NumPedido)
    {
        var divsPedido = $("#Show_Pedidos").children();

        $.each(divsPedido, function (index, value) {
            if ('Pedido_'+ NumPedido == value.id || NumPedido === "0" || value.classList[0] == "pagination__controls")
            {   
                $(value).show();
            }
            else
            {
                $(value).hide();
            }
        });
    }

    function srcImg()
    {
        var logosProv = document.querySelectorAll('img.LogoProv');  //Se obtienen todos los controles que muestran el logo de proveedor mendiante la Clase
        logosProv = removeDuplicatesIds(logosProv);

        for (var i = 0; i < logosProv.length; i++)
        {
            var proveedorId = logosProv[i].getAttribute("data-id");
            GetAsyncLogoProv(proveedorId) 
        }
        
        var fotosProd = document.querySelectorAll('img.FotoProd'); //Se obtienen todos los controles que muestran la foto de producto mendiante la Clase
        fotosProd = removeDuplicatesIds(fotosProd);        
    }

    async function GetAsyncLogoProv(proveedorId)
    {
        try 
        {
            const response = await fetch(`/imagenes/GetLogoProveedor?IdProveedor=${proveedorId}`);
            
            if (!response.ok) 
            {
                throw new Error('Ocurrió un error al hacer la solicitud.');
            }

            const data = await response.text() // Suponiendo que el controlador devuelve texto

            var logosproveedor = document.querySelectorAll('#LogoProv_' + proveedorId);  //Se obtienen todos los controles que muestran el logo de proveedor mendiante su Id

            if (data.length > 0) 
            {
                $.each(logosproveedor, function (index, values) {
                    values.src = "data:image/png;base64," + data;
                });
            }                
            else
            { 
                $.each(logosproveedor, function (index, values) {
                    values.src = "../Imagenes/noimage.png";
                });
            }
                
        } 
        catch (error) 
        {
            $.each(logosproveedor, function (index, values) {
                values.src = "../Imagenes/noimage.png";
            });
        }
    }

    async function GetAsyncFotoProd(productoId)
    {
        try 
        {
            const response = await fetch(`/imagenes/GetFotoProducto?IdProducto=${productoId}`);
            
            if (!response.ok) 
            {
                throw new Error('Ocurrió un error al hacer la solicitud.');
            }

            const data = await response.text() // Suponiendo que el controlador devuelve texto

            var fotosProd = document.querySelectorAll('#FotoProd_' + productoId);  //Se obtienen todos los controles que muestran la foto de producto mendiante su Id

            if (data.length > 0) 
            {
                $.each(fotosProd, function (index, values) {
                    values.src = "data:image/png;base64," + data;
                });
            }                
            else
            { 
                $.each(fotosProd, function (index, values) {
                    values.src = "../Imagenes/noimage.png";
                });
            }                
        } 
        catch (error) 
        {
            $.each(fotosProd, function (index, values) {
                values.src = "../Imagenes/noimage.png";
            });
        }
    }

    function removeDuplicatesIds(array) 
    {
        // Crear un objeto para realizar un seguimiento de los IDs que ya han sido encontrados
        const idsEncontrados = {};

        // Convertir la NodeList a un array para facilitar el manejo
        const arrayDeElementos = Array.from(array);

        // Filtrar el array para eliminar elementos con IDs duplicados
        const elementosSinDuplicados = arrayDeElementos.filter(array => {
            const id = array.id;
            if (!idsEncontrados[id]) {
                // Si el ID no ha sido encontrado aún, lo marcamos como encontrado
                idsEncontrados[id] = true;
                return true; // Mantener este elemento en el array resultante
            }
            return false; // Descartar este elemento del array resultante
        });

        return elementosSinDuplicados;
    }

</script>

