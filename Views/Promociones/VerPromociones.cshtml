<h4 class="text-center">Estas son las promociones que haz capturado</h4>

<div class="d-flex justify-content-around mt-4">
    <div class="col-md-2 mt-4">
        <h4 class="text-center"> Por Visita de Cliente </h4>
        <div class="row text-center" id="PromoVisita">
        </div>
    </div>
    <div class="col-md-2 mt-4">
        <h4 class="text-center"> Acumulable </h4>
        <div class="row text-center" id="PromoAcumulable">
        </div>
    </div>
    <div class="col-md-2 mt-4">
        <h4 class="text-center"> No Acumulable </h4>
        <div class="row text-center" id="PromoNoAcumulable">
        </div>
    </div>
    <div class="col-md-2 mt-4">
        <h4 class="text-center"> Escalonada </h4>
        <div class="row text-center" id="PromoEscalonada">
        </div>
    </div>
</div>
<div class="row mt-4">
    <hr />
</div>
<h4 class="text-center">Estas son las promociones que haz capturado</h4>
<div class="col-md-6 m-auto">
    <table id="tblArticulosRestantes" class="display" style="width:100%">
        <thead>
            <tr>
                <th> Articulo </th>
                <th> Cantidad </th>
            </tr>
        </thead>
        <tbody>
        </tbody>
    </table>
</div>

<script>
    $(document).ready(function ()
    {
        var PromoAcumulable = document.getElementById('PromoAcumulable');
        var PromoNoAcumulable = document.getElementById('PromoNoAcumulable');
        var PromoEscalonada = document.getElementById('PromoEscalonada');
        var PromoVisita = document.getElementById('PromoVisita');

        getPromo(1, PromoVisita);
        getPromo(2, PromoAcumulable);
        getPromo(3, PromoNoAcumulable);
        getPromo(4, PromoEscalonada);

        GetArticulosRestantes();
    });

    function getPromo(tipoPromo, divPromo)
    {
        $.ajax({
            url: path + "Promociones/GetPromo?tipoPromo=" + tipoPromo,
            type: 'POST',
            success: function (response)
            {
                response.forEach(element => 
                {
                    creaCartaPromo(element, divPromo);
                });
            },
            error: function ()
            {
                alert('Error al subir la imagen');
            }
        });
    }

    function creaCartaPromo(elemento, div)
    {
        const promocionDiv = document.createElement("div");
        promocionDiv.id = 'divPromo' + elemento.idPromocion;
        promocionDiv.classList.add('card');
        promocionDiv.classList.add('border-primary');
        promocionDiv.classList.add('m-2');
        promocionDiv.classList.add('p-2');

        AgregaClientePromo(elemento.cliente, promocionDiv);

        if (elemento.tipoPromo != 1)
            AgregaDescPromo(elemento.producto, elemento.piezas, elemento.monto, promocionDiv);
        
        AgregaArticulosPromo(elemento.articulos, promocionDiv);
        AgregaBotonesPromo(elemento.activa, elemento.idPromocion, promocionDiv);

        div.appendChild(promocionDiv);
    }

    function AgregaClientePromo(cliente, promocionDiv)
    {
        const promoCliente = document.createElement("div");
        if (cliente != null)
        {
            promoCliente.innerHTML = '<strong> Promoción para: </strong>'
                + '<p> ' + cliente + '<p>';
        }
        else 
        {
            promoCliente.innerHTML = '<strong> Promoción para: </strong>'
                + '<p> Todos los Clientes <p>';
        }

        promocionDiv.appendChild(promoCliente);
    }

    function AgregaDescPromo(producto, piezas, monto, promocionDiv)
    {
        const promoCondicion = document.createElement("div");
        if (producto != null)
        {
            if (piezas > 0)
            {
                promoCondicion.innerHTML = '<strong> Descripción: </strong>'
                    + '<p> En la compra de ' + piezas + ' Piezas de ' + producto + ' <p> ';
            } 
            else 
            {
                promoCondicion.innerHTML = '<strong> Descripción: </strong>'
                    + '<p> En la compra de ' + monto + ' Pesos de ' + producto + ' <p> ';
            }
        } 
        else 
        {
            if (piezas > 0) 
            {
                promoCondicion.innerHTML = '<strong> Descripción: </strong>'
                    + '<p> En la compra de ' + piezas + ' Piezas de Todos los productos <p> ';
            }
            else 
            {
                promoCondicion.innerHTML = '<strong> Descripción: </strong>'
                    + '<p> En la compra de ' + monto + ' Pesos de Todos los productos <p> ';
            }
        }

        promocionDiv.appendChild(promoCondicion);
    }

    function AgregaArticulosPromo(articulos, promocionDiv)
    {
        const promoArticulos = document.createElement("div");
        promoArticulos.innerHTML = '<strong> Artículo(s) a regalar: </strong>'
             + articulos.map(articulo => '<p class="mb-0"> ' + articulo.cantidad + ' ' + articulo.nombre) + '<p>';
        promocionDiv.appendChild(promoArticulos);
    }

    function AgregaBotonesPromo(activa, idPromocion, promocionDiv)
    {
        const promoBotones = document.createElement("div");
        promoBotones.classList.add('d-flex');
        promoBotones.classList.add('justify-content-around');

        const botonActivar = document.createElement("button");
        botonActivar.classList.add('btn');
        botonActivar.id = 'btnActivar' + idPromocion;
        botonActivar.addEventListener("click", function()
        {
            CambiarStatus(idPromocion);
        });
        
        if (activa == 1)
        {
            botonActivar.classList.add('btn-success');
            botonActivar.innerHTML = 'Activa';
        }
        else
        {
            botonActivar.classList.add('btn-secondary');
            botonActivar.innerHTML = 'Inactiva';
        }

        promoBotones.appendChild(botonActivar);

        const botonEditar = document.createElement("button");
        botonEditar.id = 'btnEditar' + idPromocion;
        botonEditar.addEventListener("click", function ()
        {
            EditarPromo(idPromocion);
        });

        botonEditar.classList.add('btn');
        botonEditar.classList.add('fa');
        botonEditar.classList.add('fa-pencil');
        botonEditar.classList.add('btn-warning');
        promoBotones.appendChild(botonEditar);

        const botonEliminar = document.createElement("button");
        botonEliminar.id = 'btnEliminar' + idPromocion;
        botonEliminar.addEventListener("click", function () 
        {
            EliminaPromo(idPromocion);
        });

        botonEliminar.classList.add('btn');
        botonEliminar.classList.add('fa');
        botonEliminar.classList.add('fa-xmark');
        botonEliminar.classList.add('btn-danger');
        promoBotones.appendChild(botonEliminar);

        promocionDiv.appendChild(promoBotones);
    }

    function CambiarStatus(idPromocion)
    {
        $.ajax({
            url: path + "Promociones/ActivarPromocion?idPromocion=" + idPromocion,
            type: 'POST',
            success: function (response)
            {
                const boton = document.getElementById('btnActivar' +idPromocion);
                if (boton.innerHTML == 'Inactiva')
                {
                    boton.classList.add('btn-success');
                    boton.classList.remove('btn-secondary');
                    boton.innerHTML = 'Activa';
                }
                else
                {
                    boton.classList.remove('btn-success');
                    boton.classList.add('btn-secondary');
                    boton.innerHTML = 'Inactiva';
                }
            },
            error: function ()
            {
                alert('Error al subir la imagen');
            }
        });
    }

    function EliminaPromo(idPromocion)
    {
        $.ajax({
            url: path + "Promociones/EliminaPromocion?idPromocion=" + idPromocion,
            type: 'POST',
            success: function (response)
            {
                if(response == 1)
                {
                    const divPromo = document.getElementById('divPromo' + idPromocion);
                    divPromo.hidden = true;
                }
                else
                {
                    alert('La promocion no puede ser eliminada porque ya la obtuvieron clientes');
                }
                
            },
            error: function ()
            {
                alert('Error al subir la imagen');
            }
        });
    }

    function GetArticulosRestantes()
    {
        var tblArticulosRestantes = $('#tblArticulosRestantes').DataTable();
        tblArticulosRestantes.destroy();
        tblArticulosRestantes = $('#tblArticulosRestantes').DataTable({
            "language": 
            {
                "url": "//cdn.datatables.net/plug-ins/1.10.16/i18n/Spanish.json"
            },
            "ajax":
            {
                url: path + "Promociones/GetArticulosRestantes",
                type: 'POST',
                dataSrc: ""
            },
            "columns": 
            [
                { "data": "articulo" },
                { "data": "cantidadRestante" }
            ]
        });
    }

    function EditarPromo(idPromocion)
    {
        document.location = '@Url.Action("EditarPromociones")' + '?idPromocion=' + idPromocion;
    }

</script>