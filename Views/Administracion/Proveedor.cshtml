
@{
    ViewData["Title"] = "Proveedor";
}

<h1>Alta Proveedor</h1>
<div id="liveAlertPlaceholder"></div>
<div class="row fontsize">
    <div class="col-md-12">
        <table id="Proveedor" class="display " style="width:100%"></table>
    </div>
</div>

<script>
    $(document).ready(function () {
        $('#Proveedor').DataTable({
            order: [[1, 'asc']],
            responsive: true,
            "info": false,
            "language": {"url": "//cdn.datatables.net/plug-ins/1.10.16/i18n/Spanish.json"},
            "ajax": {
                url: path + "Administracion/GetProveedores",
                type: 'POST',
                dataSrc: ""
            },
            "columns": [
                {
                    "data": "idPersona",
                    orderable: false,
                    render: function (data, type, row) {                        
                        if (type === 'display' && row.alta == 1  ) {
                            return '<a href="' + path + 'Administracion/EditProveedor?IdProveedor=' + data + '" class="btn btn-link"><i class="fas fa-chevron-right" aria-hidden="true"></i></a>';
                        }else{
                            return ''
                        }
                        return data;
                    },
                },
                { "data": "nombre", title: "Nombre" },
                { "data": "descripcion", title: "Descripción" },
                {
                    "data": "alta",
                    title: "Alta",
                    render: function (data, type, row) {                           
                        if (data == 1) {
                            return '';
                        }
                        return '<button onClick="DarDeAlta(' + row.idPersona + ')" type="button" class="btn btn-outline-success"><i class="fas fa-plus" aria-hidden="true"></i></button>'
                    }
                }
            ]
        });
    });

    function DarDeAlta(IdPersona) {
        $.post(path + "Administracion/AddProveedor",
            {
                IdPersona: IdPersona
            },
            function (data) {
                if (data.response) {
                    var tabla = $('#Proveedor').DataTable();
                    tabla.ajax.reload();
                }
                ShowAlert(data.message, data.response);
            }).error(function () {
                ShowAlert("No fue posible cargar sus datos", false);
            });
    }
</script>
