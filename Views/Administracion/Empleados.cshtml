
@{
    ViewData["Title"] = "Empleados";
}

<h1>Empleados</h1>

<div class="row fontsize">
    <div class="col-md-12">
        <table id="Empleados" class="display " style="width:100%"></table>
    </div>
</div>

<script>
    $(document).ready(function () {
        $('#Empleados').DataTable({
            responsive: true,
            "info": false,
            "language": {"url": "//cdn.datatables.net/plug-ins/1.10.16/i18n/Spanish.json"},
            "ajax": {
                url: path + "Administracion/GetEmpleados",
                type: 'POST',
                dataSrc: ""
            },
            "columns": [
                {
                    "data": "idPersona",
                    orderable: false,
                    render: function (data, type) {
                        if (type === 'display') {
                            return '<a href="'+path+'Administracion/EditarEmpleado?IdPersona=' + data + '" class="btn btn-link"><i class="fa fa-chevron-right" aria-hidden="true"></i></a>';
                        }

                        return data;
                    },
                },
                {
                    "data": "nombre",
                    title: "Nombre"
                },
                {
                    "data": "email",
                    title: "Email"
                },
                {
                    "data": "rol",
                    title: "Rol"
                }
            ]
        });
    });
</script>