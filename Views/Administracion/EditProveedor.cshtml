@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@model EditarProveedorViewModel;
@{
    ViewData["Title"] = "EditProveedor";
}
<div id="liveAlertPlaceholder"></div>
<div class="row">
    <div class="col-12 col-md-5 col-xl-4 offset-xl-1 label__bold">
        <h3>Proveedor</h3>
        @Html.HiddenFor(m=>m.IdPersona)
        <div class="row">
            <div class="col-sm-12">                
                @Html.LabelFor(m => m.Nombre)
                @Html.TextBoxFor(m => m.Nombre, new {id="txt_box_Proveedor", @class = "form-control", name = "provedor",  title="Proveedor", disabled = "disabled"})
            </div>            
        </div>
        <div class="row">
            <div class="col-sm-12">
                @Html.LabelFor(m => m.Descripcion)
                @Html.TextAreaFor(m => m.Descripcion, new { @class = "form-control ", disabled="disabled" })
            </div>
        </div>
        <div class="row mt-2">	
			<div id="hiddenBTN" class="d-none col-sm-12">
                <div  class=" col-md-55 text-center">
                    <button type="button" class="btn btn-verde-medio" onclick="save()"> Aceptar </button>
                </div>
                <div class="col-md-55 text-center">
                    <button type="button" class="btn btn-rojo" onclick="cancel()"> Cancelar </button>
                </div>
            </div>            
        </div>
        <div class="row mt-2">
            <div class="col-md-55 text-center">
                <button id="btn-modificar" type="button" class="btn btn-naranja" style="display: inline-table;"> Editar </button>
            </div>
            <div class="col-md-55 text-center">
                <button id="btn-eliminar" type="button" class="btn btn-rojo" data-bs-toggle="modal" data-bs-target="#eliminarModal" style="display: inline-table;"> Eliminar </button>
             </div>
        </div>
        
        @*
        <div class="row">
            <div class="col-sm-12 col-md-6">
                @Html.LabelFor(m => m.Saldo)
                @Html.TextBoxFor(m => m.Saldo, new{ @type = "number", @min = "1", @class = "form-control ", disabled="disabled"})
            </div>
        </div>
        *@
        <div class="row">
            <div class="col-sm-12 col-md-6">                
                @Html.LabelFor(m => m.AsignarMonedas, new{id="label_asignar", @class="d-none"})
                @Html.TextBoxFor(m => m.AsignarMonedas, new{ @type = "number", @min = "1", @class = "form-control d-none"})
            </div>
            <div class="col-sm-12 col-md-6 p-4">
                <div id="hiddenBTNMonedas" class="d-none col-md-55 text-center">
                    <button type="button" class="btn btn-verde-medio" onclick="saveMonedas()"> Aceptar </button>
                    <br />
                    <button type="button" class="btn btn-rojo" onclick="cancelMonedas()"> Cancelar </button>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-7 col-xl-6 ml-2">
        <h3>Laboratorios</h3>
        <table id="Laboratorios" class="display " style="width:100%">
            <thead>
                <tr>
                    <th></th>
                    <th>Laboratorio</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
        <div class="row mt-2">
            <div class="col-md-55 text-center">
				<button id="btn-Agregar" type="button" class="btn btn-azul-medio" data-bs-toggle="modal" data-bs-target="#ListaLaboratoriosModal" style="display: inline-table;"> Agregar Laboratorio </button>
			</div>
            <div class="col-md-55 text-center">
				<button id="btn-AgregarProducto" type="button" class="btn btn-azul-medio" data-bs-toggle="modal" data-bs-target="#ListaProductosModal" style="display: inline-table;"> Agregar Producto </button>
            </div>
        </div>
    </div>
</div>
@*<div class="row">
    
    <div class="col-md-3">
         <button id="btn-AddMonedas" type="button" class="btn btn-azul" style="display: inline-table;"> Asignar Monedas </button> 
    </div>    
</div>
<br>*@
<div class="row">
    <div class="col-12 col-xl-10 offset-xl-1">
        <h3>Ofertas</h3>
        <table id="OfertasProveedor" class="display" style="width:100%">
        </table>
    </div>
</div>
<div class="row">
    <div class="col-md">
        <br />
        <a asp-controller="Administracion" asp-action="Proveedor" class="btn btn-azul" style="display: inline-table;"><i class="fas fa-arrow-left" aria-hidden="true"></i> Ir a Proveedores </a>
    </div>
</div>

<script>
    $(document).ready(function () {

        $("#btn-modificar").click(function () {
            removeclass() //se muestran y ocultan botones

            var element = document.getElementById("txt_box_Proveedor")
            element.removeAttribute("disabled");  //se habilita el textbox para editar

            var element1 = document.getElementById("Descripcion")
            element1.removeAttribute("disabled"); //se habilita el textbox para editar
        })
        
        $("#btn-AddMonedas").click(function () {
            removeclassMonedas()
        })
        
        $('#Laboratorios').DataTable({
            responsive: true,
            "info": false,
            pageLength: 5,
            "lengthMenu": [5, 10, 20],
            "language": {"url": "//cdn.datatables.net/plug-ins/1.10.16/i18n/Spanish.json"},
            "ajax": {
                url: path + "Administracion/GetLaboratorios?IdPersona=" + $("#IdPersona").val(),
                type: 'POST',
                dataSrc: ""
            },
            "columns": [
                {
                    "data": "idLaboratorio",
                    render: function (data, type) {
                        if (type === 'display') {
                            return '<button type="button" class="btn  btn-outline-danger" onclick="deleteLab(' + data + ')" title="btn-cancel">'
                                + ' <i class="fas fa-trash-alt" aria-hidden="true"></i>'
                                + ' </button>';
                        }
                        return data;
                    },
                },
                { "data": "laboratorio" }
            ]
        });
        
        $('#AddLaboratorios').DataTable({
            responsive: true,
            "info": false,
            pageLength: 5,
            "lengthMenu": [5, 10, 20],
            "language": {"url": "//cdn.datatables.net/plug-ins/1.10.16/i18n/Spanish.json"},
            "ajax": {
                url: path + "Administracion/GetAddLabs",
                type: 'POST',
                dataSrc: ""
            },
            "columns": [
                {
                    "data": "idLaboratorio",
                    render: function (data, type) {
                        if (type === 'display') {
                            return '<button type="button" class="btn  btn-outline-success" onclick="addLab(' + data + ')" title="btn-cancel">'
                                + ' <i class="fas fa-plus" aria-hidden="true"></i>'
                                + ' </button>';
                        }
                        return data;
                    },
                },
                { "data": "laboratorio" }
            ]
        });

        $('#AddProductos').DataTable({
            responsive: true,
            "info": false,
            pageLength: 5,
            "lengthMenu": [5, 10, 20],
            "language": {"url": "//cdn.datatables.net/plug-ins/1.10.16/i18n/Spanish.json"},
            "ajax": {
                url: path + "Administracion/GetAddProductosProv?IdProveedor=" + $("#IdPersona").val(),
                type: 'POST',
                dataSrc: ""
            },
            "columns": [
                {
                    "data": "idProducto",
                    render: function (data, type, row) {
                        if (type === 'display') {
                            return '<button type="button" class="btn  btn-outline-success" onclick="addProdProv(' + row.idProducto + ',' + row.idLaboratorio + ',' + (row.iva ? 1 : 0) + ')" title="btn-cancel">'
                                + ' <i class="fas fa-plus" aria-hidden="true"></i>'
                                + ' </button>';
                        }
                        return data;
                    },
                },
                { "data": "producto" }
            ],
            "order": [[1, "asc"]] // 1 = índice de la columna “producto”, “asc” = ascendente
        });

        DescuentosProveedorDt(); //Se realiza la carga de las ofertas del proveedor
    });

    //Al hacer clic en editar un descuento de proveedor
    $(document).on('click', '.editDescuento', function (event) 
    {
        event.preventDefault();

        var row = obtenerFilaPrincipal(this);
        var inputElement = row.find('.text');

        inputElement.prop('disabled', false);
        inputElement.focus();

        row.find(".acepteditdescuento").show();
        row.find(".canceleditdescuento").show();
        row.find(".editDescuento").hide();
    });

    //Al hacer clic en el cancelar de edicion de un descuento de proveedor
    $(document).on('click', '.canceleditdescuento', function (event)
    {
    event.preventDefault();

    var row = obtenerFilaPrincipal(this);
    var inputElement = row.find('.text');

    inputElement.prop('disabled', true);

    row.find(".acepteditdescuento").hide();
    row.find(".canceleditdescuento").hide();
    row.find(".editDescuento").show();

    var tabla = $('#OfertasProveedor').DataTable();
    tabla.ajax.reload(null, false);
    });

    //Al hacer clic en el aceptar de edicion de un descuento de proveedor
        $(document).on('click', '.acepteditdescuento', function (event) {
        event.preventDefault();

        var botonAceptar = $(this);
        var row = obtenerFilaPrincipal(this);

        var inputElement = row.find('.text');
        var idproducto = row.find('.hdfIdProducto').val();
        var DescProveedorNew = parseFloat(inputElement.val());

        if (isNaN(DescProveedorNew) || DescProveedorNew < 0) {
            alert("El descuento ingresado no puede ser menor que 0.");
            return;
        }

        botonAceptar.prop('disabled', true);

        $.post(
            path + "Administracion/ActualizaDescProv",
            {
                IdProducto: idproducto,
                DescProvNew: DescProveedorNew
            },
            function () {
                var tabla = $('#OfertasProveedor').DataTable();

                // Recarga sin destruir y crear nuevamente el DataTable.
                tabla.ajax.reload(null, false);
            }
        ).fail(function () {
            ShowAlert(
                "No fue posible actualizar el descuento del proveedor",
                false
            );

            botonAceptar.prop('disabled', false);
        });
    });

    function DescuentosProveedorDt()
    {
        $('#OfertasProveedor').DataTable({
            responsive: true,
            "info": false,
            pageLength: 5,
            "lengthMenu": [5, 10, 20],
            "language": {"url": "//cdn.datatables.net/plug-ins/1.10.16/i18n/Spanish.json"},
            "ajax": {
                url: path + "Administracion/GetOfertasProv?IdPersona=" + $("#IdPersona").val(),
                type: 'POST',
                dataSrc: ""
            },
            "columns": [
                {
                    data: "idProducto",
                    render: function (data, type, row)
                    {
                        if (@User.IsInRole("DescuentosProveedor").ToString().ToLower())
                        {
                            return '<input class="hdfIdProducto" type="hidden" value="' + data + '" style="display:none"/>'
                                + '<a class="btn btn-naranja-ch editDescuento" ><i class="fas fa-pencil-alt"></i></a>'
                                + '<a class="btn btn-outline-success acepteditdescuento" style="display:none"><i class="fas fa-check" aria-hidden="true"></i></a>'
                                + '<a class="btn btn-outline-danger canceleditdescuento" style="display:none"><i class="fas fa-ban" aria-hidden="true"></i></a>';
                        }
                        else
                        {
                            return ''
                        }  
                    }
                },
                { data: "producto", title: "Producto"},
                { data: "descuento", title: "Descuento",
                    render: function (data, type, row) {
                        if (type === 'display') {
                            return '<input name="Descuento" class="text" type="number" value="' + data + '" disabled style="width:70px; heigth:70px"/> %'
                        }

                        return data;
                    },
                },
                { data: "laboratorio", title: "Laboratorio" }
            ],
            order: [
                [3, 'asc'], // primero laboratorio
                [1, 'asc']  // luego producto
            ]
        });
    }


    function obtenerFilaPrincipal(control) 
    {
        var row = $(control).closest("tr");

        // En modo responsive, DataTables crea una fila secundaria "child".
        if (row.hasClass("child")) {
            row = row.prev("tr");
        }

        return row;
    }


    function save() {
        const nombre = $("#txt_box_Proveedor").val();
        const descripcion = $("#Descripcion").val()
        const IdPersona = $("#IdPersona").val()

        $.post(path + "Administracion/SaveProvedor",
            {
                nombre: nombre,
                descripcion: descripcion,
                IdPersona: IdPersona
            },
            function (data) {
                ShowAlert(data.message, data.response);
                cancel()
            }).error(function () {
                ShowAlert("No fue posible cargar sus datos", false);
            });
    }

    function cancel() {
        //se ocultan los botones
        $("#hiddenBTN").addClass('d-none');

        //Se muestran los botones
        $("#btn-modificar").removeClass("d-none")
        $("#btn-eliminar").removeClass('d-none');
        $("#btn-AddMonedas").removeClass('d-none');
        $("#btn-Agregar").removeClass('d-none');

        //se inhabilitan los textboxes para editar
        var element = document.getElementById("txt_box_Proveedor")
        element.setAttribute("disabled", "");

        var element1 = document.getElementById("Descripcion")
        element1.setAttribute("disabled", "");

        //Hace la recarga de la pagina
        window.location.reload();
    }

    function deleteProveedor() {
        const IdPersona = $("#IdPersona").val()
        
        $.post(path + "Administracion/DeleteProveedor",
            {
                IdPersona: IdPersona
            },
            function (data) {
                var myModalEl = document.getElementById('eliminarModal');
                var modal = bootstrap.Modal.getInstance(myModalEl)

                modal.hide()
                ShowAlert(data.message, data.response);

                if (data.response) {
                    window.location.href = '/Administracion/Proveedor';
                }
            }).error(function () {
                ShowAlert("No fue posible cargar sus datos", false);
            });
    } 

    function saveMonedas() {
        let IdPersona = $("#IdPersona").val()
        let monedas = $("#AsignarMonedas").val()

        if (monedas > 0) {
            $.post(path + "Administracion/SaveMonedas",
                {
                    IdPersona: IdPersona,
                    monedas: monedas
                },
                function (data) {

                    ShowAlert(data.message, data.response);
                    cancelMonedas()

                    if (data.response) {
                        //Hace la recarga de la pagina
                        window.location.reload();
                    }
                }).error(function () {
                    ShowAlert("No fue posible cargar sus datos", false);
                });
        } else {
            if (monedas === "") {
                ShowAlert("Dato Inválido", false)
            } else {
                ShowAlert("Ingresa una cantidad de monedas mayor a cero", false)
            }
        }
    }

    function cancelMonedas(){
        //se ocultan los botones
        $("#hiddenBTNMonedas").addClass('d-none');
        $("#label_asignar").addClass('d-none');
        $("#AsignarMonedas").addClass('d-none');

        //Inicializa el textbox en 0
        $("#AsignarMonedas").val(0);

        //Se muestran los botones
        $("#btn-AddMonedas").removeClass("d-none");
        $("#btn-modificar").removeClass('d-none');
        $("#btn-eliminar").removeClass('d-none');
        $("#btn-Agregar").removeClass('d-none');
    }

    function addLab(idLaboratorio){
        const IdPersona = $("#IdPersona").val()

        $.post(path + "Administracion/AddLab",
            {
                IdPersona: IdPersona,
                IdLaboratorio: idLaboratorio
            },
            function (data) {
                if(data.response){
                    var tabla = $('#AddLaboratorios').DataTable();
                    tabla.ajax.reload(); 
                    var tablalab = $('#Laboratorios').DataTable();
                    tablalab.ajax.reload();

                    //Se actualiza el numero de laboratorios asignados al proveedor
                    var element = document.getElementById("LaboratoriosAsignados");
                    element.setAttribute("placeholder", tablalab.rows().count() + 1);
                }                
            }).error(function () {
                ShowAlert("No fue posible cargar los Laboratorios", false);
            });
    }

    function addProdProv(idProducto, idLaboratorio, iva){
            const IdPersona = $("#IdPersona").val()

            $.post(path + "Administracion/AddProdProv",
                {
                    IdPersona: IdPersona,
                    idProducto: idProducto,
                    idLaboratorio: idLaboratorio,
                    iva: iva
                },
                function (data) {
                    if(data.response){
                        var tabla = $('#AddProductos').DataTable();
                        tabla.ajax.reload();
                        var tablalab = $('#OfertasProveedor').DataTable();
                        tablalab.ajax.reload();
                    }
                }).error(function () {
                    ShowAlert("No fue posible agregar el producto", false);
                });
        }

    function deleteLab(IdLaboratorio){
        $.post(path + "Administracion/DeleteLab",
            {
                idLaboratorio: IdLaboratorio
            },
            function (data) {
                if (data.response) {
                    var tabla = $('#AddLaboratorios').DataTable();
                    tabla.ajax.reload();
                    var tablalab = $('#Laboratorios').DataTable();
                    tablalab.ajax.reload();

                    //Se actualiza el numero de laboratorios asignados al proveedor
                    var element = document.getElementById("LaboratoriosAsignados");
                    element.setAttribute("placeholder", tablalab.rows().count() - 1);
                }else{
                    ShowAlert(data.message, data.response);
                }
            }).error(function () {
                ShowAlert("No fue posible cargar sus datos", false);
            });
    }

    function removeclass() {
        //se ocultan los botones
        $("#btn-modificar").addClass('d-none');
        $("#btn-eliminar").addClass('d-none');
        $("#btn-AddMonedas").addClass('d-none');
        $("#btn-Agregar").addClass('d-none');

        //Se muestran los botones
        $("#hiddenBTN").removeClass("d-none") 
    }

    function removeclassMonedas() {
        //se ocultan los botones
        $("#btn-AddMonedas").addClass('d-none');
        $("#btn-modificar").addClass('d-none');
        $("#btn-eliminar").addClass('d-none');
        $("#btn-Agregar").addClass('d-none');

        //Se muestran los botones
        $("#label_asignar").removeClass("d-none")
        $("#hiddenBTNMonedas").removeClass("d-none")
        $("#AsignarMonedas").removeClass("d-none")
    }
</script>

<!-- Modal -->
<div class="modal fade" id="eliminarModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <h3>Vas a eliminar al Proveedor:</h3>
                <label>@Model.Nombre</label>
                <h3>¿Estas seguro?</h3>
            </div>
            <div class="modal-footer">              
                <button type="button" onclick="deleteProveedor()" class="btn btn-verde-medio"> Aceptar </button>
                <button type="button" class="btn btn-rojo" data-bs-dismiss="modal"> Cancelar </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="ListaLaboratoriosModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="ModalLaboratorio">Asigna Laboratorios</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row label__bold">
                    <div class="col-12">
                        <div class="mb-3">
                            @Html.LabelFor(m => m.Nombre)
                            <input type="text" class="form-control" id="txt_box_Proveedor_modal" placeholder="@Model.Nombre" disabled>
                        </div>
                        <div class="mb-3">
                            <label for="LaboratoriosAsignados" class="form-label">Laboratorios Asignados: </label>
                            <input type="text" class="form-control" id="LaboratoriosAsignados" placeholder="@Model.NumLabAsignados" disabled>
                        </div>
                        <div class="mb-3">
                            <table id="AddLaboratorios" class="display " style="width:100%">
                                <thead>
                                    <tr>
                                        <th></th>
                                        <th>Laboratorio</th>
                                    </tr>
                                </thead>
                                <tbody>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>              
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-rojo" data-bs-dismiss="modal"> Salir </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="ListaProductosModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="ModalLaboratorio">Asigna Productos</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row label__bold">
                    <div class="col-12">
                        <div class="mb-3">
                            <table id="AddProductos" class="display " style="width:100%">
                                <thead>
                                    <tr>
                                        <th></th>
                                        <th>Producto</th>
                                    </tr>
                                </thead>
                                <tbody>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-rojo" data-bs-dismiss="modal"> Salir </button>
            </div>
        </div>
    </div>
</div>