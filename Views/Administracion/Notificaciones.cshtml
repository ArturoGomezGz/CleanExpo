@{
    ViewData["Title"] = "Notificaciones";
}

<h1>Clientes</h1>
<div id="liveAlertPlaceholder"></div>
<div class="row fontsize">
    <table id="clientes" class="display" cellspacing="0" width="100%"></table>
</div>
<div class="row">
    <div id="correo" class="col-md-3"><button type="button" id="SendPromos" onclick="SendPromos()" class="btn btn-azul btn-large"> Enviar <i class="fas fa-envelope" aria-hidden="true"></i></button></div>
</div>
<script>

     var tableClientes;

    $(document).ready(function () 
    {
        LoadTable() //Se llena la tabla       
    });

    function LoadTable() 
    {
        tableClientes = $('#clientes').DataTable({
            order: [[1, 'asc']],
            responsive: true,
            "info": false,
            "language": { "url": "//cdn.datatables.net/plug-ins/1.10.16/i18n/Spanish.json" },
            "ajax":
            {
                url: path + "Administracion/GetUsusariosNotificacion",
                type: 'POST',
                dataSrc: ""
            },
            "columns":[
                {
                    "data": null,
                    targets: 0,
                    orderable: false,
                    render: function (data, type, row, meta) {
                        return data = '<div class="checkbox"><input type="checkbox" id="chkSel_' + row.idEmail + '" class="dt-checkboxes chkSel" value="' + row.idEmail + '"></div>';
                    },
                    checkboxes: {
                        'selectRow': true
                    },
                },
                { "data": "idPersona", 
                    render: function (data, type) {
                        return '<input class="hdfIdPersona" type="hidden" value="' + data + '" style="display:none"/>'
                    }
                },
                { "data": "nombre", title: "Nombre" },
                { "data": "email", title: "Email" },
                { "data": "notificado", title: "Promociones",
                    render: function (data, type) {
                        if (data == 1) {
                            return '<img class="card-img-top" style=" width: 20px; height: 20px; margin: auto;" src="../Imagenes/AceptarGrid.png" alt="image" />'
                        }
                        return '';
                    },
                }
            ]
        });    
    }

    function Reload() 
    {
        $('#clientes').dataTable().fnDestroy();
        $('#clientes').html('')

        LoadTable()
    }

    function SendPromos() 
    {
        const cb = document.querySelectorAll('input[type="checkbox"].chkSel:checked'); //Se seleccionan todos los controles de tipo checkbox y su id= chkSel NO DEBE DE HABER ID´REPETIDOS POR ALGO SON ID

        if (cb.length < 1) 
        { //Se valida que debe existir al menos 1 checkbox seleccionado para el envio de invitacion
            alert('Debes selecionar un email para enviar invitacion')
        }
        else
        {
            $('input[type="checkbox"].chkSel:checked').each(function () {

                if ($(this).prop('checked') && $(this).val() > 0) {

                    const IdCliente = $(this).closest('tr').find('.hdfIdPersona').val();
                    const IdEmail = $(this).val();

                    $.post(path + "Notificaciones/SendPromos",
                        {
                            IdCliente: IdCliente,
                            IdEmail: IdEmail
                        },
                        function (data) {
                            ShowAlert(data.message, data.response);
                            Reload();

                        }).error(function () {
                            alerta(false, "No fue posible cargar sus datos");
                            Reload();
                        }
                    );
                };
            });
        }
    }

</script>