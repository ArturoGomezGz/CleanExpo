@{
    ViewData["Title"] = "Notificaciones";
}

<h1>Clientes</h1>
<div id="liveAlertPlaceholder"></div>
<div class="row">
    <table id="clientes" class="display" cellspacing="0" width="100%"></table>
</div>
<div class="row">
    <div id="correo" class="col-md-3"><button type="button" id="SendPromos" onclick="SendPromos()" class="btn btn-azul btn-large"> Enviar <i class="fa fa-envelope" aria-hidden="true"></i></button></div>
</div>
<script>

     var tableClientes;

    $(document).ready(function () 
    {
        LoadTable() //Se llena la tabla       
    });

    function LoadTable() 
    {
        tableClientes = $('#clientes').DataTable({
            responsive: true,
            "info": false,
            "language": { "url": "//cdn.datatables.net/plug-ins/1.10.16/i18n/Spanish.json" },
            "ajax":
            {
                url: path + "Administracion/GetUsusariosNotificacion",
                type: 'POST',
                dataSrc: ""
            },
            'columnDefs':
            [
                {
                    'targets': 0,
                    'checkboxes':
                    {
                        'selectRow': true
                    }
                }
            ],
            'select':
            {
                'style': 'multi'
            },
            "columns":[
                { "data": "idPersona"},
                { "data": "nombre", title: "Nombre" },
                { "data": "email", title: "Email" },
                { "data": "notificado", title: "Promociones" }
            ]
        });    
    }

    function GetSelected()
    {
        var checkedId = [];
        var selectedIds = tableClientes.columns().checkboxes.selected()[0];

        selectedIds.forEach(function (selectedId) {
            checkedId.push(selectedId);
        });

        return (checkedId)
    }

    function Reload() 
    {
        $('#clientes').dataTable().fnDestroy();
        $('#clientes').html('')

        LoadTable()
    }

    function SendPromos() 
    {
        let arrayIdPersonas = GetSelected()

        for (i = 0; i < arrayIdPersonas.length; i++)
        {
            var Cliente = arrayIdPersonas[i];

            $.post(path + "Notificaciones/SendPromos",
                {
                    IdCliente: Cliente
                },
                function (data)
                {
                    ShowAlert(data.message, data.response);
                    Reload();

                }).error(function ()
                {
                    alerta(false, "No fue posible cargar sus datos");
                    Reload();
                }
            );
        }        
    }

</script>