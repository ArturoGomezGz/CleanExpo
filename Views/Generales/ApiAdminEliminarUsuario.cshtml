@model ExpoMR.Models.ApiAdminPanelViewModel
@{
    ViewData["Title"] = "Eliminar usuario";
    Layout = "~/Views/Shared/_LayoutLogin.cshtml";
}

<div class="container py-4" style="max-width: 720px;">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h5 mb-0 text-danger">Eliminar usuario</h1>
        <a class="btn btn-link" asp-controller="Generales" asp-action="ApiAdminDashboard">Volver</a>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Mensaje))
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            @Model.Mensaje
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-danger">
        <div class="card-body">
            <form asp-controller="Generales" asp-action="ApiAdminPanelOperacion" method="post" class="row g-3">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Operacion" value="eliminar" />

                <div class="col-12">
                    <label class="form-label" for="correo">Correo</label>
                    <input id="correo" name="TargetEmail" class="form-control" placeholder="usuario@dominio.com" />
                </div>

                <div class="col-12 d-grid">
                    <button type="submit" class="btn btn-outline-danger" style="white-space: nowrap; min-width: 140px;">Eliminar</button>
                </div>
            </form>
        </div>
    </div>
</div>
