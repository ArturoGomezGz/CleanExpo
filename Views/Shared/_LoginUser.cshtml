@using Microsoft.AspNetCore.Identity
@using Newtonsoft.Json

@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager


@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item dropdown">
        <label class="usuario">@UserManager.GetUserName(User)</label>
        @using (Html.BeginForm("Submit", "Home", FormMethod.Post))
        {
            List<Clientes> ClientesSeleccion = ExpoMR.Controllers.GeneralesController.GetClientesSeleccion(@UserManager.GetUserName(User));

            <select id="ddlClientes">
                @foreach (ExpoMR.Models.Clientes Cllientes in ClientesSeleccion)
                {
                    var clienteJson = JsonConvert.SerializeObject(Cllientes);
                    <option value="@clienteJson">@Cllientes.Nombre</option>
                }
            </select>
        }
    </li>
    <li class="nav-item dropdown">
        <a class="usuario nav-link  dropbtn dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            Menu
        </a>
        <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
            @if (User.IsInRole("Cliente") || User.IsInRole("ClienteVIP"))
            {
                <li>
                    <a class="dropdown-item" asp-area="" asp-controller="MiCuenta" asp-action="Index">Cambiar Contraseña</a>
                </li>
                <li>
                    <a class="dropdown-item" asp-area="" asp-controller="MiCuenta" asp-action="MiCuenta">Mi Cuenta</a>
                </li>
                <li>
                    <hr class="dropdown-divider">
                </li>
            }
            @if (User.IsInRole("Vendedor") || User.IsInRole("Capturista"))
            {
                <li>
                    <a class="dropdown-item" asp-area="" asp-controller="Empleados" asp-action="Cotizacion"> Cotización</a>
                </li>
                <li>
                    <a class="dropdown-item" asp-area="" asp-controller="Empleados" asp-action="Pedidos"> Pedidos</a>
                </li>
                <li>
                    <hr class="dropdown-divider">
                </li>
            }
            @if (User.IsInRole("Administrador"))
            {
                <li>
                    <a class="dropdown-item" asp-area="" asp-controller="Administracion" asp-action="Usuarios"> Usuarios</a>
                </li>
                <li>
                    <a class="dropdown-item" asp-area="" asp-controller="Administracion" asp-action="Proveedor"> Proveedores</a>
                </li>
                <li>
                    <a class="dropdown-item" asp-area="" asp-controller="Administracion" asp-action="Notificaciones"> Notificaciones</a>
                </li>
                <li>
                    <a class="dropdown-item" asp-area="" asp-controller="Administracion" asp-action="Empleados"> Empleados</a>
                </li>            
            }
            @if (User.IsInRole("Proveedor"))
            {
                <li>
                    <a class="dropdown-item" asp-area="" asp-controller="MiCuenta" asp-action="Index">Cambiar Contraseña</a>
                </li>
                <li>
                    <hr class="dropdown-divider">
                </li>
                <li>
                    <a class="dropdown-item" asp-controller="Proveedores" asp-action="Anuncios"> Anuncios</a>
                </li>
                <li>
                    <a class="dropdown-item" asp-controller="Proveedores" asp-action="Articulos"> Artículos</a>
                </li>
@*                 <li>
                    <a class="dropdown-item" asp-controller="Proveedores" asp-action="Monedas"> Entregar Monedas</a>
                </li> *@
                <li>
                    <a class="dropdown-item" asp-controller="Configuracion" asp-action="Configuracion"> Configuración</a>
                </li>
                <li>
                    <a class="dropdown-item" asp-controller="Estadisticas" asp-action="Estadisticas"> Estadísticas</a>
                </li>
                <li>
                    <a class="dropdown-item" asp-controller="Proveedores" asp-action="Precios"> Precios Cliente</a>
                </li>
                <li>
                    <a class="dropdown-item" asp-controller="Promociones" asp-action="Promociones"> Promociones</a>
                </li>
                <li>
                    <a class="dropdown-item" asp-controller="Proveedores" asp-action="MiStand"> Mi Stand</a>
                </li>            
            }
        </ul>       
    </li>
}
else
{   
    <div class="profile_login">
        <a class="btn btn-verde" asp-controller="Cuentas" asp-action="Acceso">Acceder</a>
    </div>
}

<script type="text/javascript">
    $(window).on('load', function ()
    {
        var lasValue = sessionStorage.getItem('SelValue');

        SetClienteSel(lasValue);

        let element = document.getElementById("ddlClientes");

        for (var i = 0; i < element.options.length; i++) {
            var option = element.options[i];
            var clienteObjeto = JSON.parse(option.value);

            if (clienteObjeto.IdPersona == lasValue) {
                element.selectedIndex = i;

                //Asignacion de monedas por primer visita a la expo
                //AsignarMonedas();
                break;
            }
        }
    })


    $(document).ready(function ()
    {   
        var select = document.getElementById("ddlClientes");
        var lasValue = sessionStorage.getItem('SelValue');

        if (lasValue === "undefined" || lasValue == null || lasValue.length <= 0)
        {
            var clienteObjeto = JSON.parse(select.value);

            sessionStorage.setItem('SelValue', clienteObjeto.IdPersona);
            sessionStorage.setItem('SelTipoUsuario', clienteObjeto.IdTipoUsuario);
            sessionStorage.setItem('SelName', $('#ddlClientes option:selected').text());
        }

        select.addEventListener('change', function (e)
        {
            var clienteObjeto = JSON.parse(select.value);

            sessionStorage.setItem('SelValue', clienteObjeto.IdPersona);
            sessionStorage.setItem('SelTipoUsuario', clienteObjeto.IdTipoUsuario);
            sessionStorage.setItem('SelName', $('#ddlClientes option:selected').text());

            SetClienteSel(clienteObjeto.IdPersona);
            location.reload();
        });
    });

    //Se ejecuta la funcion para asignar el valor de idpersona en la variable de session "ClienteSel"
    function SetClienteSel(IdPersona)
    {
        $.post(path + "Generales/SetSessionClienteSel?IdPersona=" + IdPersona,
            function (data) 
            {
                //Se ejecutan las funciones de java script del index.js para inicilizar las opciones del cliente
                //GetMonedas();
                //GetRuleta(data);
                GetCarrito();
            }).error(function ()
            {
                alert(false, "No fue posible incializar su perfil de (carrito, ruleta y monedas)");
            }
        );
    }

