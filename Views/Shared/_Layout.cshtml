    <!--ow lCaruosel JS-->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.2.1/owl.carousel.js"></script>
    
    <script>
        $(document).ready(function () 
        {
            if ($('.bbb_viewed_slider').length) {
                var viewedSlider = $('.bbb_viewed_slider');

                viewedSlider.owlCarousel(
                    {
                        loop: true,
                        margin: 30,
                        autoplay: true,
                        autoplayTimeout: 6000,
                        nav: false,
                        dots: false,
                        responsive:
                        {
                            0: { items: 1 },
                            575: { items: 2 },
                            768: { items: 3 },
                            991: { items: 4 },
                            1199: { items: 6 }
                        }
                    });

                if ($('.bbb_viewed_prev').length) {
                    var prev = $('.bbb_viewed_prev');
                    prev.on('click', function () {
                        viewedSlider.trigger('prev.owl.carousel');
                    });
                }

                if ($('.bbb_viewed_next').length) {
                    var next = $('.bbb_viewed_next');
                    next.on('click', function () {
                        viewedSlider.trigger('next.owl.carousel');
                    });
                }
            }
        });

        function ValidarBusqueda()
        {
            var textoBusqueda = document.getElementById('txtBuscarProdGeneral').value;

            // Si el texto ingresado es mayor o igual a 3 caracteres, ejecuta la búsqueda
            if (textoBusqueda.length >= 3) 
            {
                // Obtener el modal por su id
                var modalElement = document.getElementById('exampleModal');

                // Crear una instancia del modal
                var modal = new bootstrap.Modal(modalElement);

                // Mostrar el modal
                modal.show();

                BuscarProductoGeneral(); //Se carga la informacion en la tabla
            }
            else 
            {
                // Si no pasa la validación, muestra una alerta y no ejecuta la búsqueda
                alert("Por favor, ingrese al menos 3 caracteres para realizar la búsqueda.");

                return; // Evita que se ejecute cualquier código posterior
            }
        }

        function BuscarProductoGeneral() 
        {
            // Muestra la tabla de productos
            $('#divMostrarProductos').show();
            
            // Ocutal el detalle del producto
            $('#descripcionProducto').hide();

            //Destrulle la tabla para mostrar los nuevos registros de productos
            $('#BuscarProductoGeneral').dataTable().fnDestroy();
            let Busqueda = $("#txtBuscarProdGeneral").val();

            const liquidationImg = path + "../Imagenes/liquidacion.png";

            $('#BuscarProductoGeneral').DataTable({
                responsive: true, // Activa la responsividad
                columnDefs: [
                    { targets: [0, 1, 2, 3], className: "text-wrap" }, //Status, nombre, presentación y fórmula
                    { targets: 1, responsivePriority: 1 }, // Status (Prioridad alta)
                    { targets: 5, responsivePriority: 2 }, // Precio (Prioridad media)
                    { targets: 6, responsivePriority: 3, orderable: false } // Botón Agregar (Siempre visible)
                ],
                "info": false,
                "language": { "url": "//cdn.datatables.net/plug-ins/1.10.16/i18n/Spanish.json" },
                pageLength: 10,
                "searching": false, // Esto oculta el control de búsqueda
                "ajax": {
                    "url": path + "Home/GetSearchGeneral?Filtro=" + Busqueda + "&IdUsuario=" + sessionStorage.getItem('SelValue'),
                    type: 'POST',
                    dataSrc: ""
                },
                "columns": [
                    { "data": "status", title: "Estatus", visible:false },
                    {
                        data: "nombre",
                        title: "Nombre",
                        render: function (data, type, row) {
                            // Si el status es 4, agregamos la imagen de liquidación junto al nombre
                            if (row.status === 4) {
                                return `
                                    <div class="d-flex align-items-center">
                                        <img src="${liquidationImg}"
                                                alt="Liquidación"
                                                title="Producto en liquidación"
                                                style="margin-right:8px;">
                                        <span>${data}</span>
                                    </div>`;
                            }
                            // Si no está en estatus 4, solo mostramos el nombre
                            return `<span>${data}</span>`;
                        }
                    },
                    { "data": "presentacion", title: "Presentación" },
                    { "data": "formula", title: "Fórmula" },
                    { "data": "laboratorio", title: "Laboratorio" },
                    {
                        "data": "precioFinal", title: "Precio Final S/I",
                        "render": function (data, type, row) 
                        {
                            return FormatoMoneda(data);
                        }
                    },
                    {
                        "data": "idProducto", title: "", "width": "30px", "orderable": false,
                        render: function (data, type, row) {
                            return '<button onClick="detalleProductoGeneral(' + data + ')" type="button" class="btn btn-outline-success mt-2 mb-2"><i class="fas fa-plus" aria-hidden="true"></i></button>'
                        }
                    }
                ]
            });
        }

        function detalleProductoGeneral(IdProducto)
        {
            var elemento = document.getElementById('collapseImage');
            var precio = 0;
            var iva = 0;
            var subtotal = 0;
            var ivatotal = 0;
            var total = 0;

            // Verifica si el elemento tiene la clase 'show'
            if (elemento.classList.contains('show')) {
                toggleCollapse()
            }

            //Asignacion de monedas por visita de producto del proveedor
            //AsignarMonedasProducto(IdProducto);

            $('#descripcionProducto').show();
            $('#divMostrarProductos').hide();

            $.ajax({
                type: "POST",
                url: path + "Stand/DetalleProducto?IdProducto=" + IdProducto + "&Idproveedor=" + sessionStorage.getItem('SelValue'),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (resultado) {
                    document.getElementById('idproducto_general').innerHTML = " " + resultado.idProducto;
                    document.getElementById('lbl_nombre_general').innerHTML = " " + resultado.nombre;
                    document.getElementById('presentacion_general').innerHTML = " " + resultado.presentacion + " " + resultado.unidades;
                    document.getElementById('neto_general').innerHTML = " " + FormatoMoneda(resultado.neto);
                    document.getElementById('PrecioPublico_general').innerHTML = " " + FormatoMoneda(resultado.publico);
                    document.getElementById('precioRegular_general').innerHTML = " " + FormatoMoneda(resultado.precioRegular);
                    document.getElementById('precioMR_general').innerHTML = " " + FormatoMoneda(resultado.precioMR);
                    document.getElementById('preciofinal_general').innerHTML = " " + FormatoMoneda(resultado.precioFinal);
                    document.getElementById('descuentoExpo_general').innerHTML = " " + FormatoMoneda(resultado.descuentoExpo);
                    if (resultado.descuentoCliente == true) {
                        document.getElementById(`imgDescuento_general`).style.display = 'block';
                        document.getElementById('imgDescuento_general').src = "../Imagenes/descuentoExclusivo.png"
                    }
                    else {
                        document.getElementById(`imgDescuento_general`).style.display = 'none';
                    }
                    if (resultado.status === 4) {
                        document.getElementById(`imgLiquidacion_general`).style.display = 'block';
                    }
                    else {
                        document.getElementById(`imgLiquidacion_general`).style.display = 'none';
                    }
                    document.getElementById('iva_general').innerHTML = resultado.iva == false ? " <span style='color:#fff; font-size:0.7em'>Sin Iva</span>" : " <span style='color:#0fa200; font-size:0.7em'>más IVA</span>";
                    document.getElementById('getiva_general').innerHTML = " ";
                    document.getElementById('laboratorio_general').innerHTML = " " + resultado.laboratorio;
                    document.getElementById('caja_general').innerHTML = " " + resultado.caja;
                    document.getElementById('codigo_general').innerHTML = " " + resultado.codigo;
                    // document.getElementById('restringido_general').innerHTML = " " + resultado.cantidad;
                    document.getElementById('formula_general').innerHTML = " " + resultado.formula;
                    document.getElementById('subtotal_general').innerHTML = " " + FormatoMoneda(0);
                    document.getElementById('valoriva_general').innerHTML = " " + FormatoMoneda(0);
                    document.getElementById('total_general').innerHTML = " " + FormatoMoneda(0);

                    $("#IdProducto_general").val(IdProducto)
                    $("#PrecioMR_general").val(resultado.precioMR)
                    $("#cantidad_general").val(0)

                    precio = resultado.precioFinal;
                    iva = resultado.valorIva;
                },
                error: function (xhr, status, error) {
                    console.log(error);
                }
            });

            cantidad_general.oninput = function () 
            {
                subtotal = cantidad_general.value * precio;
                ivatotal = cantidad_general.value * precio * iva;
                total = cantidad_general.value * precio * (1 + iva);

                document.getElementById('subtotal_general').innerHTML = FormatoMoneda(subtotal);
                document.getElementById('valoriva_general').innerHTML = FormatoMoneda(ivatotal);
                document.getElementById('total_general').innerHTML = FormatoMoneda(total)
            }
        }

        function OnDemandImageGeneral()
        {
            let IdProducto = $("#IdProducto_general").val()
            $("#imgModalOndemandGeneral").html('')
            $.post(path + "Stand/GetFotoProducto",
                {
                    idProducto: IdProducto
                },
                function (data) {
                    if (data.length > 0)
                        $("#imgModalOndemandGeneral").append('<img id="imgProduct" class="card-img-top zoom d-desktop" style="margin: auto;" src="data:image/png;base64,' + data + '" alt="image" /><img id="imgProduct_sm" class="card-img-top d-mobile" style="margin: auto;" src="data:image/png;base64,' + data + '" alt="image producto" />')
                    else
                        $("#imgModalOndemandGeneral").append('<img class="card-img-top" style=" width: 150px; height: 150px; margin: auto;" src="../Imagenes/noimage.png" alt="image" />')
                }).error(function () {
                    CloseModal("ModalProductoGeneral")
                    ShowAlert("No fue posible cargar sus datos", false, "liveAlertPlaceholderProductos");
                });
        }

        function CancelarAgregarProductoGeneral() 
        {
            // Muestra la tabla de productos
            $('#divMostrarProductos').show();

            // Recarga la tabla de productos
            BuscarProductoGeneral();
        }

        function AgregarProductoGeneral() 
        {
            let IdProducto = $("#IdProducto_general").val()
            let Cantidad = $("#cantidad_general").val()
            let PrecioMR = $("#PrecioMR_general").val()

            if (Cantidad > 0) {
                $.post(path + "Producto/AddCarrito",
                    {
                        idProducto: IdProducto,
                        cantidad: Cantidad,
                        unitario: PrecioMR
                    },
                    function (data) {
                        CancelarAgregarProductoGeneral()
                        ShowAlert(data.message, data.response, "liveAlertPlaceholderProductos")
                        GetCarrito();
                        //GetMonedas()
                    }).error(function () {
                        CloseModal("ModalProducto")
                        ShowAlert("No fue posible cargar sus datos", false, "liveAlertPlaceholderProductos");
                    });
            }
            else {
                ShowAlert("La Cantidad debe ser mayor a Cero", false, "liveAlertPlaceholderModal");
            }
        }

        function CerrarRecargar() 
        {
            var vistaActual = "@ViewContext.RouteData.Values["action"]";
            var controladorActual = "@ViewContext.RouteData.Values["controller"]";
            
            if (vistaActual === "Index" && controladorActual === "Carrito")
            {
                window.location.reload()
            }
        }
    </script>

    <script src="~/js/index.js"></script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
