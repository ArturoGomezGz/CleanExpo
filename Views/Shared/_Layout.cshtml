@using Microsoft.AspNetCore.Identity

@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <!-- Meta, title, CSS, favicons, etc. -->
    <meta charset="utf-8">    
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="~/imagenes/favicon.ico" type="image/ico" />
    <title>Medicinas Rosario </title>
    <!-- CSS only Boostrap-->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.0/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-gH2yIJqKdNHPEq0n4Mqa/HGKIhSkIHeL5AyhkYV8i59U5AR6csBvApHHNl/vI1Bx" crossorigin="anonymous">
    <!--Fontawesome-->
    <script src="https://kit.fontawesome.com/41bcea2ae3.js" crossorigin="anonymous"></script>
    <script src="https://code.jquery.com/jquery-3.3.1.js"></script>
    <script src="//ajax.googleapis.com/ajax/libs/jquery/1.9.1/jquery.min.js"></script>
   
    <!--Datables-->
    <link href="https://cdn.datatables.net/1.13.1/css/jquery.dataTables.min.css" rel="stylesheet">
    <link href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.dataTables.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.carousel.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.theme.default.css">
 
    <!-- Custom Theme Style --> 
    <link rel="stylesheet" href="~/css/index.css">
    <link rel="stylesheet" href="~/css/common.blocks/commoncss.css" />  
    <link rel="stylesheet" href="~/css/mobile.blocks/mobile.css" media="screen and (max-width: 600px)" />
    <link rel="stylesheet" href="~/css/desktop.blocks/desktop.css" media="(min-width: 601px) and (max-width: 800px)" />    
</head>
<body>
    
    <!--Header
    <nav id="header" class="fixed-top navbar navbar-expand-lg navbar-dark  bg-body-tertiary">-->
    <nav id="header" class="fixed-top navbar navbar-expand-lg">
          <div class="container">
            <a class="" asp-controller="Home" asp-action="">
                <img src="~/Imagenes/logoMR.png" alt="Expo MR">
            </a>
            
            @if (User.IsInRole("Cliente") || User.IsInRole("ClienteVIP") || User.IsInRole("Proveedor"))
            {
                <a asp-controller="Monedas" asp-action="" class="btn btn-moneda gradient-moneda position-relative" id="moneda">
                    <i class="fa fa-usd" aria-hidden="true"></i>
                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                        <span id="cantidad_monedas"></span>
                        <span class="visually-hidden">unread messages</span>
                    </span>
                </a>
            }
            @if (User.IsInRole("Cliente") || User.IsInRole("ClienteVIP"))
            {
                <a asp-controller="Ruleta" asp-action="" class="btn btn-ruleta-inactiva position-relative" id="Ruleta">
                    <i aria-hidden="true"><img class="img-ruleta" src="~/imagenes/ruleta.svg" /></i> Ruleta
                </a>
            }
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                    data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false"
                    aria-label="Toggle navigation">
                <span class="fa-solid fa-bars"></span>
            </button>
            <div  class="collapse navbar-collapse" id="navbarSupportedContent">
                <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                    <partial name="_LoginUser" />
                    <partial name="_LoginRegistroVistaParcial" />
                </ul>
            </div>
        </div>
    </nav>
    <!--/ Header-->

    <!--Cuerpo de la pagina-->
    <div id="main" class="container">
        @RenderBody()
    </div>
    <!--/ Cuerpo de la pagina-->

    <!--Footer-->
    @if (User.IsInRole("Cliente") || User.IsInRole("ClienteVIP"))
    {
        <footer id="footer" class="pb-2 pt-2">
            <div class="container">
                <div class="row text-center">
                    <div class="col-12 col-lg">
                        <a asp-area="" asp-controller="Ayuda" asp-action="Contacto">Contacto Rosario</a>
                    </div>
                    <div class="col-12 col-lg">
                        <a asp-area="" asp-controller="Ayuda" asp-action="Index">Índice de Sales</a>
                    </div>
                    <div class="col-12 col-lg">
                        <a asp-area="" asp-controller="Ayuda" asp-action="Privacidad">Privacidad</a>
                    </div>
                    <div class="col-12 col-lg">
                        <a asp-area="" asp-controller="Ayuda" asp-action="Preguntas">Preguntas Frecuentes</a>
                    </div>
                    <div class="col-12 col-lg">
                        <a asp-area="" asp-controller="Ayuda" asp-action="CondicionesRuleta">Condiciones Ruleta</a>
                    </div>
                    <div class="col-12 col-lg">
                        <a asp-area="" asp-controller="Ayuda" asp-action="TerminosyCondiciones">Términos y Condiciones</a>
                    </div>
                </div>
            </div>
        </footer>
    }
    else
    {
        <footer id="footer" class="pb-4 pt-4">
            <div class="container">
                <div class="row text-center">
                    <div class="col-12 col-lg">
                        <a asp-area="" asp-controller="Proveedores" asp-action="Contacto">Contacto Rosario</a>
                    </div>
                    <div class="col-12 col-lg">
                        <a asp-area="" asp-controller="Proveedores" asp-action="Privacidad">Privacidad</a>
                    </div>
                    <div class="col-12 col-lg">
                        <a asp-area="" asp-controller="Proveedores" asp-action="Preguntas">Preguntas</a>
                    </div>
                </div>
            </div>
        </footer>
    }
    <!--/ Footer-->

    <!-- JavaScript Bundle with Popper -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.0/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-A3rJD856KowSb7dwlZdYEkO39Gagi7vIsF0jrRAoQmDKKtQBHUuLZ9AsSv4jD4Xa"
            crossorigin="anonymous"></script>    
    <script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>    
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>
    <script type="text/javascript" src="//gyrocode.github.io/jquery-datatables-checkboxes/1.2.12/js/dataTables.checkboxes.min.js"></script>

    <!--ow lCaruosel JS-->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.2.1/owl.carousel.js"></script>
    
    <script>
        $(document).ready(function () {
            if ($('.bbb_viewed_slider').length) {
                var viewedSlider = $('.bbb_viewed_slider');

                viewedSlider.owlCarousel(
                    {
                        loop: true,
                        margin: 30,
                        autoplay: true,
                        autoplayTimeout: 6000,
                        nav: false,
                        dots: false,
                        responsive:
                        {
                            0: { items: 1 },
                            575: { items: 2 },
                            768: { items: 3 },
                            991: { items: 4 },
                            1199: { items: 6 }
                        }
                    });

                if ($('.bbb_viewed_prev').length) {
                    var prev = $('.bbb_viewed_prev');
                    prev.on('click', function () {
                        viewedSlider.trigger('prev.owl.carousel');
                    });
                }

                if ($('.bbb_viewed_next').length) {
                    var next = $('.bbb_viewed_next');
                    next.on('click', function () {
                        viewedSlider.trigger('next.owl.carousel');
                    });
                }
            }
        });
    </script>
    <script src="~/js/index.js"></script>
    <script src="~/js/IndexClientes.js"></script>
    <script src="~/js/indexProveedores.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
