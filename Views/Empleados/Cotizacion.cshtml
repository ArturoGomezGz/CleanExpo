@{
    ViewData["Title"] = "Cotizacion";
}

<div class="row">
    <div class="col-md-1 col-xl-2"></div>
    <div class="col-md-10 col-xl-8">
        <h3>Cotizaciones</h3>
        <table id="Cotizacion" class="display" style="width:100%">
            <thead>
                <tr>
                    <th></th>
                    <th>Cliente</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
            @*<tfoot>
                <tr>
                    <th>Acceder</th>
                    <th>Cliente</th>
                </tr>
                </tfoot>*@
        </table>
    </div>
    <div class="col-md-1 col-xl-2"></div>
</div>

<script>
    $(document).ready(function () {
        $('#Cotizacion').DataTable({
            order: [[1, 'asc']],
            responsive: true,
            "info": false,
            "language": {"url": "//cdn.datatables.net/plug-ins/1.10.16/i18n/Spanish.json"},
            "ajax": {
                url: path+"Empleados/GetClientes",
                type: 'POST',
                dataSrc: ""
            },
            "columns": [
                {
                    "data": "acceder",
                    render: function (data, type) {                        
                        if (type === 'display') {
                            return '<a href="'+path+'Empleados/CotizacionDetail?IdCliente=' + data + '" class="btn btn-link"><i class="fas fa-chevron-right" aria-hidden="true"></i></a>';
                        }

                        return data;
                    },
                },
                { "data": "cliente" }
            ]
        });
    });
</script>