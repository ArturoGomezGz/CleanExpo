@model Cotizacion

@{
    ViewData["Title"] = "GetCotizacion";
}

<div class="row">
    <div id="liveAlertDetailCotizacion"></div>
    <div class="col-12 col-lg-8">
        <h3>Orden</h3>
        <label hidden>@Model.IdCliente</label>
        <label hidden>@Model.IdCotizacion</label>
        <strong>Cliente: </strong><label>@Model.Cliente</label><br />
        <strong>RFC: </strong><label>@Model.RFC</label><br /><br />
        <strong>Tipo de Comprobante:</strong>
        <label>
            @Html.DropDownListFor(model => model.IdDocumento, new SelectList(Model.TipoDocumentos, "IdDocumento", "Documentos"), new { id = "txtDocumento", @class= "form-select", name = "Documento", disabled="disabled", title="cmb"})
        </label>
        <br />
        <strong>Uso del CFDI: </strong>
        <label>
            @Html.DropDownListFor(model => model.IdUsoCFDI, new SelectList(Model.CFDI, "IdUsoCFDI", "UsoCFDI"), new { id = "txtUsoCFDI", @class= "form-select", name = "Documento", disabled="disabled", title="cmb"})
        </label>
        <br />
        <br />
        <strong>Tipo de Envío: </strong>
        <label>
            @Html.DropDownListFor(model => model.IdTipoVenta, new SelectList(Model.Venta, "IdTipoVenta", "TipoVenta"), new { id = "txtTipoVenta",  @class="form-select", disabled="disabled",name = "Documento",  title="cmb"})
        </label>
        <br />
        <strong>Trasportista: </strong>
        <label>
            @Html.DropDownListFor(model => model.IdTransporte, new SelectList(Model.transportistas, "IdTransporte", "Transportista"), new { id = "txtTransportista",  @class="form-select", disabled="disabled",name = "Documento",  title="cmb"})
        </label>
        <br />
        <strong>Porte: </strong>
        <label>
            @Html.DropDownListFor(model => model.IdPorte, new SelectList(Model.portes, "IdPorte", "Porte"), new { id = "txtPorte",  @class="form-select", disabled="disabled",name = "Documento",  title="cmb"})
        </label>
        <br />
        <strong>Dirección de Entrega: </strong>
        <label>
            @Html.DropDownListFor(model => model.Direccion, new SelectList(Model.Direcciones, "Entrega", "DirEntrega"), new { id = "txtDirEntrega",  @class="form-select", disabled="disabled",name = "Documento",  title="cmb"})
        </label>
        <br />
        <strong>Observaciones:</strong><lable><input type="text" id="txtObsv" value="@Model.Observaciones" class="form-control" disabled /></lable>
    </div>
    <div id="divCotizacionTotal" class="col-12 col-lg-4 d-none">
        <div class="contenedor carritoTotal">
            <p style="color:#244f87; font-size:1.2em; font-weight:bold;"><label>Crédito: </label> <label id="lblcredito"></label></p>
            <p><strong>Subtotal: </strong><label id="lblsubtotal"></label></p>
            <p><strong>Iva: </strong><label id="lbliva"></label></p>
            <hr/>
            <p><strong>Total: </strong><label id="lbltotal"></label></p>
            <p><strong>Total de Productos: </strong><label id="lbltotalProductos"></label></p>
            <div id="btnColocaOrden">
                <button id="colocaOrden" onclick="colocarOrden()" class="btn btn-naranja">Coloca tu Orden</button>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-6">
        <button type="button" id="btGuardarDatosCotizacion" onclick="GuardarDatosCotizacion()" class="btn btn-verde-medio">Guardar</button>
    </div>
    <div class="col-md-6">
        <button type="button" id="btCancelDatosCotizacion" class="btn btn-rojo" onclick="CancelGuadar()" data-bs-dismiss="modal">Cancelar</button>
    </div>
</div> 
<div class="row">
    <div class="col-md-4">
        <button type="button" id="AgregarProductos" onclick="btnagregarProductos()" class="btn btn-azul col-md-55" data-bs-toggle="modal" data-bs-target="#exampleModal">Agregar Productos</button>
    </div>
    <div class="col-md-4">
        <button id="btn-modificar" onclick="modificarCotizacion()" type="button" class="btn btn-naranja col-md-55" data-bs-toggle="modal" data-bs-target="#editDatosCliente">Editar</button>
    </div>
    <div class="col-md-4">
        <button type="button" id="buscarCliente" class="btn btn-outline-secondary col-md-55">Buscar cliente</button>
    </div>
</div>
<br/>

<!-- Modal captura de productos -->
<div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Captura de Productos</h5>
                <button type="button" onclick="cerrarCapturaProductos()" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="col-md-10">
                    <div class="input-group mb-3">
                        <input type="text" class="form-control" id="txtBuscar" placeholder="Nombre, Presentación, Fórmula" name="Busqueda" />
                        <div class="input-group-append">
                            <button type="button" class="btn btn-outline-secondary" value="Buscar" onclick="BuscarListaProducto()">Buscar <i class="fas fa-search"></i> </button>
                        </div>
                    </div>
                </div>
                <div id="divMostrarProductos" class="col-12">
                    <table id="BuscarProducto" class="table">
                        <thead>
                            <tr>
                                <th scope="col"></th>
                                <th scope="col">Nombre</th>
                                <th scope="col">Presentación</th>
                                <th scope="col">Fórmula</th>
                                <th scope="col">Laboratorio</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
                <div id="descripcionProducto" class="col-md-12">
                    <div id="liveAlertPlaceholder"></div>
                    <div class="card">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-12 col-lg-7  text-justify">
                                    <div class="row">
                                        <h5 class="card-title "><label id="nombre"></label></h5>
                                        <label class="label__Presentacion" id="presentacion"></label>
                                    </div>
                                    <div class="mb-3">
                                        <strong>No. Producto: </strong> <label class="label__producto" id="idproducto"></label>
                                    </div>
                                    <div class="mb-3">
                                        <strong>Restringido a: </strong> <label class="label__producto" id="restingido"></label>
                                    </div>
                                    <div class="row">
                                        <div class="col-6">
                                            <strong>Precio Publico: </strong> <label class="label__publico" id="publico"></label>
                                        </div>
                                        <div class="col-6">
                                            <strong>Precio MR: </strong><label class="label__PrecioMR" id="precio"></label>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-6">
                                            <strong>Precio Neto sin Iva: </strong><label class="label__Neto" id="neto"></label>
                                        </div>
                                        <div class="col-6">
                                            <strong>Descuento Expo: </strong><label class="label__DescuentoExpo" id="descuentoexpo"></label>
                                        </div>
                                    </div>
                                    <div class="row mb-4">
                                        <h6>
                                            <label class="label__DescuentoExpo" id="iva"></label>
                                        </h6>
                                    </div>
                                    <div class="row">
                                        <strong>Formula: </strong> <label class="label__Formula" id="formula"></label>
                                    </div>
                                    <div>
                                        <strong>Laboratorio: </strong> <label class="label__Laboratorio" id="laboratorio"></label>
                                    </div>
                                    <div>
                                        <strong>Caja Colectiva: </strong> <label class="label__Caja" id="caja"></label>
                                    </div>
                                    <div>
                                        <strong>Código: </strong> <label class="label__Caja" id="codigo"></label>
                                    </div>
                                </div>
                                <div class="col-md-12 col-lg-5">
                                    <div class="contenedor__Producto">
                                        <div class="row w-100 mb-2">
                                            <div class="col-6 totalLabel">
                                                <label>Precio Final:</label>
                                            </div>
                                            <div class="col-6">
                                                <label class="contenedor__Producto__PrecioFinal" id="preciofinal"></label>
                                            </div>
                                        </div>
                                        <div class="row w-100">
                                            <div class="col-6 totalLabel">
                                                <label>Cantidad:</label>
                                            </div>
                                            <div class="col-6">
                                                <input id="cantidad" type="number" min="0" value="0" placeholder="0" style="width:75%" />
                                            </div>
                                        </div>
                                        <div class="row w-100 mt-5">
                                            <div class="col-6 totalLabel">
                                                <label>Subtotal:</label>
                                            </div>
                                            <div class="col-6">
                                                <label class="contenedor__Producto__subtotal" id="subtotal"></label>
                                            </div>
                                        </div>
                                        <div class="row w-100 mb-3">
                                            <div class="col-6 totalLabel">
                                                <label>Iva:</label>
                                            </div>
                                            <div class="col-6">
                                                <label class="contenedor__Producto__iva" id="valoriva"></label>
                                            </div>
                                        </div>
                                        <div class="row" style="width:90%">
                                            <hr />
                                            <div class="col-6 totalLabel">
                                                <label>Total:</label>
                                            </div>
                                            <div class="col-6">
                                                <label class="contenedor__Producto__Total" id="total"></label>
                                            </div>
                                        </div>
                                        <div class="row" style="width:90%">
                                            <button id="liveAlertBtn" onclick="AgregarProducto()" type="button" class="contenedor_btn btn btn-naranja mb-3">Añadir a Carrito</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <button type="button" id="IraProductos" onclick="regresaProductos()" class="btn btn-azul">Ir a Productos</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Productos -->
<div class="row">
    <div class="col-md-12">
        <table id="Productos" class="table" style="width:100%">
            <thead>
                <tr>
                    <th></th>
                    <th>Nombre</th>
                    <th>Presentación</th>
                    <th>Laboratorio</th>
                    <th>Cantidad</th>
                    <th>Precio Final S/I</th>
                    <th>Total</th>
                    <th></th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Valida Cotizacion -->
<div class="modal fade" id="modalValidaCotizacion" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-body">
                <label id="lblValidaCotizacion"></label><br />
                <button type="button" class="btn btn-verde-medio" data-bs-dismiss="modal">Aceptar</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Confirmar Cliente -->
<div class="modal fade" id="modalConfirmarCliente" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-body">
                <p>El pedido del cliente</p>
                <label id="lblConfirmarCliente">@Model.Cliente</label><br />
                <p>será enviado a surtir a almacén y no se podrán hacer cambios.</p>
                <button type="button" onclick="PedidoAgregar()" class="btn btn-verde-medio" data-bs-dismiss="modal">Aceptar</button>
                <button type="button" class="btn btn-rojo" data-bs-dismiss="modal">Cancelar</button>
            </div>
        </div>
    </div>
</div>

<script>
    function btnagregarProductos() 
    {
        document.getElementById("txtBuscar").value = "";
        $('#descripcionProducto').hide();        
    }

    function cerrarCapturaProductos()
    {
        location.reload();    
    }

    function regresaProductos()
    {
        $('#descripcionProducto').hide();
        $('#BuscarProducto').show();
    }

    function modificarCotizacion() 
    {
        var dirEntrega = document.getElementById("txtDirEntrega");
        var transportista = document.getElementById("txtTransportista");
        var Porte = document.getElementById("txtPorte");

        document.getElementById("txtDocumento").disabled = false;
        document.getElementById("txtUsoCFDI").disabled = false;
        document.getElementById("txtTipoVenta").disabled = false;
        document.getElementById("txtObsv").disabled = false;

        if (document.getElementById("txtTipoVenta").value == 1) {
            dirEntrega.classList.add('d-none');
            transportista.classList.add('d-none');
            Porte.classList.add('d-none');
        }
        else if (document.getElementById("txtTipoVenta").value > 2) {
            transportista.classList.add('d-none');
            Porte.classList.add('d-none');
            dirEntrega.disabled = false;
        }
        else
        {
            dirEntrega.disabled = false;
            transportista.disabled = false;
            Porte.disabled = false;
        }

        $("#AgregarProductos").hide();
        $("#buscarCliente").hide();
        $("#btGuardarDatosCotizacion").show();
        $("#btCancelDatosCotizacion").show();
        $("#btn-modificar").hide();     
    }

    function GuardarDatosCotizacion()
    {
        let IdDocumento = document.getElementById("txtDocumento").value;
        let IdUsoCFDI = document.getElementById("txtUsoCFDI").value;
        let IdTipoVenta = document.getElementById("txtTipoVenta").value;
        let IdTrasportista = document.getElementById("txtTransportista").value;
        let IdPorte = document.getElementById("txtPorte").value;
        let IdEntrega = document.getElementById("txtDirEntrega").value;
        let Obsv = document.getElementById("txtObsv").value;

        $.post(path + "Empleados/EditarClienteCotizacion",
            {
                IdCotizacion: @Model.IdCotizacion,
                IdDocumento: IdDocumento,
                IdUsoCFDI: IdUsoCFDI,
                IdTipoVenta: IdTipoVenta,
                IdTransportista: IdTrasportista,
                IdPorte: IdPorte,
                IdEntrega: IdEntrega,
                Obsv: Obsv
            },
            function (data) {   
                ShowAlert(data.message, data.response, "liveAlertDetailCotizacion")
                location.reload();
            }).error(function () {
                ShowAlert("No fue posible cargar sus datos", false);
            });

        window.location.reload();     
    }

    function CancelGuadar()
    {
        location.reload();
        $("#AgregarProductos").show();
        $("#buscarCliente").show();
        $("#btn-modificar").show();
        $("#btGuardarDatosCotizacion").hide();
        $("#btCancelDatosCotizacion").hide();
        document.getElementById("txtDocumento").disabled = true;
        document.getElementById("txtUsoCFDI").disabled = true;
        document.getElementById("txtTipoVenta").disabled = true;
        document.getElementById("txtDirEntrega").disabled = true;
        document.getElementById("txtTransportista").disabled = true;
        document.getElementById("txtPorte").disabled = true;        
    }

    function BuscarListaProducto() 
    {
        $('#descripcionProducto').hide();
        $('#divMostrarProductos').show();
        $('#BuscarProducto').dataTable().fnDestroy();
        let Busqueda = $("#txtBuscar").val();
        
        $('#BuscarProducto').DataTable({
            order: [[1, 'asc']],
            bFilter: false,
            lengthChange: false,
            "ajax": {
                        "url": path+"Empleados/ProductoBusqueda?Busqueda=" + Busqueda + "&IdCotizacion=" + @Model.IdCotizacion,
                        type: 'POST',
                        dataSrc: ""
                    },
            "columns": 
            [
                {
                    "data":  "idProducto",
                    render: function (data, type) 
                    {
                        if (type === 'display') 
                        {
                            return '<a onclick="detalleProducto(' + data + ')" class="btn btn-link"><i class="fas fa-chevron-right" aria-hidden="true"></i></a>';
                        }
                        return data;
                    },
                },
                { "data": "nombre" },
                { "data": "presentacion" },
                { "data": "formula" },
                { "data": "laboratorio" }
            ]
        });
    }

    function regresarBuscarProductos(){
        $('#descripcionProducto').hide();
        document.getElementById("txtBuscar").value = "";
        $('#BuscarProducto').dataTable().fnDestroy();
    }

    $('#buscarCliente').click(function () {
        document.location = '@Url.Action("Cotizacion")';
    });

    document.getElementById('txtBuscar').addEventListener('keydown', function (e) { //Se detecta el enter en el control txtBuscar de productos
        if (e.keyCode === 13) 
        {
            BuscarListaProducto();
        }
    });

</script>

<script>

    var precio = 0;
    var iva = 0;
    var subtotal = 0;
    var ivatotal = 0;
    var total = 0;

    window.onload = function ()
    {
        $.ajax({
            type: "POST",
            url: path + "Empleados/TotalCotizacion?IdCliente=" + @Model.IdCliente,
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (resultado) {
                document.getElementById('lblcredito').innerHTML = "" + FormatoMoneda(resultado.credito);
                document.getElementById('lblsubtotal').innerHTML = " $" + resultado.subtotal;
                document.getElementById('lbliva').innerHTML = " $" + resultado.iva;
                document.getElementById('lbltotal').innerHTML = " $" + resultado.total;
                document.getElementById('lbltotalProductos').innerHTML = " " + resultado.productos;
                if (resultado.productos != 0) {
                    $("#divCotizacionTotal").removeClass("d-none");
                }

            },
            error: function (xhr, status, error) {
                console.log(error);
            }
        });
    }

    $(document).ready(function () 
    {
        $("#descripcionProducto").hide();
        $("#btGuardarDatosCotizacion").hide();
        $("#btCancelDatosCotizacion").hide();

        $("btn-modificar").click(function () {
            removeclass()

            var element = document.getElementById("Documento")
            element.removeAttribute("disabled");
        })

        $("#txtTipoVenta").change(function () {
            ChangeTipoVenta(this.value)
        })

        $('#Productos').DataTable({
            "bFilter": false,
            order: [[1, 'asc']],
            responsive: true,
            "info": false,
            "language": {"url": "//cdn.datatables.net/plug-ins/1.10.16/i18n/Spanish.json"},
            "ajax": {
                url: path + "Empleados/ProductosCapturados?IdCliente=" + @Model.IdCliente,
                type: 'POST',
                dataSrc: ""
            },
            "columns": [
                {
                    "data": "idProducto",
                    render: function (data, type) {
                        if (type === 'display') 
                        {
                            return '<input class="hdn" type="hidden" value="' + data + '"/>';
                        }

                        return data;
                    },
                },
                { "data": "nombre" },
                { "data": "presentacion" },
                { "data": "laboratorio" },
                { "data": "cantidad",
                    render: function (data, type, row) 
                    {
                        if (type === 'display') 
                        {
                            return '<input class="text" type="number" value="' + data + '" disabled style="width:60px; heigth:70px"/>'
                                  + '<button class="btn btn-naranja-ch fas fa-pencil-alt Edit"></button>'
                                  + '<div class="d-block">'
                                  + '<a class="btn btn-outline-success Update" style="display:none"><i class="fas fa-check" aria-hidden="true"></i></a>'
                                  + '<a class="btn btn-outline-danger Cancel" style="display:none"><i class="fas fa-ban" aria-hidden="true"></i></a>'
                                  + '</div>'
                                + '<input class="hdn" type="hidden" value="' + row.idProducto + '"/>';
                        }
                        return data;
                    },                
                },
                {
                    "data": "precioFinal",
                    render: function (data, type) {                       
                        return  FormatoMoneda(data);
                    }
                },
                {
                    "data": "total",
                    render: function (data, type) {
                        return FormatoMoneda(data);
                    }                
                },
                {
                    "data": "idProducto",
                    render: function (data, type) 
                    {
                        if (type === 'display')
                        {
                            return '<button class="btn btn-outline-danger Borrar far fa-trash-alt" onclick="BorrarProducto(' + data + ')">';
                        }

                        return data;
                    },
                },
            ]
        });

        var pzas;

        $('#Productos').on('click','.Edit', function () {

            var row = $(this).closest("tr");

            $('#Productos tr').each(function () { // Buscar y deshabilitar los botones con la clase 'edit'
                $(this).find('.Edit').prop('disabled', true); 
                $(this).find('.Borrar').prop('disabled', true);
            });
            
            row.find(".Update").show();
            row.find(".Cancel").show();
            row.find(".Borrar").hide();
            
            var inputElement  = row.find('.text');
            pzas = inputElement.val();
            inputElement.prop('disabled', false);
            
            $(this).hide();
        });
        
        $('#Productos').on('click', '.Cancel', function () {

            var row = $(this).closest("tr");

            $('#Productos tr').each(function () { // Buscar y deshabilitar los botones con la clase 'edit'
                $(this).find('.Edit').prop('disabled', false);
                $(this).find('.Borrar').prop('disabled', false);
            });
                       
            row.find(".Edit").show();
            row.find(".Update").hide();
            row.find(".Cancel").hide();
            row.find(".Borrar").show();
            
            var inputElement = row.find('.text');
            inputElement.val(pzas);
            inputElement.prop('disabled', true);
            pzas = 0;
        });
        
        $('#Productos').on('click', '.Update', function () {

            var row = $(this).closest("tr");
            var input, inputhidden;

            input = row.find('.text').val();
            inputhidden = row.find('.hdn').val();
            
            row.find(".Edit").show();
            row.find(".Cancel").hide();

            $(this).hide();

            $.post(path + "Empleados/CotizacionEditarCantidadProducto",
                {
                    idproducto: inputhidden,
                    cantidad: input,
                    idcotizacion: @Model.IdCotizacion

                },
                function (data) 
                {
                    window.location.reload()

                }).error(function () {
                    ShowAlert("No fue posible cargar sus datos", false);
                });
        });        
    });
 
    function ChangeTipoVenta(TipoVenta) 
    {
        var dirEntrega = document.getElementById("txtDirEntrega")
        var transportista = document.getElementById("txtTransportista")
        var Porte = document.getElementById("txtPorte")

        switch (TipoVenta) {
            case "0":
                NextBoton.setAttribute("disabled", "");
                break;
            case "1":
                dirEntrega.classList.add('d-none');
                transportista.classList.add('d-none');
                Porte.classList.add('d-none');
                transportista.value = "0";
                Porte.value = "0";
                break;
            case "2":
                dirEntrega.classList.remove('d-none');
                transportista.classList.remove('d-none');
                Porte.classList.remove('d-none');
                dirEntrega.disabled = false;
                transportista.disabled = false;
                Porte.disabled = false;
                break;
            case "3":
                dirEntrega.classList.remove('d-none');
                transportista.classList.add('d-none');
                Porte.classList.add('d-none');
                dirEntrega.disabled = false;
                break;
            case "4":
                dirEntrega.classList.remove('d-none');
                transportista.classList.add('d-none');
                Porte.classList.add('d-none');
                dirEntrega.disabled = false;
                break;
        }
    }

    function BorrarProducto(data)
        {
            let IdProducto = data;

            $.post(path + "Empleados/ProductoDelete",
                {
                    idproducto: IdProducto,
                    cliente: @Model.IdCliente
                },
                function (data){
                    window.location.reload()
            }).error(function () {
                ShowAlert("No fue posible cargar sus datos", false);
            });
        }

    function detalleProducto(IdProducto)
    {
        $('#descripcionProducto').show();
        $('#divMostrarProductos').hide();
       
        $.ajax({
            type: "POST",
            url: path + "Empleados/DetalleProducto?IdProducto=" + IdProducto + "&Cliente=" + @Model.IdCliente,
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (resultado) 
            {
                document.getElementById('txtBuscar').value = "";
                document.getElementById('cantidad').value = 0;

                document.getElementById('idproducto').innerHTML = " " + resultado.idproducto;
                document.getElementById('nombre').innerHTML = " " + resultado.nombre;
                document.getElementById('presentacion').innerHTML = " " + resultado.presentacion + " " + resultado.unidades;
                document.getElementById('neto').innerHTML = " " + FormatoMoneda(resultado.neto);               
                document.getElementById('publico').innerHTML = " " + FormatoMoneda(resultado.publico);
                document.getElementById('precio').innerHTML = " " + FormatoMoneda(resultado.preciomr);
                document.getElementById('preciofinal').innerHTML = " " + FormatoMoneda(resultado.preciofinal);
                document.getElementById('descuentoexpo').innerHTML = " " + FormatoMoneda(resultado.descuentoexpo);                
                document.getElementById('iva').innerHTML = resultado.iva == false ? " <span style='color:#808080; font-size:0.7em'>Sin Iva</span>" : " <span style='color:#0fa200; font-size:0.7em'>Con Iva</span>";              
                document.getElementById('laboratorio').innerHTML = " " + resultado.laboratorio;
                document.getElementById('caja').innerHTML = " " + resultado.caja;
                document.getElementById('codigo').innerHTML = " " + resultado.codigo;
                document.getElementById('restingido').innerHTML = " " + resultado.cantidad;
                document.getElementById('formula').innerHTML = " " + resultado.formula;
                document.getElementById('subtotal').innerHTML = " " + FormatoMoneda(0);
                document.getElementById('valoriva').innerHTML = " " + FormatoMoneda(0);
                document.getElementById('total').innerHTML = " " + FormatoMoneda(0);

                precio = resultado.preciofinal;
                iva = resultado.valoriva;
            },
            error: function (xhr, status, error) {
                console.log(error);
            }
        });      

        cantidad.oninput = function ()
        {
            subtotal = cantidad.value * precio;
            ivatotal = cantidad.value * precio * iva;
            total = cantidad.value * precio * (1 + iva);

            document.getElementById('subtotal').innerHTML = FormatoMoneda(subtotal);
            document.getElementById('valoriva').innerHTML = FormatoMoneda(ivatotal);
            document.getElementById('total').innerHTML = FormatoMoneda(total);
        }
    }

    function AgregarProducto()
    {
        let IdProducto = document.getElementById('idproducto').innerHTML;

        if ($("#cantidad").val() > 0) {
            $.post(path + "Empleados/AddCotizacion",
                {
                    cliente: @Model.IdCliente,
                    idProducto: IdProducto,
                    unitario: precio,
                    cantidad: $("#cantidad").val()
                },
                function (data) {
                    ShowAlert(data.message, data.response)
                    GetCarrito();
                    //GetMonedas();
                    document.getElementById('cantidad').value = 0;
                    $('#BuscarProducto').show();
                }).error(function () {
                    ShowAlert("No fue posible cargar sus datos", false);
                });
        } else {
            ShowAlert("La Cantidad debe ser mayor a Cero", false);
        }
    }

    function colocarOrden()
    {
        var IdDocumento = $("#txtDocumento").val();
        var IdUsoCFDI = $("#txtUsoCFDI").val();

        if(IdDocumento == 1 && IdUsoCFDI == 0)
        {
            window.alert("No se puede colocar el pedido ya que no tiene uso CFDI definido, favor de contactar a Credito y Cobranza")
        }
        else
        {
            $.ajax({
                type: "POST",
                url: path + "Empleados/ColocarOrden?IdCliente=" + @Model.IdCliente,
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (resultado) {
                    const myModal = new bootstrap.Modal(document.getElementById('modalValidaCotizacion'));
                    const myModalConfirmar = new bootstrap.Modal(document.getElementById('modalConfirmarCliente'));
                    switch (resultado) {

                        case 0:
                            document.getElementById('lblValidaCotizacion').innerHTML = 'Revisa que la cotizacion tenga productos'
                            myModal.show();
                            break;
                        case 1:
                            document.getElementById('lblValidaCotizacion').innerHTML = 'Revisa que el cliente tenga crédito suficiente'
                            myModal.show();
                            break;
                        case 2:
                            myModalConfirmar.show();
                            break;
                    }
                },
                error: function (xhr, status, error) {
                    console.log(error);
                }
            });
        }
    }

    function PedidoAgregar()
    {
        $.ajax({
            type: "POST",
            url: path + "Empleados/ExpoPedidoAgregar?IdCliente=" + @Model.IdCliente,
            success: function (resultado) {
                const myModalConfirmar = new bootstrap.Modal(document.getElementById('modalConfirmarCliente'));
                myModalConfirmar.hide();
                document.location = '@Url.Action("Cotizacion")';
            },
            error: function (xhr, status, error) {
                console.log(error);
            }
        });    
    }
    
</script>