@model List<InfoRuletas>
@{
    ViewData["Title"] = "Index";
}

<div class="row">
    <div class="col-md-12 justify-content-center d-flex">
        <a asp-controller="Ayuda" asp-action="CondicionesRuleta" type="button" class="btn__Condiciones btn btn-naranja btn-lg mb-3">Condiciones Ruleta</a>
    </div>
    
    @foreach (InfoRuletas item in Model)
    {
        <!--Clasica-->
        <hr class="" />
        <div class="col-md-12 mb-2 @item.RuletaNormalized">
            <div class="row">
                <div class="col-sm-12 col-md-4 col-lg-3 mt-2">
                    <div class="ruleta border-0">
                        @if (item.Activa == 1)
                        {
                            <input type="hidden" id="idRuleta" value="@item.IdRuleta" />
                            <a onclick="showModal()">
                                <img class="card-img-top img_ruleta" src="~/Imagenes/ruleta@{@item.IdRuleta;}.png" alt="image" />
                            </a>
                            <div class="card-block">
                                <p class="txt-ruleta-activa">Se activa con @item.Monedas</p>
                            </div>
                            <a class="btn__Condiciones btn btn-azul btn-lg mb-3 mx-auto" onclick="OpenModal('exampleModalToggle')">
                                Prueba tu Suerte
                            </a>
                        }else{
                            <a href="#" alt="Play Ruleta" class="mx-auto">
                                <img class="card-img-top img_ruleta" src="~/Imagenes/ruletaDeshabilitada@{@item.IdRuleta;}.png" alt="image" />
                            </a>                            
                            <div class="card-block">
                                <p class="txt-ruleta-activa">Se activa con @item.Monedas</p>
                            </div>
                        }
                    </div>
                </div>
                <div class="col-sm-12 col-md-8 col-lg-9 mt-2">
                    <div class="row">
                        @{
                            List<PremioRuleta> ModeloImagenes = ExpoMR.Controllers.RuletaController.GetImageRuleta(item.IdRuleta);
                            foreach (ExpoMR.Models.PremioRuleta model in ModeloImagenes)
                            {                            
                                <div class="col-12 col-sm-12 col-md-3 mb-2">
                                    <div class="h-100 card ruleta-premio">
                                        <img class="img__max-width card-img-top img_ruleta" src="@String.Format("data:image/jpg;base64,{0}", Convert.ToBase64String(model.Foto))" alt="image" />
                                        <p>@String.Format(model.Premio)</p>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    }  
</div>

@*Modal de confirmacion para girar la ruleta*@
<div class="modal fade" id="exampleModalToggle" aria-hidden="true" aria-labelledby="exampleModalToggleLabel" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-body text-center">
                <p class="mdl_confirm_ruleta">
                    <b>Si giras esta ruleta, ya NO podrás girar alguna de las otras ruletas</b>
                    <b>¿Estas seguro de que deseas girar la ruleta,</b>
                    <b>son todas la monedas que puedes conseguir?</b>                  
                </p>
            </div>
            <div class="modal-footer" >
                <div class="col-8 col-md-10 col-lg-6 ml-auto mr-auto">
                    <button type="button" class="btn btn-verde-medio btn-success">Acepto</button>                
                    <button type="button" class="btn btn-rojo btn-cancelar" data-bs-dismiss="modal">Cancelar</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>  

    $(document).on('click', '.btn-success', function (event)
    {
        document.location = '@Url.Action("PlayRuleta", "Ruleta")' + '?IdRuleta=' + document.getElementById("idRuleta").value;
    });
</script>

