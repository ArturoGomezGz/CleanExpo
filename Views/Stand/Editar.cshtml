<script>
    function AgregarProducto()
    {
        let LimiteTiempo = 2000;
        let IdProducto = $("#IdProducto").val()
        let Cantidad = $("#cantidad").val()
        let PrecioMR = $("#PrecioMR").val()
        var TotalCantidadSeleccionada = parseInt(Cantidad);
        if (Number.isInteger(TotalCantidadSeleccionada) && TotalCantidadSeleccionada > 0) {
            if(TotalCantidadSeleccionada==0){
                ShowAlert("No es una cantidad valida para ingresar", false, "liveAlertPlaceholderModal");
                setTimeout(function() {
                    window.location.reload();
                }, LimiteTiempo);
                return;
            }
            $.post(path + "Producto/AddCarrito",
                {
                    idProducto: IdProducto,
                    cantidad: TotalCantidadSeleccionada,
                    unitario: PrecioMR
                },
                function (data)
                {
                    CloseModal("ModalProducto")
                    ShowAlert(data.message, data.response, "liveAlertPlaceholderProductos")
                    GetCarrito();
                    //GetMonedas()
                }).error(function ()
                {
                    CloseModal("ModalProducto")
                    ShowAlert("No fue posible cargar sus datos", false, "liveAlertPlaceholderProductos");
                });
        } 
        else
        {
            ShowAlert("La Cantidad debe ser mayor a Cero", false, "liveAlertPlaceholderModal");
            setTimeout(function() {
                CloseAlert("liveAlertPlaceholderModal");
            }, 3000);
        }
    }

    function detalleProducto(IdProducto)
    {        
        var elemento = document.getElementById('collapseImage');
        var precio = 0;
        var iva = 0;
        var subtotal = 0;
        var ivatotal = 0;
        var total = 0;

        // Verifica si el elemento tiene la clase 'show'
        if (elemento.classList.contains('show'))
        {
           toggleCollapse()
        }

        //Asignacion de monedas por visita de producto del proveedor
        //AsignarMonedasProducto(IdProducto);
        
        OpenModal("ModalProducto");

        $.ajax({
            type: "POST",
            url: path + "Stand/DetalleProducto?IdProducto=" + IdProducto + "&Idproveedor="+@Model.Proveedor,
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (resultado)
            {
                document.getElementById('idproducto').innerHTML = " " + resultado.idProducto;
                document.getElementById('lbl_nombre').innerHTML = " " + resultado.nombre;
                document.getElementById('presentacion').innerHTML = " " + resultado.presentacion + " " + resultado.unidades;
                document.getElementById('neto').innerHTML = " " + FormatoMoneda(resultado.neto);
                document.getElementById('PrecioPublico').innerHTML = " " + FormatoMoneda(resultado.publico);
                document.getElementById('precioRegular').innerHTML = " " + FormatoMoneda(resultado.precioRegular);
                document.getElementById('precioMR').innerHTML = " " + FormatoMoneda(resultado.precioMR);
                document.getElementById('preciofinal').innerHTML = " " + FormatoMoneda(resultado.precioFinal);
                document.getElementById('descuentoExpo').innerHTML = " " + FormatoMoneda(resultado.descuentoExpo);
                if(resultado.descuentoCliente == true)
                {
                    document.getElementById(`imgDescuento`).style.display = 'block';
                    document.getElementById('imgDescuento').src = "../Imagenes/descuentoExclusivo.png"
                }
                else
                {
                    document.getElementById(`imgDescuento`).style.display = 'none';
                }

                if(resultado.status === 4)
                {
                    document.getElementById(`imgLiquidacion`).style.display = 'block';
                }
                else
                {
                    document.getElementById(`imgLiquidacion`).style.display = 'none';
                }
                document.getElementById('iva').innerHTML = resultado.iva == false ? " <span style='color:#808080; font-size:0.7em'>Sin Iva</span>" : " <span style='color:#0fa200; font-size:0.7em'>Con Iva</span>";
                document.getElementById('getiva').innerHTML = " ";
                document.getElementById('laboratorio').innerHTML = " " + resultado.laboratorio;
                document.getElementById('caja').innerHTML = " " + resultado.caja;
                document.getElementById('codigo').innerHTML = " " + resultado.codigo;
                // document.getElementById('restringido').innerHTML = " " + resultado.cantidad;
                document.getElementById('formula').innerHTML = " " + resultado.formula;
                document.getElementById('subtotal').innerHTML = " " + FormatoMoneda(0);
                document.getElementById('valoriva').innerHTML = " " + FormatoMoneda(0);
                document.getElementById('total').innerHTML = " " + FormatoMoneda(0);

                $("#IdProducto").val(IdProducto)
                $("#PrecioMR").val(resultado.precioMR)
                $("#cantidad").val(0)

                precio = resultado.precioFinal;
                iva = resultado.valorIva;
            },
            error: function (xhr, status, error)
            {
                console.log(error);
            }
        });

        cantidad.oninput = function ()
        {
            subtotal = cantidad.value * precio;
            ivatotal = cantidad.value * precio * iva;
            total = cantidad.value * precio * (1 + iva);

            document.getElementById('subtotal').innerHTML = FormatoMoneda(subtotal);
            document.getElementById('valoriva').innerHTML = FormatoMoneda(ivatotal);
            document.getElementById('total').innerHTML = FormatoMoneda(total)
        }
    }

