<head>
    <link rel="stylesheet" href="~/css/ZoomPhoto.css">
</head>
<style>
    #main{
        padding:0px !important;
    }


    img
    {
        opacity: 1;
        transition: opacity 1s;
    }

    img[data-src]
    {
        opacity: 0;
    }

    .carrousel
    {
        transition: all 0.4s ease;
        border-radius:0.5em;
        overflow: hidden;
        
    }

    .carrousel .grande 
    {
        display: flex;
        flex-flow: row nowrap;
        justify-content: space-between;
        align-items: center;
        transition: all 0.4s ease;
        border-radius: 0.5em;
        transition: all 0.5s ease;
        transform: translateX(0%);
        font-size: 0.7em;
    }

    .carrousel .img 
    {
        min-height: 10vh;
        color: var(--blanco);
        transition: all 0.4s ease;
        border-radius: 1em;
        padding: 1em;
        margin: 0.5em;
        font-size: 1.3em;
        min-height: 80px;
    }

    .carrousel .puntos 
    {
        width: 100%;
        display: flex;
        flex-flow: row nowrap;
        justify-content: center;
        align-items: center;
        list-style-type: none;
    }

    .carrousel .punto 
    {
        width: 0.8em !important;
        height: 0.8em;
        margin: 1em 1em 0;
        color: var(--negro);
        border-radius: 1em;
        list-style-type: none;
    }

    .carrousel .punto.activo 
    {
        background-color: lightblue !important;
    }

    table.dataTable.nowrap td 
    {
        white-space: break-spaces;
    }

    /* Cambia el tamaño solo para la tabla con id "ProductoStand" */
    #ProductoStand thead th {
        font-size: 13px !important;
    }

</style>

