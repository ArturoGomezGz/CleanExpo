<script>
    let ValorIva
    let Precio

    function AgregarProducto()
    {
        let IdProducto = $("#IdProducto").val()
        let Cantidad = $("#cantidad").val()
        let PrecioMR = $("#PrecioMR").val()

        if (Cantidad > 0)
        {
            $.post(path + "Producto/AddCarrito",
                {
                    idProducto: IdProducto,
                    cantidad: Cantidad,
                    unitario: PrecioMR
                },
                function (data)
                {
                    CloseModal("ModalProducto")
                    ShowAlert(data.message, data.response, "liveAlertPlaceholderProductos")
                    GetCarrito();
                    GetMonedas()
                }).error(function ()
                {
                    CloseModal("ModalProducto")
                    ShowAlert("No fue posible cargar sus datos", false, "liveAlertPlaceholderProductos");
                });
        } 
        else
        {
            ShowAlert("La Cantidad debe ser mayor a Cero", false, "liveAlertPlaceholderModal");
        }
    }

    function detalleProducto(IdProducto)
    {        
        var elemento = document.getElementById('collapseImage');

        // Verifica si el elemento tiene la clase 'show'
        if (elemento.classList.contains('show'))
        {
           toggleCollapse()
        }

        AsignarMonedasProducto(IdProducto);
        
        OpenModal("ModalProducto")
        $.ajax({
            type: "POST",
            url: path + "Stand/DetalleProducto?IdProducto=" + IdProducto + "&Idproveedor="+@Model.Proveedor,
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (resultado)
            {
                document.getElementById('nombre').innerHTML = " " + resultado.nombre;
                document.getElementById('presentacion').innerHTML = " " + resultado.presentacion;
                document.getElementById('idproducto').innerHTML = " " + resultado.idProducto;
                document.getElementById('PrecioPublico').innerHTML = " " + FormatoMoneda(resultado.publico)
                document.getElementById('precioMR').innerHTML = " " + FormatoMoneda(resultado.precioMR)
                document.getElementById('descuentoExpo').innerHTML = " " + FormatoMoneda(resultado.descuentoExpo)
                document.getElementById('iva').innerHTML = resultado.iva == false ? " <span style='color:red'>Sin Iva</span>" : " <span style='color:green'>Con Iva</span>";
                document.getElementById('codigo').innerHTML = " " + resultado.codigo;
                document.getElementById('preciofinal').innerHTML = " " + FormatoMoneda(resultado.precioFinal);
                document.getElementById('getiva').innerHTML = " ";
                document.getElementById('restingido').innerHTML = " " + resultado.cantidad;
                document.getElementById('subtotal').innerHTML = " " + FormatoMoneda(0);
                document.getElementById('valoriva').innerHTML = " " + FormatoMoneda(0);
                document.getElementById('total').innerHTML = " " + FormatoMoneda(0);
                $("#IdProducto").val(IdProducto)
                $("#PrecioMR").val(resultado.precioMR)
                $("#cantidad").val(0)

                if (resultado.restringido) 
                {
                    $("#div_restringido").removeClass("d-none");
                } 
                else 
                {
                    $("#div_restringido").addClass('d-none');
                }

                ValorIva = resultado.valorIva
                Precio = resultado.precioFinal
            },
            error: function (xhr, status, error)
            {
                console.log(error);
            }
        });

        cantidad.oninput = function ()
        {
            let precio = Precio
            let valoriva = ValorIva

            let subtotal = cantidad.value * precio;
            let iva = cantidad.value * precio * valoriva;
            let total = cantidad.value * precio * (1 + valoriva);

            document.getElementById('subtotal').innerHTML = FormatoMoneda(subtotal)
            document.getElementById('valoriva').innerHTML = FormatoMoneda(iva)
            document.getElementById('total').innerHTML = FormatoMoneda(total)
        }
    }

    function ser()
    {
        var elements = document.querySelectorAll('img[data-id]');
        var index = 0;
    }

    function searchStand()
    {
        CloseAlert("liveAlertPlaceholder")
        let imagen = ''
        let IdProveedor = $("#Proveedor").val();
        let Busqueda = $("#txtBuscar").val();
        let idUsuario = $("#IdUsuario").val();
        let lista = "";
        $("#busqueda__Result").html("")

        if (Busqueda != "")
        {
            $.post(path + "Stand/GetProductosBusqueda",
                {
                    IdProveedor: IdProveedor,
                    Busqueda: Busqueda,
                    idUsuario: idUsuario
                },
                function (data)
                {
                    if (data.response)
                    {
                        if (data.result.length > 0)
                        {
                            $.each(data.result, function (index, value)
                            {
                                if (value.imgProducto.length > 0)
                                    imagen = ' src="data:image/png;base64,' + value.imgProducto + '"'
                                else
                                    imagen = 'src="' + path + 'Imagenes/noimage.png"'

                                lista += '<div class="tab-content_productos mb-4">'
                                    + '    <div class="lista__busqueda_stand">'
                                    + '        <div class="listaStand_article">'
                                    + '            <a href="' + path + 'Producto/Index?idProducto=' + value.idProducto + "&idProveedor=" + IdProveedor + '" style = " margin: auto;" > '
                                    + '                <img class="card-img-top" ' + imagen + ' alt="image">'
                                    + '             </a>'
                                    + '        </div>'
                                    + '       <div class="listaStand_descripcion standProducto">'
                                    + '           <a href="' + path + 'Producto/Index?idProducto=' + value.idProducto + '">'
                                    + '            ' + value.nombre
                                    + '            </a>'
                                    + '            <p>' + value.presentacion + '</p>'
                                    + '            <p><strong>Fórmula:</strong></p>'
                                    + '            <label>' + value.formula + '</label>'
                                    + '      </div>'
                                    + '     <div class="listaStand_actions">'
                                    + '           <p><strong>Descuento: </strong><label class="label_Descuento_stnd"> ' + FormatoMoneda(value.descuento) + '</label></p>'
                                    + '           <p>Precio Final: <label class="label_PrecioFinal_stnd"> ' + FormatoMoneda(value.precioFinal) + '</label></p>'
                                    + '     </div>'
                                    + '    </div>'
                                    + '     <hr />'
                                    + '   </div>';
                            });
                            $("#busqueda__Result").append(lista)
                        } 
                        else
                        {
                            ShowAlert("No hay coincidencias para el filtro aplicado", false)
                        }
                    } 
                    else
                    {
                        ShowAlert(data.message, data.response)
                    }
                }).error(function ()
                {
                    ShowAlert("No fue posible cargar sus datos", false)
                }
            );
        }
    }

    function CloseAlert(IdElement) 
    {
        let alertPlaceholder = document.getElementById(IdElement)
        alertPlaceholder.innerHTML = "";
    }

    function MostrarArticulo(IdArticulo, IdArticulos)
    {
        OpenModal('exampleModal')
        var imageElement = document.getElementById("PromoImg_" + IdArticulo);
    
        // Get the value of the src attribute
        var imageUrl = imageElement.src;
        var imageElementModal = document.getElementById("PromoImgModal");
        imageElementModal.src = imageUrl
        $.ajax({
            type: "POST",
            url: path + "Stand/GetAnuncio?IdArticulo=" + IdArticulos,
            success: function (resultado)
            {
                var TituloElement = document.getElementById("titulo_Promo");
                var DescripcionElement = document.getElementById("descripcion_Promo");

                $("#titulo_Promo").html(resultado[0])
                $("#descripcion_Promo").html(resultado[1])
            },
            error: function (xhr, status, error)
            {
                console.log(error);
            }
        });
    }

    function OnDemandImage()
    {
        let IdProducto = $("#IdProducto").val()
        $("#imgModalOndemand").html('')
        $.post(path + "Stand/GetFotoProducto",
        {
            idProducto: IdProducto
        },
        function (data)
        {
            if (data.length > 0)
                $("#imgModalOndemand").append('<a href="#PopupPhoto" onclick="showZoomImg()" data-toggle="modal" data-target="#PopupPhoto"><img id="imgProduct" class="card-img-top" style=" width: 150px; height: 150px; margin: auto;" src="data:image/png;base64,' + data + '" alt="image" /></a><img src="../Imagenes/zoom.png" alt="image"/>')
            else 
                $("#imgModalOndemand").append('<img class="card-img-top" style=" width: 150px; height: 150px; margin: auto;" src="../Imagenes/noimage.png" alt="image" />')           
        }).error(function () 
        {
            CloseModal("ModalProducto")
